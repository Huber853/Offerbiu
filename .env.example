# Node.js 24+; copy this file to .env and configure for your host.
#
# Local demo (default):
HOST=127.0.0.1
PORT=4174
COOKIE_SECURE=false
#
# Production behind Nginx / HTTPS (PM2 example):
# HOST=127.0.0.1
# PORT=4174
# APP_ORIGIN must match the URL in the browser address bar (scheme + host, no trailing slash).
# Multiple origins: APP_ORIGIN=https://offer.example.com,https://www.offer.example.com
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
#
# Nginx should forward the public scheme/host, e.g.:
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-Host $host;
#
# Optional server-wide DeepSeek key. Users can also enter a personal key in Settings.
# Local default (HOST is 127.0.0.1 and APP_ORIGIN is unset): every account on this machine may use the server key.
# Restrict it with a comma-separated allowlist. Public HOST or a public APP_ORIGIN ignores the server key unless the account is listed.
# OFFERBIU_SERVER_KEY_EMAILS=you@example.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional data directory. Copy the existing folder first; do not point this at an empty path.
# node scripts/copy-storage.mjs --from storage --to D:/OfferbiuData
# OFFERBIU_STORAGE=D:/OfferbiuData
# OFFERBIU_DB=D:/OfferbiuData/offerbiu.sqlite
# OFFERBIU_JOB_SOURCE=C:/path/to/test-catalog.json
