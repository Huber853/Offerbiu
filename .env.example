# Node.js 24+; copy this file to .env and optionally configure.
HOST=127.0.0.1
PORT=4174
# Optional deployment origin; set HTTPS and COOKIE_SECURE=true for HTTPS hosting.
# APP_ORIGIN=https://your-domain.example
COOKIE_SECURE=false
# Optional server-wide DeepSeek key. Individual users can also enter their own key in Settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# No custom AI endpoint: requests go only to https://api.deepseek.com/chat/completions.
