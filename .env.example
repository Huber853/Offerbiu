# Node.js 24+; copy this file to .env and configure for your host.
#
# Local demo (default):
HOST=127.0.0.1
PORT=4174
COOKIE_SECURE=false
#
# Production behind Nginx / HTTPS (PM2 example):
# HOST=127.0.0.1
# PORT=4174
# APP_ORIGIN must match the URL in the browser address bar (scheme + host, no trailing slash).
# Multiple origins: APP_ORIGIN=https://offer.example.com,https://www.offer.example.com
# APP_ORIGIN=https://your-domain.example
# COOKIE_SECURE=true
#
# Nginx should forward the public scheme/host, e.g.:
#   proxy_set_header Host $host;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-Host $host;
#
# Optional server-wide DeepSeek key. Users can also enter a personal key in Settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
