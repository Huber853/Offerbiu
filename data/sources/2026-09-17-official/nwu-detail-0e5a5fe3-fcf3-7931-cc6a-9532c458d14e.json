，掌握大量自主研发的核心技术，拥有国际先进的集工业数据现场采集、传输、分析、处理的工业云服务平台，2019年再次跻身中国软件和信息技术服务综合竞争力百强企业。\n经过26年稳健发展，“HollySys”已成为自动化领域的国际知名品牌，各个领域和行业积累了超过1.2万家客户，累计成功实施了3万多套控制系统项目，自动化和信息化系统管理的客户资产达到数万亿。","address":"杭州市下沙经济技术开发区19号路北1号","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"c33bd017-7240-a1ac-904d-2ebbf0de6b3c","com_id":"37e74597-1aa1-0ba3-9fd2-b241aad3d961","tagsid":"ad46114b-6758-ffc2-a01a-85de885bde7b","createtype":"com","school_id":"","title":"规模以上单位"}],"business_name":"制造业","business_code":"22","province_name":"浙江省","city_name":"杭州市","guimo_id_name":"1000人以上","guimo_id_code":"","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/09\/10\/1757492589-63c193675c-9d93-9a86-e379-313ba6c267d8.png","status1":"新注册","is_vip":2},"otherJobList":null,"ProfessionalList":[],"yxdeilver":true,"isDeliver":false,"is_job_complaint":0,"isCollection":false}}