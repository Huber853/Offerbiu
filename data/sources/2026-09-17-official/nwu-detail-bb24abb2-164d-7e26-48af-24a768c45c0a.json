券资管等主要控股子公司均在各自领域中保持领先地位。\r\n2024年12月末，中信证券总资产17107亿元，归属母公司净资产2931亿元。2024年实现营业收入637亿元，归属母公司净利润217亿元，均稳居行业领先地位。","address":"上海市世纪大道1568号中建大厦10层","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"42c9f98c-3168-0501-4558-c9deec41f884","com_id":"f9bf7c61-821d-5eae-875f-613a58897147","tagsid":"4184e87a-235c-6116-1677-aa159255fe46","createtype":"com","school_id":"","title":"中国名企"},{"id":"5d9b2899-712f-2366-8e62-96a16ca8fa22","com_id":"f9bf7c61-821d-5eae-875f-613a58897147","tagsid":"fcc9277c-1629-d435-560f-21a3d55d7290","createtype":"com","school_id":"","title":"国有企业"},{"id":"6bb5d313-f309-f65d-b129-8d14456bdf1b","com_id":"f9bf7c61-821d-5eae-875f-613a58897147","tagsid":"e827a173-24e5-a410-6be3-66bce0ef94c4","createtype":"com","school_id":"","title":"A股上市公司"}],"business_name":"金融业","business_code":"35","province_name":"上海市","city_name":"市辖区","guimo_id_name":"500-999人","guimo_id_code":"","xingzhi_id_name":"国有企业","xingzhi_id_code":"31","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2026\/01\/05\/1767596133-67c334122e-40e5-f1af-2d43-04f1cbfc9a54.png","status1":"新注册","is_vip":2},"otherJobList":null,"ProfessionalList":[],"yxdeilver":true,"isDeliver":false,"is_job_complaint":0,"isCollection":false}}