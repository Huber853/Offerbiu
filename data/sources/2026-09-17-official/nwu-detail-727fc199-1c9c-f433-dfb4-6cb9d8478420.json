t;\"><span =\"font-family: 微软雅黑; line-height: 120%; font-size: 12.0000pt;\"><span =\"font-family: 微软雅黑;\">本阶段目标是通过九年时间将新睿培养为商业项目总经理或集团对应关键岗位（总经理级）。<\/span><\/span><\/p>","tags":"0a552c12-c376-7a08-680f-81329c0f7419,0d8f15ab-49cc-2e7e-18ec-ab43cd1f23bf,37d8a1ab-406f-82c6-71c2-7a683c7cd09c,3f8c70db-16e5-9c8c-6a5d-e73d00d4110f,e8af7dd5-60fe-9648-49db-0b20952877ae","create_name":"","zhize":"","fangxiang":"","tagsList":[{"id":"0a552c12-c376-7a08-680f-81329c0f7419","title":"节假日福利"},{"id":"0d8f15ab-49cc-2e7e-18ec-ab43cd1f23bf","title":"五险一金 "},{"id":"37d8a1ab-406f-82c6-71c2-7a683c7cd09c","title":"上市企业"},{"id":"3f8c70db-16e5-9c8c-6a5d-e73d00d4110f","title":"带薪年假"},{"id":"e8af7dd5-60fe-9648-49db-0b20952877ae","title":"租房补贴"}],"address_extend":"","dalei_id_name":"商业和服务业人员","cate_id1_name":"其他类","cate_id2_name":"其他","province_id_name":"不限","city_id_name":"","com_id_info":{"logo":"013ce649-603f-78e1-331a-f04a38c00869","name":"新城控股集团股份有限公司上海分公司","hy_vip":0,"hy_over_time":0,"xingzhi_id":"71399979-c459-f0d5-04f6-800dc54890d1","business":"8a07e7ee-9c77-07cd-29c7-53c2dd90327f","tag":"中国500强","tagsid":["746301ec-769d-f719-701f-6c81e3bf574e"],"addtime":1541644977,"resumeCount":10,"business_name":"房地产业","business_code":"36","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/09\/16\/1758010051-6122c71421-dc04-81a3-4068-7472b01ba957.png","status1":"新注册","is_vip":0},"com_logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/09\/16\/1758010051-6122c71421-dc04-81a3-4068-7472b01ba957.png","xingzhi_id_name":"其他企业（含民营企业等）","business_name":"房地产业","xueli_id_name":"本科","chance_name":"面议"},"province_id_name":"暂无","school_id_name":"西北大学","school_id_code":10697,"com_id_info":{"logo":"013ce649-603f-78e1-331a-f04a38c00869","name":"新城控股集团股份有限公司上海分公司","hy_vip":0,"hy_over_time":0,"xingzhi_id":"71399979-c459-f0d5-04f6-800dc54890d1","business":"8a07e7ee-9c77-07cd-29c7-53c2dd90327f","tag":"中国500强","tagsid":["746301ec-769d-f719-701f-6c81e3bf574e"],"addtime":1541644977,"resum