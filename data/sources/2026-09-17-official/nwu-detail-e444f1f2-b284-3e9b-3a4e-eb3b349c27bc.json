4-8b35-db01-f12c-69f8e42bfbf8","04ba3e91-7993-5784-5de5-cb7abad69400"],"addtime":1770622881,"resumeCount":0,"business_name":"制造业","business_code":"22","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2026\/02\/09\/1770622994-529dccb5d6-b62a-e367-84fd-7315ff6cf178.png","status1":"新注册","is_vip":0},"com_logo_src":"\/\/jymnjep1.jiuyeb.cn\/2026\/02\/09\/1770622994-529dccb5d6-b62a-e367-84fd-7315ff6cf178.png","com_id_name":"深圳市什方智造科技有限公司","xingzhi_id_name":"其他企业（含民营企业等）","business_name":"制造业","xueli_id_name":"暂无","person_count":"不限","deliver_email":"暂无","comInfo":{"name":"深圳市什方智造科技有限公司","logo":"5d2bdba5-f78a-e1d4-f740-93fe87e1b512","business":"fe86815f-6bb8-02c6-d8f2-a5a82df78fa1","guimo_id":"0abd6fcb-f933-5c58-23c3-b9df6667c1bb","xingzhi_id":"71399979-c459-f0d5-04f6-800dc54890d1","province":44,"city":4403,"content":"深圳市什方智造科技有限公司成立于2020年，致力于为产业界提供高精密、高粘度、微米级功能涂层数字喷印核心部件和系统解决方案——全球首发的功能涂层UV喷墨打印引擎，就诞生在这里。\r\n\r\n研发团队由清北、西交、哈工大、华工等顶级学府人才领衔，硕博占比35%，研发人员占比80%，建有业内领先的功能涂层实验室——行知实验室。公司已获得超百项自主发明专利，涵盖喷墨打印技术、墨滴观测系统、墨路控制技术、自动化优化算法等关键领域。依托在软件算法、墨路控制、板卡控制、流体力学建模等领域构建的技术壁垒，推出了兼顾喷头、板卡、墨路控制高度集成化的工业打印硬件Box，为工业领域的大剂量、高精度且高可靠性的涂层打印需求提供创新支持。同时，通过利用独特的墨滴观测技术和强大的Tetris™工业打印软件，可在量产过程中实现精确的墨滴落点控制，完成微米级UV喷墨打印。\r\n什方科技的产品与解决方案应用于锂电池绝缘涂层、PCB加工、汽车制造、面板显示等行业，显著提升工艺质量与生产效率，为技术升级和智能制造的全球化发展提供强有力的支撑。\r\n\r\n什方科技连续4年营收增长超200%，获头部机构数亿元投资，获得国家高新技术企业、深圳市专精特新企业、深圳市种子独角兽企业、博士后创新实践基地、入选德勤「2025中国明日之星」、36氪「2026最具价值成长企业100」等荣誉。\r\n\r\n什方科技将持续专注于技术创新与品质提升，以引领世界智造变革为己任，致力于成为全球领先的工业打印解决方案提供商，为智能制造赋能，为绿色制造助力，加速推动全球制造业向智能化、可持续发展迈进。","address":"深圳市宝安区宝星智荟城","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"16e3e3f7-ee04-bacf-78c0-a171f314c016","com_id":"e6a085ba-bf3e-a554-7bc8-2579d97e403a","tagsid":"1de5404e-63ad-07a9-dd52-fc625f95d9d7","createtype":"com","school_id":"","title":"国家高新技术企业"},{"id":"a1345a64-1de1-e638-74e0-2a7860d3d647","com_id":"e6a085ba-bf3e-a554-7bc8-2579d97e403a","tagsid":"b3bca1c4-8b35-db01-f12c-69f8e42bfbf8","createtype":"com","school_id":"","title":"省（市）高