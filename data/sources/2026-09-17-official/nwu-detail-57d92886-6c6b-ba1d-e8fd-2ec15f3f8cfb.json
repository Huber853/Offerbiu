定发展，多项核心财务和业务经营指标均位居行业前列。\r\n\r\n公司继承发扬中信优良传统，坚持金融服务实体经济的宗旨，致力于打造综合实力和国际竞争力行业领先的期货和衍生品综合服务商。多次被各大期货交易所评为年度优秀会员，多次获评证券时报、期货日报等行业主流媒体颁发中国最佳期货公司、最佳金融期货服务奖、最佳商品期货产业服务奖、最佳风险管理子公司服务奖、中国优秀财富管理机构等荣誉。","address":"陕西省西安市高新区唐延路11号禾盛京广中心A座904","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"55fb461b-9303-8361-0157-2d65effca175","com_id":"5fe59443-a319-fa77-bdf9-12230d171323","tagsid":"136253ed-3d54-b9e0-07e7-180138080b72","createtype":"com","school_id":"","title":"国有控股"},{"id":"a8564285-5069-5682-5b6d-d7baeefcadb2","com_id":"5fe59443-a319-fa77-bdf9-12230d171323","tagsid":"fcc9277c-1629-d435-560f-21a3d55d7290","createtype":"com","school_id":"","title":"国有企业"},{"id":"d811a980-c688-b006-8f98-699f0505c539","com_id":"5fe59443-a319-fa77-bdf9-12230d171323","tagsid":"746301ec-769d-f719-701f-6c81e3bf574e","createtype":"com","school_id":"","title":"中国500强"}],"business_name":"金融业","business_code":"35","province_name":"陕西省","city_name":"西安市","guimo_id_name":"500-999人","guimo_id_code":"","xingzhi_id_name":"国有企业","xingzhi_id_code":"31","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2026\/09\/14\/1789367343-40308b936b-8c40-c600-1fbb-251e5c141d2e.png","status1":"新注册","is_vip":2},"otherJobList":null,"ProfessionalList":[],"yxdeilver":true,"isDeliver":false,"is_job_complaint":0,"isCollection":false}}