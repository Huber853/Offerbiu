储完整的产品系列和解决方案。\r\n\r\n“CreatingChemistryWorldwide全球化工创新之源”亚东集团期待与世界各地的您发生化学反应！\r\n\r\n\r\n人力资源部邮箱：renliziyuanbu@ydchem.cn\r\n\r\n公司网址：http:\/\/www.ydchem.cn","address":"河北省石家庄市裕华区天山科技园","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"15830797-4abd-7232-5b37-e9c06c5dd3df","com_id":"d5242497-1d8e-2517-4d42-e89f5c6eb958","tagsid":"1de5404e-63ad-07a9-dd52-fc625f95d9d7","createtype":"com","school_id":"","title":"国家高新技术企业"},{"id":"5e83d159-8c83-1d66-0469-784999d4c9f0","com_id":"d5242497-1d8e-2517-4d42-e89f5c6eb958","tagsid":"ad46114b-6758-ffc2-a01a-85de885bde7b","createtype":"com","school_id":"","title":"规模以上单位"},{"id":"cd9c7ad6-0c3b-4cea-cdaf-8114b1870a44","com_id":"d5242497-1d8e-2517-4d42-e89f5c6eb958","tagsid":"b3bca1c4-8b35-db01-f12c-69f8e42bfbf8","createtype":"com","school_id":"","title":"省（市）高新技术企业"}],"business_name":"制造业","business_code":"22","province_name":"河北省","city_name":"石家庄市","guimo_id_name":"500-999人","guimo_id_code":"","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/11\/18\/1763436064-60ff3465e4-f5ec-436f-b423-58382489f793.png","status1":"新注册","is_vip":2},"otherJobList":null,"ProfessionalList":[{"id":"03c77992-eeb4-5830-08b0-35e3aea56da6","job_id":"b8d42248-7cac-31d2-9c23-75a5c316da13","publish_id":"edc17582-aa06-fcad-ece8-b01c42dc73a4","college_id":"ed6a5955-8258-23d0-3473-b3fb44eb2c30","professional_id":"24668cca-1f0a-eb4e-3be1-fa3919a8d323","isplatform":2,"people":0,"college_id_name":"化学与材料科学学院","xueli_id":2,"professional_id_name":"材料工程"},{"id":"76fd41ba-c6d0-1ab5-46b2-d091dda7f255","job_id":"b8d42248-7cac-31d2-9c23-75a5c316da13","publish_id":"edc17582-aa06-fcad-ece8-b01c42dc73a4","college_id":"2f64b58b-89fb-f576-603e-cf14840c353d","professional_id":"1c7aa390-dddf-2c5a-20f4-9e320f98a074","isplatform":2,"people":0,"college_id_name":"化工学院","xueli_id":2,"professional_id_name":"材料与化工"}],"yxdeilver":true,"isDeliver":false,"is_job_complaint":0,"isCollection":false}}