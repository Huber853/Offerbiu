uyeb.cn\/2025\/08\/27\/1756278862-5026e90cd0-029f-df2c-8b08-382d5d8636e8.png","xingzhi_id_name":"其他企业（含民营企业等）","business_name":"科学研究和技术服务业","xueli_id_name":"本科","chance_name":"面议"},"province_id_name":"暂无","school_id_name":"西北大学","school_id_code":10697,"com_id_info":{"logo":"d611dc7e-f881-42a8-90cf-d5965b1d7383","name":"北京卓镭激光技术股份有限公司","hy_vip":0,"hy_over_time":0,"xingzhi_id":"71399979-c459-f0d5-04f6-800dc54890d1","business":"9f9bbbd4-5602-975d-14ac-bcb3ddb8473c","tag":"省（市）高新技术企业,国家高新技术企业","tagsid":["b3bca1c4-8b35-db01-f12c-69f8e42bfbf8","1de5404e-63ad-07a9-dd52-fc625f95d9d7"],"addtime":1593673356,"resumeCount":81,"business_name":"科学研究和技术服务业","business_code":"38","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/08\/27\/1756278862-5026e90cd0-029f-df2c-8b08-382d5d8636e8.png","status1":"新注册","is_vip":0},"com_logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/08\/27\/1756278862-5026e90cd0-029f-df2c-8b08-382d5d8636e8.png","com_id_name":"北京卓镭激光技术股份有限公司","xingzhi_id_name":"其他企业（含民营企业等）","business_name":"科学研究和技术服务业","xueli_id_name":"暂无","person_count":"不限","deliver_email":"暂无","comInfo":{"name":"北京卓镭激光技术股份有限公司","logo":"d611dc7e-f881-42a8-90cf-d5965b1d7383","business":"9f9bbbd4-5602-975d-14ac-bcb3ddb8473c","guimo_id":"0abd6fcb-f933-5c58-23c3-b9df6667c1bb","xingzhi_id":"71399979-c459-f0d5-04f6-800dc54890d1","province":11,"city":1101,"content":"北京卓镭激光技术股份有限公司成立于2014年8月，是一家以超快激光器和高能量激光器设计研发及生产制造为主营业务的硬科技企业。企业总部位于北京，在国内西安、深圳两地分别设有全资子公司，海外设有韩国分公司。公司总面积近10000㎡，拥有千级光学洁净间近5000㎡。目前全球员工200余人，研发团队占比40%，硕士及以上学历占比30%，是一支经验丰富、专业技术过硬的优秀团队。\r\n作为国内技术覆盖度最全、产品种类最丰富的综合品类激光器供应商，卓镭激光已开发出十余个系列近百款超快、高能激光器，具备年产3000台以上激光器的产能。产品广泛应用于半导体、科研、新能源、消费电子、医疗及国防军工等领域，实现国产替代的同时出口至韩国、日本、新加坡、以色列等发达国家。超快激光器在全球范围内广泛应用于显示、柔性线路板、光伏、锂电、半导体及医疗等领域，主导了国内中高功率超快激光器国产化进程。高能量激光器技术指标国际领先，在大科学装置、半导体、国防及航空航天等领域实现批量应用，国内市场占有率第一，打破欧美禁运、填补多项国内空白。\r\n目前，公司拥有百余项自主知识产权专利；已通过ISO9001质量管理体系、ISO13485医疗器械质量管理体系等多项体系认定；部分产品已通过欧盟CE认证。同时，获得国家级专精特新“小巨人”企业、国家级高新技术企业、中关村金种子企业、北京市级企业科技研究开发机构等资质荣誉，并获批设立博士后科研工作站。卓镭激光始终以“助推民族激光产业发展”为使命，“打造中国综合品类激光器第一品牌”为愿景，“客户为本”为核心价值观，致力于为全球客户提供一流的激光器产品及服务。","address":"北京市顺义区安平北街8号院博润中心16号楼","hy_vip":0,"hy_over_time":0,"tagcomlist":[{"id":"5930b6f2-86b6-c190-9cb4-09da6bc8157e","com_id":"bed0fbc2-f70c-0fa2-b248-77147b22f2e4","tagsid":"b3bca1c4-8b35-db01-f12c-69f8e42bfbf8","createtype":"com","school_id":"","title":"省（市）高新技术企业"},{"id":"8d05d489-3966-d137-a87d-ecb8346db81c","com_id":"bed0fbc2-f70c-0fa2-b248-77147b22f2e4","tagsid":"1de5404e-63ad-07a9-dd52-fc625f95d9d7","createtype":"com","school_id":"","title":"国家高新技术企业"}],"business_name":"科学研究和技术服务业","business_code":"38","province_name":"北京市","city_name":"市辖区","guimo_id_name":"100-499人","guimo_id_code":"","xingzhi_id_name":"其他企业（含民营企业等）","xingzhi_id_code":"39","logo_src":"\/\/jymnjep1.jiuyeb.cn\/2025\/08\/27\/1756278862-5026e90cd0-029f-df2c-8b08-382d5d8636e8.png","status1":"新注册","is_vip":2},"otherJobList":null,"ProfessionalList":[{"id":"0e450589-7a5a-94ed-4b70-3e01975828e9","job_id":"c14c0791-b19d-a600-fa93-057b61337353","publish_id":"d485b9af-8bb0-12a5-35f5-3b55501ee6bf","college_id":"f366ee13-8030-b549-6028-d6a9e4448bc2","professional_id":"6be9a3d0-a58e-d37c-4fc9-efeb2be78e92","isplatform":2,"people":1,"college_id_name":"碳中和学院","xueli_id":2,"professional_id_name":"光电信息工程"},{"id":"12209561-3495-8b3e-bfeb-54fe8e0bab87","job_id":"c14c0791-b19d-a600-fa93-057b61337353","publish_id":"d485b9af-8bb0-12a5-35f5-3b55501ee6bf","college_id":"accba81c-923b-bb7f-6f40-90cf86e9b0d2","professional_id":"fd234484-0984-d8cf-1066-a074e94c3bd5","isplatform":2,"people":1,"college_id_name":"信息科学与技术学院","xueli_id":1,"professional_id_name":"微电子科学与工程"},{"id":"2cef18d1-9e65-58d4-7c71-56ecf0f5bbfe","job_id":"c14c0791-b19d-a600-fa93-057b61337353","publish_id":"d485b9af-8bb0-12a5-35f5-3b55501ee6bf","college_id":"507fb8a5-eed1-8275-ceeb-c8c00128c2b9","professional_id":"1b308598-407b-32f3-5985-3019a6a27244","isplatform":2,"people":1,"college_id_name":"信息科学与技术学院","xueli_id":2,"professional_id_name":"电子科学与技术"},{"id":"63712