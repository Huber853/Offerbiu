{"code":0,"data":{"job_post_detail":{"id":"7669721412320676149","title":"游戏硬表面原画设计师 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、根据项目现有美术风格，独立完成科幻写实风格的武器、硬表面道具设定工作，并能确保角色风格统一、设定合理；\n2、输出高质量的武器，硬表面设定图、装置动画示意图，为建模和动画等后续环节提供清晰的设计依据；\n3、与策划、美术、建模、动画等相关团队紧密协作，确保角色设定在游戏中的表现符合预期，并根据实际效果持续优化。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有写实科幻类军事类知识储备，熟悉该题材下枪械、道具、载具的设计逻辑；熟练掌握Blender，Photoshop软件，有能力K简单动画，使用3d前期+2d后期的流程；\n3、有科幻、军事风格的硬表面风格设计作品；\n4、热爱游戏行业，了解3A项目角色制作流程，具备良好的沟通协作能力和团队意识；能根据项目需求快速适应并调整设计方向，具备良好的问题解决能力与责任心。","job_category":{"id":"6850051246036879630","name":"游戏美术","en_name":"Game Art","i18n_name":"游戏美术","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746176372,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A163464A","job_id":"7660726446973552949","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_