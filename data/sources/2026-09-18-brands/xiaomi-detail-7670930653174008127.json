{"code":0,"data":{"job_post_detail":{"id":"7670930653174008127","title":"硬件产品经理-家电","description":"1.与研发、设计、市场、销售合作，创新产品以解决真正的用户问题；\n2.在解决方案中建立竞争优势；\n3.负责按照整体战略制定和实施产品品类战略计划；\n4.运行综合产品企划流程，指导针对消费者需求的产品研发；\n5.基于消费者洞察来构建产品路线图，抓住机会,定义开发范围，引导创新相关人员找到解决方案，确定价格定位和业务规模；\n6.与销售/市场相关人员协作管理品类的整个产品生命周期。","requirement":"1.本科及以上学历，产品设计、产品专业优先；\n2.英语流利，有产品实习经历和设计经验优先；\n3.具备较强的学习能力、清晰的逻辑思维，具有良好的分析问题和解决问题能力；\n4.有良好的团队合作和自驱能力，做事积极主动、有责任心，善于总结、乐于分享。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027924913,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670930653173844287","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","e