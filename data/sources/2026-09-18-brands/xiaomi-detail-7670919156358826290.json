{"code":0,"data":{"job_post_detail":{"id":"7670919156358826290","title":"数据管理工程师-汽车","description":"1.负责编写和维护配置/BOM/CAD相关流程、规范、标准，完成对外推广和培训；\n2.按项目制定数据交付计划，按时创建和发布数据，及时汇报状态，保证高质量交付；\n3.配置/BOM/CAD数据发布及更改过程管理，支持上下游业务需求，保证上下游数据一致性；\n4.管理和维护企业级基础数据库包括产品主数据、特征编码库、整车分组结构、零件描述库等\n5.完成数字化需求分析/方案讨论/UAT测试，确保配置/BOM/CAD相关数字化工具落地,并持续改进","requirement":"1.本科及以上学历，车辆工程/机械工程/动力工程/电子电气/自动化/计算机科学与技术/软件工程等专业优先；\n2.系统学习过CAD软件（如UG NX，Catia）或PLM软件（Teamcenter、Enovia/3DE、Windchill）者优先；\n3.熟悉汽车理论，汽车结构者优先；\n4.具备较强的学习能力，能够快速掌握新技术和工具；\n5.逻辑清晰，具备较强的分析问题和独立解决问题的能力；\n6.具备良好的沟通能力，具有较强的责任心及团队协作精神；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025083246,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670918670857013531","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_na