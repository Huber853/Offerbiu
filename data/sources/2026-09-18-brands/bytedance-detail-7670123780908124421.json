{"code":0,"data":{"job_post_detail":{"id":"7670123780908124421","title":"体验运营 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、为抖音的用户体验负责，包括但不限于提升用户在推荐、搜索、社交、注册登录等场景的体验；\n2、基于数据、调研和业务输入，洞察用户的痛点和需求；\n3、理解和识别平台上不同角色之间的关键矛盾，提出系统性的解决方案；\n4、协调推动各团队项目落地，不断创新运营模式，拿到业务结果。","requirement":"1、2027届获得硕士及以上学位；\n2、策略性思维，擅长问题的分析、拆解、归纳；\n3、有良好的书面和口头表达能力，具备良好的沟通与团队协同意识，能有效推进跨团队合作；\n4、具备强烈的好奇心、同理心，具有换位思考的意识和能力；\n5、有韧性、有上进心。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785840018762,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A28713A","job_id":"7670123339178297605","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY0000000