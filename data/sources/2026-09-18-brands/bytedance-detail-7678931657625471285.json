{"code":0,"data":{"job_post_detail":{"id":"7678931657625471285","title":"拉美物流运营（巴西/墨西哥） - TikTok Shop","description":"团队介绍：TikTok Shop 是 TikTok 旗下的内容电商。平台汇聚全球优质商家与创作者，通过短视频、直播等多场景连接消费者，让新奇好物畅销全球，让美好生活触手可得。目前团队分布在美国、英国、法国、印尼、墨西哥、中国等全球多个国家和地区，在这里你将有机会深入国际业务场景，面向全世界商家及用户，和跨区域团队协作，共同探索创新购物模式。期待和优秀的你一起创造更多可能！\n\n1、根据国际电商发展需求，负责所辖国家物流供应商的运营管理，保障物流时效及体验达成；\n2、负责开展市场及行业调研，制定运营计划，并能够识别实际业务问题并输出相应的解决方案；\n3、负责供应商的标准操作流程（SOP）和运营绩效指标（KPI）的迭代及监控，以及与业务合作伙伴的战略合作；\n4、负责指标的监控及优化，并持续提升生产效率、服务质量、成本效益和满意度等关键指标。","requirement":"1、2027届获得本科及以上学历，供应链物流运营管理领域或相关专业优先；\n2、英文可以作为工作语言，具备较好的跨文化理解能力，沟通能力强，具备西班牙语/葡萄牙语能力者优先；\n3、具备自我驱动力且以结果为导向，具备良好的协作能力。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787890609562,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A14188","job_id":"7678931635761219893","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"c