{"code":0,"data":{"job_post_detail":{"id":"7670130161032284469","title":"体验运营 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、参与用户体验运营工作，能够汇总分析用户体验问题，并整理成需求；\n2、参与用户研究相关工作，协助完成问卷设计、邀约、访谈、记录、研究报告等相关工作；\n3、维护用户服务数据，通过对数据的挖掘和研究讨论相关方案，协调团队项目落地；\n4、负责客户服务项目/新业务承接，根据内容协调服务中心各团队，确保项目平稳执行，预防未知风险。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有较强执行能力、沟通能力以及服务意识；\n3、思维逻辑清晰，良好的自我学习能力和自我驱动能力，主动性责任心强；\n4、能够熟练使用办公工具，了解常用办公软件；\n5、热爱直播、熟悉直播产品者优先。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785841608578,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A16503","job_id":"7670130480578562309","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","m