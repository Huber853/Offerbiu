{"code":0,"data":{"job_post_detail":{"id":"7668198999834364165","title":"AI全栈开发工程师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责企业级Agent平台产品的设计与开发，涵盖Agent构建、Harness、管理、协同、工具链等模块；\n2、参与Agent Harness、Loop Engineering工程化优化，包括上下文管理、记忆机制设计、Token成本控制等工作；\n3、负责场景化Agent应用的开发与调优。","requirement":"1、2027届获得本科及以上学历，计算机、人工智能、软件工程等相关专业优先；\n2、有实际项目中的性能优化、系统设计或工程落地经验，关注代码质量与可维护性；\n3、有AI Coding工具实际使用或开发经验，熟练掌握Python/Go/TS/C中至少一门语言，代码规范良好；\n4、了解主流Agent框架、Agent核心机制有实践认知（优先）；\n5、具备一定的算法基础和策略思维，能理解模型能力边界，在Agent链路设计中做出合理取舍（优先）；\n6、具备良好的团队沟通协作能力，能和团队一起探索新技术，推进技术进步。\n\n加分项\n1、有开源项目贡献。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785391807800,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A166530A","job_id":"7667887004059765045","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code"