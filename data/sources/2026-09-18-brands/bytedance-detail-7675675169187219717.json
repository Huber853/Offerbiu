{"code":0,"data":{"job_post_detail":{"id":"7675675169187219717","title":"营销工具产品经理（AI方向） - TikTok Shop","description":"团队介绍：TikTok Shop 是 TikTok 旗下的内容电商。平台汇聚全球优质商家与创作者，通过短视频、直播等多场景连接消费者，让新奇好物畅销全球，让美好生活触手可得。目前团队分布在美国、英国、法国、印尼、墨西哥、中国等全球多个国家和地区，在这里你将有机会深入国际业务场景，面向全世界商家及用户，和跨区域团队协作，共同探索创新购物模式。期待和优秀的你一起创造更多可能！\n\n1、负责TikTok Shop商家端相关功能模块的产品设计和规划；\n2、负责TikTok Shop商家、商品、运营、机构、财务结算等B端用户的体验优化和效率提升，理解B端用户的需求和痛点；\n3、理解电商业务中各个角色的生产关系和业务场景，产品端到端设计能够支持业务高效运转；\n4、理解电商平台在生态中发挥的作用，产品规划能够支撑平台健壮、规模化发展。","requirement":"1、2027届获得本科及以上学历，计算机等理工类相关专业优先；\n2、有电商B端产品相关经验优先；\n3、跨团队协作能力强，具备优秀的沟通表达能力；\n4、具备良好的逻辑思维与抽象能力；\n5、有英文语言能力优先。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787132611391,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A107115","job_id":"7664966323365628165","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_