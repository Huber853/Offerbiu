{"code":0,"data":{"job_post_detail":{"id":"7669685133130221877","title":"AI产品经理（策略产品方向） - 小荷健康","description":"团队介绍：小荷健康是字节跳动旗下的医疗健康品牌，我们致力于利用大模型技术，探索医疗健康服务的新范式，孵化了“小荷AI医生”app，为用户提供专业的健康咨询服务。小荷健康拥有专业的医学和互联网产研团队，认真探索AI医疗。\n\n1、负责抖音产品工作，独立跟进子项目的需求分析与规划，产品需求梳理；\n2、与技术团队紧密协作，探索并提出创新的解决方案，推动方案落地。","requirement":"1、2027届获得本科及以上学历；\n2、有计算机相关知识，掌握编程能力，了解算法和大语言模型等方面的知识；\n3、有产品思维、有基本的用户理解、行业洞察、数据分析能力；有学习理解能力、逻辑思维能力，有自驱力/好奇心/求知欲等，结果导向，有成长潜力；\n4、对业务有理解，能基于明确的业务场景或需求输出产品Demo或搭建AI应用等工作流，高效推动产品落地；\n5、如果你有医疗背景，对医疗和健康行业有理想与热情，会更加加分。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785737731576,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A176552","job_id":"7669685091866331445","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":