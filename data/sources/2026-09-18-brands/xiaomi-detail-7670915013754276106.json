{"code":0,"data":{"job_post_detail":{"id":"7670915013754276106","title":"悬架软件开发工程师-汽车","description":"1. 负责悬架电控软件的信号需求定义， HMI需求定义， 诊断规范定义；\n2. 负责空气弹簧系统和电控减振器应用软件模块的开发、功能安全开发；\n3. 跟踪落实电控悬架软件开发进度，负责软件问题的跟踪和解决，确保产品按时上市；\n4. 负责悬架电控软件的技术规范、测试规范、工程分析方法等技术文件体系建设、修订；","requirement":"1. 硕士及以上学历，车辆工程、机电工程 、软件工程、电气自动化等相关专业；\n2. 熟悉悬架或底盘系统电控产品开发流程；\n3. 熟练使用Matlab/Simulink， 能够独立完成建模开发任务；\n4. 熟悉空气悬架系统，电控减振器系统， 具有电控悬架产品相关行业工作经验者优先；\n5. 熟悉车辆垂向控制原理/驾驶舒适性控制原理和评价指标， 具备一定评价能力者优先；\n6. 具备良好的职业素养和团队协作精神， 工作积极主动、，执行力及责任心强。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024164651,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670915013754112266","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":