{"code":0,"data":{"job_post_detail":{"id":"7670884337122576650","title":"产品运营","description":"1、负责业务运营工作，包括收集用户反馈，优化产品体验，执行运营策略、渠道营销策略；\n2、负责组内各类运营数据的整理和分析，洞察行业动态；\n3、对产品有一定分析能力，对卖点提炼具备洞察力，根据产品制定运营策略（包括但不限于广告投流策略）\n4、对产品包装及宣传有一定创意，负责品类的包装及营销，定期输出活动页面策划方案，提升品类的销量；\n5、与供应商及其平台设计，运营等各个部门对接沟通，确保运营方案的最终结果，以及后续跟进和反馈；\n6、通过PUSH、活动运营、资源位、营销渠道运营、内容运营等提升活跃。","requirement":"1、本科及以上学历；\n2、了解常见互联网产品的运营模式；\n3、英语听写良好，具备较好的文案能力；\n4、较强的创意策划能力，扎实的数据分析能力，出色的项目规划和执行能力，良好的沟通表达能力；\n5、有互联网公司实习经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017001101,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670884337122412810","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_