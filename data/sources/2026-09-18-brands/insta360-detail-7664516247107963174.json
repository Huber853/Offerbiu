{"code":0,"data":{"job_post_detail":{"id":"7664516247107963174","title":"区域零售管理专员-2027校招","description":"1、负责我司国内区域体验店战略合作伙伴的开拓以及日常维护管理； \n2、制定区域零售战略，达成年度销售目标（含销量、市占率、利润等核心指标）； \n3、负责区域内专卖店的零售运营管理，制定零售策略。包括新品上市、促销、线下活动、人员管理等，保证门店的运营标准化并达成营收目标； \n4、通过进行区域零售市场洞察，制订零售体验店开发建设目标，达成门店的季度/年度开拓数量目标； \n5、定期进行区域内门店巡店，了解一线门店动态，保证店面、人员形象符合品牌规范的同时，制订优化策略；\n6、负责区域内专卖店选址，通过和地产商的建联、对接为我司进行专卖店选址； \n7、管理加盟门店团队，优化人员绩效考核及梯队建设。","requirement":"1、本科及以上学历； \n2、积极进取，对外沟通及拓展能力强；\n3、热爱相机/3c数码/电子科技行业者尤佳，有零售相关实习经历者优先； \n4、执行力、自驱力强，结果导向。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784534430944,"channel_online_status":1,"job_id":"7664516247107815718","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[{"id":"7673730692275407113","name":{"name":"置顶","en_name":"置顶","i18n_name":"置顶"},"style":"{\"backgroundColor\":\"rgba(245, 74, 69, 0.2)\",\"color\":\"rgba(98, 28, 24, 1)\"}","scope_list":[{"id":"7673730692275439881","name":{"name":"校招中文官网仅职位