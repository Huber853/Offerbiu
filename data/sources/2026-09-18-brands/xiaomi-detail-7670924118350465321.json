{"code":0,"data":{"job_post_detail":{"id":"7670924118350465321","title":"大模型agent算法工程师","description":"探索 Agent Harness 研究与应用的前沿技术，构建可进化的 Agent Harness 技术底座，定义可持续学习 Agent 的基础范式，包括但不限于：\n1、Agent Memory：自主记忆管理\n设计端云分层、多智能体共享、多模态统一的记忆架构，支撑跨设备跨场景的记忆服务能力；探索记忆读写策略与组织结构的自适应演化机制，实现 Agent 层级的持续学习与自纠错。\n2、Agent Search：搜索智能体与策略优化\n融合遗传进化、语言反思与搜索算法，构建 Search Agent 的经验闭环优化范式，探索从数据构建到在线迭代的后训练全流程，结合多智能体实现协同搜索与策略优化。\n3、Agent Harness：可进化的执行底座\n基于执行 Trace 实现 Harness 在线诊断与自动优化，探索 Test-time 数据高效的 Agent 策略优化范式，兼顾探索效率与决策稳定性。","requirement":"1.计算机相关方向的硕士或博士;\n2.有大模型AIAgent相关研究和项目经历,一作发表过相关方向向的顶会论文;\n3.具有优秀的解决复杂问题和多人协作沟通的能力,能够独立思考并开展工作,具有强烈的好奇心和责任心。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026286051,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761476330340460","name":"算法类","en_name":"Algorithm","i18n_name":"算法类"},"job_id":"7670923739325253929","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_typ