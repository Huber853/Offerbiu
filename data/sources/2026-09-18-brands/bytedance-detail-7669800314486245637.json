{"code":0,"data":{"job_post_detail":{"id":"7669800314486245637","title":"战略商业分析师 - 抖音电商","description":"团队介绍：抖音电商以“总能发现好东西”为主张，致力于成为用户发现丰富好物的首选平台。众多抖音创作者通过短视频、直播、商城等丰富的形式，给用户提供更个性化、更生动、更高效的消费体验。同时，抖音电商积极引入优质合作伙伴，为商家变现提供多元的选择。\n\n1、根据公司战略目标与方向，负责抖音电商业务各方向的核心指标体系搭建及目标、各类管理及激励政策制定，持续追踪业务经营表现并进行诊断归因，优化各类收益测算模型，提升决策效率；\n2、关注宏观市场、核心市场动态，持续跟进业务重点策略动作，结合内外部信息及洞察，定期参与业务年度规划等战略制定工作；\n3、研究业务重点发展方向的战略课题、专项研究，包括不限于用户、产品、广告、类目等，综合内外部数据和研究手段，产出洞察建议并推动策略落地。","requirement":"1、2027届获得本科及以上学历；\n2、有互联网商业、数据分析、咨询公司建模分析的实习经验优先；数据分析能力强，喜欢挖掘数据背后的商业本质，能熟练使用Excel，有SQL及数据可视化分析工具经验优先；\n3、拥有较强的逻辑思维能力、自驱力和主动性，以及良好的团队沟通和合作能力。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785764694852,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A65532B","job_id":"7669799515839088949","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_