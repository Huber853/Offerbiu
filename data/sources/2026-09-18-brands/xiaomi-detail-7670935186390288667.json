{"code":0,"data":{"job_post_detail":{"id":"7670935186390288667","title":"服务质量运营专员-西语-外派","description":"岗位描述:\n1、负责服务部门重点质量专项管理，对接服务质量成熟度提升和行业质量奖项目工作，日常监控业务质量指标、梳理业务质量管理薄弱项目，分析推动业务提升；\n2、与集团各级质量部门对接，承接质量目标，对内协同质量管理，站在运营质量角度对业务流程进行事前预防、事中管理、事后复盘的全流程闭环管理，保障业务运营安全；\n3、建立服务业务的质量文化体系，通过企业的质量状态进行质量文化传播的策划/执行/落地；\n4、完善服务质量相关制度，对接质量委的日常运营工作，并推动制度的落地执行；\n5、完成服务运营的其他临时项目工作","requirement":"1、本科及以上学历，电子工程，质量管理，项目管理，统计学（大数据分析方向）等相关专业； \n2、逻辑思维能力强； \n3、有较强团队合作精神，有钻研专业精神，上进心强，具备较强的沟通组织协调能力和统筹能力； \n4、对数据有敏感性，善于发现和总结问题； \n5、有设计/视频/宣发活动经验优先。","city_info":{"code":"CT_103","name":"墨西哥城","en_name":"Mexico City","i18n_name":"墨西哥城"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028911922,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051858028","name":"外语外派类","en_name":"Global Expatriate","i18n_name":"外语外派类"},"job_id":"7670935186390157595","city_list":[{"code":"CT_103","name":"墨西哥城","en_name":"Mexico City","location_type":3,"i18n_name":"墨西哥城","py_name":"moxigecheng","mdm_code":"MDCY00002557","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_103","name":"墨西哥城","en_name":"Mexico City