{"code":0,"data":{"job_post_detail":{"id":"7664582679136323894","title":"社媒服务管培生-2027校招","description":"1、账号运营：负责海内外社媒平台售后方向账号的定期发布，定期复盘账号矩阵数据，关注用户反馈；\n2、内容运营：负责对接内容需求，参与内容产出，把控图文、视频内容产出质量；\n3、活动运营：协助策划与执行社媒平台用户运营活动，追踪活动数据并持续优化方案，提升用户活跃度与品牌影响力；\n4、用户运营：识别社媒上的潜力创作者，建立合作关系并推动内容共创；\n5、成长路径：通过轮岗培养社媒全链路运营能力，提供成为复合型人才的成长平台，未来有机会统筹社媒运营策略制定与执行。","requirement":"1、新媒体、影视、广告、营销等相关专业优先，熟悉无人机、影像类产品使用；\n2、熟悉海内外主流社媒平台，英语6级以上，留学经验优先；\n3、文案功底好，有基础图文、视频制作能力，具备一定审美能力（需附作品集或相关链接）；\n4、熟练使用PS、Figma、Final Cut、PR、AE等设计工具，具备AIGC应用经验优先；\n5、语言逻辑好、沟通能力强、创意丰富，了解时事热点，具备用户同理心。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784550345879,"channel_online_status":1,"job_id":"7664582679136176438","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}