{"code":0,"data":{"job_post_detail":{"id":"7669713775031748869","title":"游戏角色原画设计师 - Glow Studio","description":"团队介绍：Glow Studio 微光工作室。团队深耕轻竞技和动作游戏赛道，也在持续探索品类发展新可能。我们以热爱、匠心、和创新的理念专注精品研发，打造富有激情与感染力的游戏产品，服务全球玩家。期待您的加入，共筑创意梦想！\n\n1、根据项目要求完成项目美术风格预研，配合团队制定美术风格；\n2、与程序、策划及UI协调沟通，准确实现项目开发的需求，跟进版本内实现的效果；\n3、按时按质量完成工作，严格要求自己，并为游戏的视觉不断完善积极提出更有建设性的意见。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有游戏美术设计经验，具备深厚的美术功底与优秀的手绘能力，熟悉绘画软件及AI绘图等相关工具；具备优秀的审美能力，对风格化，趣味性有强烈的追求，能迅速准确地设计出风格需求下的角色；对风格化，趣味性表达有强烈的追求；\n3、做事认真细致，精益求精，严于律已，具有高度责任感和团队合作精神；\n4、具备良好的沟通能力与协作能力，可以独当一面，对策划需求有自己的见解；\n5、热爱游戏，对游戏创作有高度热情；\n6、请上传作品集，欧卡Q版风格优先。","job_category":{"id":"6850051246036879630","name":"游戏美术","en_name":"Game Art","i18n_name":"游戏美术","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_45","name":"广州","en_name":"Guangzhou","i18n_name":"广州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785744520287,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A10927","job_id":"7668554820093593909","city_list":[{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"sto