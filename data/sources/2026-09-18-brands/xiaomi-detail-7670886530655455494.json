{"code":0,"data":{"job_post_detail":{"id":"7670886530655455494","title":"Retail Operations Specialist","description":"一、渠道零售运营\n跟进渠道合作进度，定期收集反馈并推动问题解决\n整理各渠道销售数据，分析渠道贡献度、动销率、铺货率等指标\n对比不同渠道表现，为资源投放和策略调整提供数据支持\n协助策划渠道促销、联合营销等活动，跟进落地执行\n制作渠道物料（宣传册、海报、陈列指引等）并跟进配送\n评估活动效果，输出总结报告\n二、门店及终端管理\n汇总巡检问题，推动门店整改并跟踪结果\n三、内部协同与流程\n跨部门协作\n对接销售、市场等部门，确保渠道信息同步\n流程优化\n记录渠道及零售运营中的流程痛点，提出改善建议\n协助梳理渠道管理 SOP 及相关文档","requirement":"本科及以上学历，市场营销、工商管理、零售管理等相关专业优先\n1 年以内渠道/零售运营相关经验（应届生亦可）\n熟练使用 Office 办公软件，尤其 Excel 数据处理能力\n具备良好的沟通协调能力，善于与内外部多方对接\n执行力强，细心负责，能适应一定程度的外出走访\n有快消、零售行业实习经验者加分","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017520104,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879437933","name":"销售类","en_name":"Sales","i18n_name":"销售类"},"job_id":"7670886530655291654","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","locatio