{"code":0,"data":{"job_post_detail":{"id":"7670919156360284466","title":"电气性能开发工程师-汽车","description":"1. 负责整车电磁仿真的网格模型处理，根据项目需求优化网格划分策略，确保网格质量满足仿真精度与效率要求；\n2. 负责整车电气性能（EMC、电气性能和天线）的属性开发工作（包括：竞品分析、方案设计、仿真分析、数据校核、开发验证、问题分析和改进）；\n3. 负责整车电气性能仿真，优化整车电气性能设计方案；\n4. 负责整车电气性能问题分析与解决； \n5. 负责整车电气性能新技术研究，推进整车电磁兼容方案降本增效；","requirement":"1. 本科及以上学历，电子信息、通信、电气工程、自动化、机电一体化、车辆工程、电磁场与微波等相关专业。具备深厚的电磁基础理论，对电磁传输特性有深入的理解；\n2. 熟悉天线，电磁兼容原理，仿真，设计和验证； \n3. 熟悉汽车EMC、电性能、天线相关标准（如GB34660，ECE R10，CISPR12，CISPR25，ISO11451/2，ISO7637，ISO16750）\n4. 熟练使用ANSYS、Feko、CST等电磁兼容仿真软件； \n5. 熟练使用频谱分析仪、网络分析仪、示波器、CANoe等设备；\n6. 具有良好的沟通能力和团队合作精神；","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025179122,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919156360120626","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_i