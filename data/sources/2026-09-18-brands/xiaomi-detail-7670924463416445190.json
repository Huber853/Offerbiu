{"code":0,"data":{"job_post_detail":{"id":"7670924463416445190","title":"手车互联研发工程师-汽车","description":"1、参与小米汽车互联互通业务应用、核心中间件的开发；\n2、负责小米汽车座舱手车互联、超级任务、CarIoT等互联项目开发和交付；\n3、负责互联互通应用的性能调优，包括内存、功耗、稳定性等方向的优化。","requirement":"1、本科及以上学历，计算机、通信、电子、自动化等相关专业，具备扎实的计算机基础知识；\n2、熟悉 Java/C/C++/Kotlin 开发，具备良好的代码设计、调试和问题定位能力，有嵌入式或车载系统开发经验优先；\n3、熟悉 Linux/NuttX/RTOS 等操作系统原理，了解多线程、消息队列、网络通信、设备驱动等基础机制；\n4、熟悉 TCP/IP、Bluetooth/BLE、Wi-Fi、串口、Pogopin 等一种或多种底层通信方式，有设备连接协议开发经验优先；\n5、了解应用层协议栈设计，熟悉 Protobuf、JSON、MQTT、HTTP 或私有协议开发者优先；\n6、有 IoT 设备接入、手车互联、车机互联、智能硬件、穿戴设备或车载应用开发经验者优；\n7、优秀的学习能力、良好的沟通能力、团队合作精神；工作积极主动、认真负责、具有高度的责任感。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026407734,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670924463416248582","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":