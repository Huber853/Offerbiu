{"code":0,"data":{"job_post_detail":{"id":"7668229255391447301","title":"广告产品经理 - 国际化内容与服务广告","description":"团队介绍：内容与服务广告团队是全球变现产品组织的一部分，负责为应用下载、游戏、短剧、线索等行业客户构建广告产品。我们的愿景是通过构建支持独特垂直需求、新的变现模式和应用生命周期不同阶段的产品，使我们的产品成为营销人员获取、保留和变现用户的领先平台。\n\n1、负责国际化广告产品设计开发，跟进需求开发和上线，并协调推动相关业务团队高质量执行；\n2、负责对广告效果度量相关数据进行整理、验证和分析，提升产品开发效率和客户体验；\n3、通过数据分析、需求收集、用户反馈，发现并优化潜在需求，提出优化建议；\n4、对数据问题进行诊断和排查，解决数据披露上暴露的问题，增强客户信赖。","requirement":"1、2027届获得本科及以上学历；\n2、具备流利地道的英语听说读写能力；\n3、良好的自我驱动力，能够在工作环境中处理多项任务；\n4、较强的逻辑思维能力，善于分析处理数据。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785398837480,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A53373A","job_id":"7668216207970994485","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list"