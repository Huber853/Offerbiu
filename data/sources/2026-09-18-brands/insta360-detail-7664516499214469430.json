{"code":0,"data":{"job_post_detail":{"id":"7664516499214469430","title":"零售运营专员（零售BP）-2027校招","description":"1、数据分析：结合专卖店业务执行场景，完善专卖店运营数据分析看板，基于数据监测主动识别问题、机会和风险，对具体问题点进行专题分析；\n2、社媒运营：负责管理门店抖音/小红书/企业微信等部分平台新媒体日常内容的发布及运营，把关内容安全、质量和传播效果；\n3、活动策划：策划线下活动及执行，及时调整运营策略并定期迭代内容形式和社媒运营方案；\n4、跨部门对接：与上下游供应链、品牌设计、市场、IT等相关部门进行资源对接，协作进行国内专卖店智能运营管理体系搭建；\n5、流程优化：负责专卖店运营流程标准的执行与迭代，不断优化门店建设、产品管理、销售管理、服务体验、效能管理、陈列维护等精细化运营管理工作。","requirement":"1、本科及以上学历，市场营销、数据分析等专业优先； \n2、英语水平优秀者更优； \n3、善于沟通，有跨部门协调工作的团队合作精神； \n4、善于使用Excel等软件进行数据整理、透视，善于PPT制作和汇报。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784534514117,"channel_online_status":1,"job_id":"7664516499214321974","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}