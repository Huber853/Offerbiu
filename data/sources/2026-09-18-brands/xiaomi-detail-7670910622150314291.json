{"code":0,"data":{"job_post_detail":{"id":"7670910622150314291","title":"处理器验证工程师","description":"参与处理器芯片验证平台搭建、芯片验证效率优化和芯片验证方法学改进等相关工作。\n1、制定CPU UT/IT验证计划，提取测试点；\n2、搭建UT/IT测试平台，编写测试用例题；\n3、收集覆盖率，完成验证报告；\n4、协助EMU/FPGA问题定位支撑。","requirement":"1、微电子、集成电路、电子工程、计算机科学或相关专业；\n2、熟悉Verilog或SystemVerilog，了解UVM，有实际项目经验优先；\n3、掌握至少一种脚本语言（如Python, Perl, TCL），熟悉Linux操作系统；\n4、熟悉乱序多发射CPU微架构原理，有实际CPU开发经验者优先；\n5、熟悉RISCV指令集或者ARM指令集优先；\n6、具有良好的团队合作精神，能独立思考和解决问题，有责任心和上进心，工程师素养佳。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786023127325,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670910622150134067","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":