{"code":0,"data":{"job_post_detail":{"id":"7670928869599742214","title":"冰箱性能研发工程师（制冷/保鲜）","description":"方向1：制冷方向\n1、负责产品制冷模块技术的研究，两器设计、压缩机匹配等工作；\n2、负责相应领域前沿技术及趋势，相关标准及学术论文研究；\n3、基于功能需求，搭建简单的实验平台，验证技术调研并探索其在产品上应用。\n方向2：保鲜方向\n1、跟踪用户需求、竞品动态与前沿趋势，输出技术方案与原型验证。\n2、解决食品在低温存储中的变质、串味、营养流失问题，优化保鲜性能与用户体验。\n3、负责保鲜技术的专利布局、论文撰写、标准制定，推动行业技术升级。","requirement":"1、本科及以上，食品科学与工程（偏食材保鲜方向）、制冷低温等家电研发相关专业，硕博优先\n2、熟练掌握制冷理论、热力学、流体力学等基础性专业；\n3、熟练使用CAD、CREO、PRO/e、UG或Soliedworks等软件进行设计开发；\n4、具备团队合作意识和创新意识，具有较强的学习能力和沟通协调能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027320428,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670928869599578374","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"tag_list":[],"storefront_mode":1,"stor