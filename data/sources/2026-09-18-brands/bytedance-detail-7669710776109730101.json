{"code":0,"data":{"job_post_detail":{"id":"7669710776109730101","title":"增长营销经理 - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、负责番茄分销平台的策略运营，为短剧收入、规模增长负责；\n2、从投放资源最大化角度，为分销商、代理商、达人机构建设更完善的匹配机制和能力，提升资源撮合效率；\n3、紧密关注行业增长动态、内容发展和经营ROI，实现分销平台经营健康。","requirement":"1、2027届获得本科及以上学历；\n2、熟悉互联网广告常识，具备流量平台运营相关实习经验；\n3、具备良好的判断力，对平台资源撮合、经营、数据有自己独到的见解；\n4、自驱、踏实、主动、责任心强，能够不断推动复杂问题的解决。","job_category":{"id":"6704216057269192973","name":"产品运营","en_name":"Product ops","i18n_name":"产品运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785743716814,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A40584","job_id":"7668204215258679557","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","na