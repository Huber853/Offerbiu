{"code":0,"data":{"job_post_detail":{"id":"7670934555872348470","title":"产品操盘专员-西语-local","description":"1、负责产品海外市场操盘，参与产品规划立项、上市到退市整个产品生命周期管理；\n2、制定产品上市的整体策略，包括市场洞察、竞争分析、渠道调研、价格制定、品牌营销、产品生命周期内销售政策的制定和调整，对产品经营结果负责；\n3、商业项目过程管理，拉通产品研发、市场、销售、服务、交付，对产品在市场上的品牌塑造和商业成功负责，主动识别风险并解决问题；\n4、跟进区域经营，协助指导地区部GTM方案的制定和落地，协调不同的职能部门，解决地区部的问题，满足地区部的需求。  ","requirement":"1、本科及以上学历，计算机、统计、数学以及商务管理等相关专业优先； \n2、有电子通讯相关行业实习经历，手机行业优先； \n3、英语听说读写优秀，英语可以作为工作语言使用， 如会西语加分；\n4、学习能力强，思路清晰，数据敏感度高，适应快节奏、高效率工作，良好的沟通能力和组织能力。","city_info":{"code":"CT_96","name":"马德里","en_name":"Madrid","i18n_name":"马德里"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028672056,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879437933","name":"销售类","en_name":"Sales","i18n_name":"销售类"},"job_id":"7670934555872217398","city_list":[{"code":"CT_96","name":"马德里","en_name":"Madrid","location_type":3,"i18n_name":"马德里","py_name":"madeli","mdm_code":"MDCY00003410","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_96","name":"马德里","en_name":"Madrid","location_type":3,"i18n_name":"马德里","py_name":"madeli","mdm_code":"MDCY0000