{"code":0,"data":{"job_post_detail":{"id":"7670923493168826678","title":"搜索与推荐算法工程师","description":"1.负责业务的搜索推荐系统的算法设计与优化；\n2.对搜索推荐算法有着较为全面的认知，了解各类搜推领域相关算法，能够自主负责整套推荐系统架构的设计与算法开发工作；\n3.跟踪和研究搜推算法的前沿技术，如大模型搜推等，并将其应用于实际业务中，推动搜索推荐系统的创新和升级；\n4.对AI搜索有经验和认知的同学，将优先录取。","requirement":"1.硕士及以上学历，计算机科学、信息工程、机器学习、人工智能等专业，有C++/python开发经验；\n2.熟悉常用的大数据处理平台工具，包括Spark/Flink/Hbase/Kafka等，并有过处理分析数据经验，熟练掌握至少一种深度学习框架，如Tensorflow，PyTorch等；\n3.有过搜索/推荐/计算广告/数据挖掘方面经验优先，掌握常规的深度学习与推荐算法知识。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026111316,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761476330340460","name":"算法类","en_name":"Algorithm","i18n_name":"算法类"},"job_id":"7670923493168646454","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"c