{"code":0,"data":{"job_post_detail":{"id":"7677517227884972342","title":"【27届校招】商品运营策略-得物国际","description":"1、研究C端用户的商品导购需求，包括但不限于商品功能、尺码导购、适用场景/人群、尺寸容量示意等，结合用户提供的信息，通过信息交互展示优化及AI解读的方式高效满足用户需求；\n2、研究平台的选品策略，结合站内用户需求、市场爆品画像、站内外市场趋势分析等方法，输出机会商品策略及对应商品线索，驱动更多动销商品；\n3、商品诊断：分析当前商品的流量转化率和动销表现，及时发现流量/商品展示/价格/库存/商品信息的潜在策略问题，提出优化方向，并推动落地。","requirement":"1、2027届应届生，本科及以上学历；\n2、有AI相关实习项目经历或成果优先；\n3、有电商商品策略实习经验者优先；\n4、具备良好的数据分析能力，强自驱及学习、沟通协同能力优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787561938889,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287150094318389559","name":"运营类","i18n_name":"运营类"},"job_id":"7677517227884661046","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}