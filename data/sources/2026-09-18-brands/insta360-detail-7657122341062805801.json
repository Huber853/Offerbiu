{"code":0,"data":{"job_post_detail":{"id":"7657122341062805801","title":"射频工程师-2027校招","description":"1、根据公司产品需求进行新技术性能评估和验证，确认新技术量产可行性和技术竞争力；\n2、负责项目中射频研发设计工作，包括射频方案评估与架构设计、原理图与PCB设计、射频功能/性能调试、认证和生产问题处理等；\n3、参与射频领域技术能力建设相关工作，包括但不限于无线技术路线演进、无线信号传输性能的提升、成本优化等，输出对应技术文档；\n4、负责项目研发过程中的其他工作，包括制定与维护各产品形态射频模块设计标准、测试规范以及射频产测方案、跨部门协同等。","requirement":"1、本科及以上学历，通信、电子信息、电磁场类相关专业，英语4级以上；\n2、掌握数电、模电、高频电子线路、微波技术等基础知识，理解传输线理论、无线收发机架构、无线通信原理等基础概念；\n3、具备良好的学习能力、责任心和上进心，团队协作和独立思考意识强。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782812899924,"channel_online_status":1,"job_id":"7657121678100007210","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}