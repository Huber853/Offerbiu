{"code":0,"data":{"job_post_detail":{"id":"7670918737398761737","title":"台架试验工程师-汽车","description":"1、负责或参与台架试验开展前的样品接收、状态确认以及准备工作；\n2、负责试验大纲的编制；\n3、负责试验任务具体实施过程中的试验操作、设备监控以及数据记录；\n4、负责编制台架试验相关作业文件；\n5、负责台架试验问题提报、处理过程跟踪、问题验证以及关闭工作；\n6、负责试验结果的处理，包括试验数据的分析研究、试验报告的出具；\n7、负责台架的试验运行，参与台架拆装、设备保养、期间核查以及现场台架持续运转维护、记录；\n8、负责台架及关联设备的日常维护、保养等；\n9、负责试验室参观接待讲解；\n10、负责相关试验工作中的AI工具搭建与优化。","requirement":"1、本科及以上学历，机械工程或机电、自动化、汽车等工科相关专业、或与AI\u0026大模型相关专业；\n2、参与过与汽车相关的课题项目或者AI\u0026数据库相关课题项目。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025040157,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670918737398597897","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY000000