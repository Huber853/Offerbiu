{"code":0,"data":{"job_post_detail":{"id":"7668658032092236085","title":"激励增长产品经理 - TikTok","description":"团队介绍：TikTok是一个覆盖150个国家和地区的国际短视频平台，我们希望通过TikTok发现真实、有趣的瞬间，让生活更美好。TikTok在全球各地设有办公室，全球总部位于洛杉矶和新加坡，办公地点还包括纽约、伦敦、都柏林、巴黎、柏林、迪拜、雅加达、首尔和东京等多个城市。\n\n1、负责TikTok的激励体系的产品设计工作，包括但不限于玩法设计、需求文档撰写、功能优化、已有项目跟进，通过产品迭代达成增长目标；\n2、收集并整理内、外部用户反馈，推动产品线上体验的优化落地，对用户体验负责；\n3、产品指标监控与分析，与相关团队合作快速识别问题以及产品功能连续迭代，追求产品关键指标的提升。","requirement":"1、2027届获得本科及以上学历；\n2、了解产品基础工作框架，有产品实习经验、用户增长实习经验优先；\n3、工作认真细心，学习能力和自驱力强，较好的逻辑思维能力及跨团队沟通能力；\n4、英语读写流利，可作为工作语言，有国际化学习经历优先，有日语/韩语/西语等小语种能力优先。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785498828261,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A250527","job_id":"7667900208688367877","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"t