{"code":0,"data":{"job_post_detail":{"id":"7670918646432975113","title":"产品经理-驾驶安全方向","description":"1. 负责汽车驾驶安全相关一个或多个方向的产品规划及落地；\n2. 负责汽车驾驶安全相关领域的行业、用户和竞品调研，深度挖掘用户需求并转化为可落地的产品解决方案；\n3. 负责协同智驾、座舱等相关产研团队，实现安全产品方案落地并为效果结果持续迭代优化；\n4. 负责持续提升用户驾驶安全体验，提升用户驾驶安全感知，追求极致，做最酷的产品；\n5. 负责跟进对应方向的用户驾驶安全问题，并推进解决、缓解问题。","requirement":"1. 硕士及以上学历， 极致追求提升用户产品体验；\n2. 具备较强的团队协同能力以及较强的表达沟通逻辑；\n3. 学习能力强，能够通过积极主动的学习快速适应岗位要求；\n4. 热爱驾驶且有实际驾驶经验和能力，汽车工程、计算机相关专业或工作经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025086792,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670918646432811273","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"tag_list":[],"storefron