{"code":0,"data":{"job_post_detail":{"id":"7671295170927364378","title":"Java工程师-云服务","description":"1、负责小米云存储/同步核心服务和小米账号体系的服务端开发工作,包括需求拆解、方案设计到编码上线的全流程工作；\n2、针对高并发账号访问、海量用户云端数据同步场景,开展性能优化、成本优化等工作,保障服务高质量运行；\n3、参与线上故障定位、应急修复、完善监控告警,配合跨团队SDK、客户端等系统的后端接口联调对接；\n4、沉淀开发规范与技术文档,参与架构优化与新技术预研,提升小米云服务与小米账号等后台的系统的可扩展性和安全性。","requirement":"1. 计算机相关专业应届毕业生,扎实掌握 Java 基础,熟悉 Java 后端技术栈,有完整项目实践优先；\n2. 熟悉常用数据结构、计算机网络、操作系统基础知识,具备良好代码编写与问题排查能力；\n3. 具备较强学习能力、逻辑思维,乐于跨端技术学习,能够接受根据团队需求从事客户端或服务端开发工作；\n4. 责任心强,善于沟通协作,遵守开发规范,有持续钻研技术的习惯。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112685319,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7671295170927233306","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_