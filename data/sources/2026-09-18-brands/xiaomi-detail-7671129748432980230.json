{"code":0,"data":{"job_post_detail":{"id":"7671129748432980230","title":"内容策划","description":"1、挖掘产品与技术亮点，将专业技术转化为用户易理解、有传播力的内容；\n2、新品上市、技术传播、产品种草等项目的内容策划与创意落地；\n3、微博、抖音、小红书等新媒体平台的选题策划与内容运营，结合热点持续打造优质内容；\n4、策划米粉活动等用户运营项目，通过用户互动与反馈，持续优化产品传播；\n5、关注家电行业、用户需求及内容趋势，持续探索新的营销内容和传播方式。","requirement":"1、2027届本科及以上学历，市场营销、广告、新闻传播等相关专业优先，专业不限；\n2、对家电、科技产品和消费电子有兴趣，愿意主动研究产品和技术；\n3、有较好的用户洞察和内容敏感度，能从用户视角发现有价值、有意思的传播点；\n4、具备良好的文案和策划能力，有校园媒体、新媒体运营、广告营销、内容创作等相关实践经验优先；\n5、思维活跃，有创意，对微博、抖音、小红书等社交平台和热点内容敏感；\n6、具备良好的沟通协作和执行能力，责任心强，能够推动事情落地；\n7、熟悉AI工具，有使用AI辅助调研、策划、内容创作等经验者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786074133609,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7671129748432849158","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status"