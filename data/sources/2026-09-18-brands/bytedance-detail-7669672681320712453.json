{"code":0,"data":{"job_post_detail":{"id":"7669672681320712453","title":"用户产品经理 - 今日头条","description":"团队介绍：产品覆盖今日头条、头条极速版等各类产品，为上亿用户持续提供优质的资讯、视频等服务。我们通过建立良好的内容生态，鼓励优质的原创内容，为创作者提供优质的服务和创作体验，促进创作和交流，同时我们致力于通过尽可能丰富的内容体裁和尽可能多的分发方式，连接人与信息，丰富大家的精神生活，让人们看到更大的世界。\n\n1、负责今日头条用户产品方向相关工作，能独立完成目标拆解和路径规划；\n2、结合产品定位，深入用户使用场景，主动挖掘用户需求，推动产品持续创新和优化；\n3、协调内部资源，高效高质量完成相关迭代上线。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有过手机客户端产品实习经验优先，有资讯类、信息流、社区类产品策划运营实习经验优先；对内容平台型产品有高度兴趣，熟悉市场上主流平台产品和创作社区；\n3、较强的逻辑思维能力、推动力和执行力，有良好的沟通协作能力；\n4、数据意识和数据分析能力强，结果导向；\n5、有责任心，善于发现问题和解决问题。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785735169626,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A111031","job_id":"7667861256787233029","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"She