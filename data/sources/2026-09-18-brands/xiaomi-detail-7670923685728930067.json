{"code":0,"data":{"job_post_detail":{"id":"7670923685728930067","title":"游戏联运运营经理","description":"1.负责在小米联运游戏的运营工作，输出运营策略和整体规划，为总体收入目标负责；\n2.负责已上线游戏产品的运营数据监控和分析，并持续提出业务优化方案，推进落地；\n3.了解平台运营流程，把握市场趋势，制定平台能力侧升级及改进计划；\n4.负责跨部门协调和沟通，推动专项业务人员紧密合作达成专项目标。","requirement":"1.对各类游戏产品有较深刻的认识，了解行业发展，熟练掌握各种营销手段，能够策划、组织各类活动，执行能力强；\n2.熟悉运营数据分析及统计方式，具备很好的数据解读能力；能够对产品提出独到的见解和调优方法；\n3.富有创新精神和学习能力，良好的沟通能力和业务合作意识，有较好的管理能力；\n4.做人诚信，做事踏实，有事业心，对工作有持久的热情和主动性。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026186610,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670923462551472447","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"tag_list":[],"storefront_mo