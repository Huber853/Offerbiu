{"code":0,"data":{"job_post_detail":{"id":"7682681391491025205","title":"数据分析师 - 抖音音乐","description":"团队介绍：团队负责字节跳动中国音乐业务，包括流媒体汽水音乐，抖音音乐、版权内容等相关业务，我们致力于成为具有影响力的音乐平台，成为让用户最容易发现音乐、了解音乐、进行音乐表达和创作、围绕音乐交流的社区。\n\n1、负责汽水音乐业务的数据分析工作；\n2、分析各项影响业务提升与增长的因素、内容供给生态结构变化，结合业务方向给出可落地的整体策略及运营优化方案；\n3、与产品/运营/研发等配合，推进优化方案落地执行，推动业务实际提升与增长；\n4、负责业务上各类A/B实验设计与分析，运营策略或市场活动分析评估，核心指标异动分析等。","requirement":"1、2027届获得本科及以上学历，数学、统计学、计算机等相关专业优先；\n2、具有良好的团队配合能力，沟通能力；\n3、工作细致，精通SQL，熟练使用R/Python进行数据分析、挖掘；\n4、对娱乐或音乐行业感兴趣，有深入思考或分析经验。","job_category":{"id":"6704216224387041544","name":"数据分析","en_name":"Data analysis","i18n_name":"数据分析","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788763661055,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A183862","job_id":"7682680397956303157","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list"