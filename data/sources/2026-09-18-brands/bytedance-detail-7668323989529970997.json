{"code":0,"data":{"job_post_detail":{"id":"7668323989529970997","title":"安全研发工程师（AI Agent安全方向） - 安全与风控","description":"团队介绍：安全工程团队负责设计、搭建并维护字节跳动的全球安全基础设施、平台及服务。我们的核心职责是研发具备可扩展性的系统与工具，为公司全域产品的安全运营提供支撑。通过交付可靠、高性能的安全解决方案，保障字节跳动全球平台的安全，并提升业务韧性。\n\n1、参与字节跳动和火山引擎AI Agent身份权限功能的设计和研发工作；\n2、参与字节跳动生产网零信任架构相关设计和研发工作；\n3、探索通过大模型来对产品能力进行提升。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程、网络空间安全、信息安全等相关专业优先；\n2、熟悉Linux操作系统和开发环境，有良好的数据结构、算法基础和系统设计能力；\n3、至少熟悉一种主流编程语言（Go/C++/C/Rust/Java/Python，或NodeJS等），有扎实的编程能力和良好的编码风格；\n4、有良好沟通能力和团队协作能力，工作积极主动，责任心强。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785421173663,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A99406","job_id":"7668324909805734197","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job