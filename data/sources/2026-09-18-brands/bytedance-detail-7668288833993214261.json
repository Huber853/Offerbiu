{"code":0,"data":{"job_post_detail":{"id":"7668288833993214261","title":"抖音生活记录垂类运营经理 - 抖音运营","description":"团队介绍：负责抖音知识，兴趣，消费，生活，娱乐等垂类的创作者运营，主要目标为提升抖音内容供给，探索多元化的作者变现和商业模式，促进多领域的创作者更好地在平台经营和成长。同时也包括抖音中长视频、演出相关业务。\n\n1、负责抖音生活休闲垂类创作者运营，为优质创作者规模、新秀标杆、创作者体验等指标负责；\n2、重点服务于新秀培养，通过选题共建、激励成长、流量扶持、1v1定向服务等策略方法，打造美食新星案例；\n3、热爱内容行业，熟悉主流内容平台的创作者，定期输出不同平台不同流派的创作范式分析；\n4、通过对社会思潮、行业趋势、站内用户需求的分析研究，挖掘用户在美食垂类的消费需求与内容趋势，形成可执行的运营策略和内容玩法。","requirement":"1、2027届获得本科及以上学历；\n2、具备垂类相关工作经验优先；有美食/文旅作者人脉资源者优先；重度视频用户，了解国内视频内容生态；\n3、对创作者运营有深刻理解，内容敏感度高，熟悉内容生产、分发、传播整体链路；\n4、工作细致、有耐心，善于总结沉淀可复用的策略及方法论；\n5、热衷与创作者打交道。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785412718742,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A144929","job_id":"7667888321805404469","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code