{"code":0,"data":{"job_post_detail":{"id":"7669691566811089157","title":"渠道策略运营 - 商业化","description":"团队介绍：抖音集团商业化是抖音集团旗下的综合数字化营销服务平台，致力于让不分行业、地域的企业及个体都能通过数字化技术激发创造、驱动生意，实现商业的可持续增长。\n\n1、负责巨量星图收入以及生态建设，通过观察整理案例，沉淀规模化可复制的方法论；\n2、负责MCN机构/达人在抖音平台的生意分析、策略提案、落地追踪、分析及复盘，输出全链路解决方案，赋能MCN机构在字节跳动生态健康成长，并提升MCN的内容生产能力与变现能力；\n3、与内部销售、内容、数据等职能协作，与外部代理渠道建联，共创提效方案，推动策略迭代和落地；\n4、根据团队分工，负责商业产品专项和研究课题，跟进和推动专项落地。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、对移动相关行业有一定的了解，有自己的观点和看法，有产品运营或行业运营相关实习经验优先；\n3、有较强的沟通能力，逻辑清楚，踏实勤奋，且善于总结；\n4、对数据有敏感度，善于从数据结论发现并总结问题。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785739311637,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A26850B","job_id":"7666023706188450101","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishLis