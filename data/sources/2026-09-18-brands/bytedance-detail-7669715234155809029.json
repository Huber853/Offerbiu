{"code":0,"data":{"job_post_detail":{"id":"7669715234155809029","title":"游戏客户端开发工程师 - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、负责UE4客户端功能的开发与维护；\n2、解决游戏开发以及线上问题，和QA一起确保上线产品质量；\n3、与策划、美术、服务器开发人员保持良好沟通，确保程序功能与需求一致；\n4、保证代码质量与运行效率，持续进行项目功能优化与代码调优。","requirement":"1、2027届获得本科及以上学历，计算机相关专业优先；\n2、C++基础扎实，有良好的编程习惯，有C#或者Lua使用经验的优先；\n3、熟悉常用的数据结构与算法，具备合理运用设计模式的能力；\n4、优秀的学习能力和解决问题能力，能够熟练阅读英文技术文档；\n5、对图形渲染有深入了解的优先，熟悉OpenGL、DirectX、Metal或Vulkan等技术的优先；\n6、良好的沟通和团队协作能力，主动性强，有游戏项目团队开发经验的优先；有UE4或Unity引擎使用经验的优先，有安卓或iOS原生开发经验的优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785744810459,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A190176A","job_id":"7661881988265838901","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"