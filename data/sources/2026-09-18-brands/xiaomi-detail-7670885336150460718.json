{"code":0,"data":{"job_post_detail":{"id":"7670885336150460718","title":"渠道运营专员","description":"负责公司国际服务体系中维修渠道的日常运营与管理，支持全球维修网络的高效运转。通过数据分析、流程优化和跨部门协作，提升客户服务体验与渠道效能。优秀者将有机会外派至海外分支机构，参与国际化业务拓展。\n1. 负责海外售后渠道运营指标的统计，组织相关区域进行评估分析，提供业务改善方案并持续跟进闭环。\n2. 组织协调相关区域在海外的服务门店建设和翻新，门店运营物料的采购提需以及实物海外调拨。\n3. 根据区域业务需要组织渠道服务商引入/清退评审，管理服务商数据。\n4. 监控服务门店日常运营指标和工单数据，支持服务经理管理和考核海外服务门店和人员。","requirement":"1. 本科及以上学历，应届毕业生，专业不限。\n2. 达到日语N1或韩语TOPIK6级及以上，能够日常交流和书面撰写。 \n3. 达到英语六级及以上，可处理英文邮件，口语流利者加分。\n4. 逻辑清晰，擅长跨团队沟通与多任务管理。\n5. 熟练使用Excel/PPT。\n6. 愿意接受外派。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017210502,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670885336130963721","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京",