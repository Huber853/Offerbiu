{"code":0,"data":{"job_post_detail":{"id":"7670918704972777766","title":"OTA系统产品工程师-汽车","description":"1.负责OTA系统整体集成环境下的联调工作；\n2.设计搭建用于OTA整车集成环境联调的台架，供关键零部件进行功能调试；\n3.在交付整车集成测试之前确保OTA的功能、性能和稳定性；\n4.独立完成系统测试的全流程，包括参与需求分析，制定测试计划与方案，定义测试策略，完成用例设计与审核，进行缺陷跟踪和软件质量分析，风险分析；\n5.根据业务需求，开发自动化测试系统与测试工具，完成测试工具的代码编写、调试、测试，协助核心零部件的OTA功能快速测试和迭代；\n6.跟踪重难点问题，定位、分析和解决测试过程中的复杂技术问题；\n7.对测试方法和流程的进行评估与优化，提高测试效率；\n8.设计搭建用于模拟整车的OTA测试BOX CAR台架，用于自动化OTA的可靠性测试。","requirement":"1. 大学本科及以上学历，通信工程、计算机或者自动化专业；\n2. 具有较强的学习能力；\n3. 较强的沟通交流及语言表达能力；","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025030818,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670918704972597542","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":