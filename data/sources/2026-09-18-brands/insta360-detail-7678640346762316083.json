{"code":0,"data":{"job_post_detail":{"id":"7678640346762316083","title":"数字营销管培生（增长营销方向）-2027校招","description":"1、参与搜索与直接营销渠道的日常运营，包括 SEO、GEO、EDM 及相关营销平台；\n2、参与 SEO 策略制定与执行，包括关键词研究、内容优化、站内优化及效果跟踪；\n3、探索 GEO 方法，研究主流 AI 搜索及问答平台的内容引用与推荐机制，提升品牌和产品在生成式搜索中的可见度；\n4、参与 EDM 全流程运营，包括用户分层、内容策划、邮件配置、发送及效果复盘；\n5、根据产品特点、市场节奏和用户需求，策划并执行营销项目，推动用户获取、激活、转化和留存；\n6、关注数字营销和 AI 营销的发展趋势，沉淀可复用的方法、流程与运营经验。","requirement":"1、对 SEO、AI 搜索、内容营销、用户增长或 EDM 有兴趣，愿意持续学习和实践；\n2、有数字营销、用户运营、内容运营、增长或营销平台相关实习经历；\n3、具备良好的逻辑思维和数据意识，能够通过数据发现问题并提出优化思路；\n4、能在快节奏、高压环境下保持高效工作与良好心态；\n5、对新工具和 AI 应用保持敏感，愿意主动尝试并提升工作效率。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787825397297,"channel_online_status":1,"job_id":"7678640346751207726","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}