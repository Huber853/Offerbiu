{"code":0,"data":{"job_post_detail":{"id":"7669693235541756165","title":"创作者运营（音乐方向） - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、负责UGC、PUGC音乐创作者的拓展、引入与日常维护，提升优质作者规模及留存；\n2、挖掘与培养潜力创作者，通过运营策略与资源扶持助力作者成长，打造标杆案例；\n3、结合内容趋势与数据分析，为创作者提供选题方向与创作建议，保障平台优质内容供给；\n4、深入洞察创作者体验痛点，跨团队推动产品与机制优化，持续迭代运营玩法。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、对音乐/内容行业有热情，有敏锐的内容判断力，有内容运营、创作者运营、用户运营等相关领域实习经验；\n3、自驱力强，逻辑清晰，具备数据敏感度，能运用基础工具进行数据分析；\n4、具备良好沟通能力及跨部门协作能力，对内容产品有热情和思考。","job_category":{"id":"6704215961064442123","name":"内容运营","en_name":"Content ops","i18n_name":"内容运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785739733873,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A216518","job_id":"7668205552368191749","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_li