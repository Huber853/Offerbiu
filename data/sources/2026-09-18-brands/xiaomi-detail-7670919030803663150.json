{"code":0,"data":{"job_post_detail":{"id":"7670919030803663150","title":"设备工程师-汽车工厂","description":"1、根据设备故障现象及故障信息，判断、分析并解决现场设备产生的各类故障；\n2、通过设备故障历史数据的分析，对设备实施不断改进， 实现设备更安全、稳定和高效地运行；\n3、根据设备维护手册，参与制订相关设备维护/保养计划；\n4、根据维修人员岗位要求及培训计划，对维修人员和设备操作人员进行培训和指导 。及时响应班组支持需求；\n5、根据设备维护手册及设备运行历史记录，制定本区域设备备件计划及库存数量设置，积极寻求降低备件成本的方法，实现设备维修成本降低。","requirement":"1、本科及以上学历，电气自动化、机械设计、机器人相关专业，人工智能、大数据等相关专业；\n2、熟悉PLC300控制、电路板硬件识别、跑板、电路识别、机械设计、机械原理等基础知识；\n3、有一定机器人编程基础，HTML5、Python、Java、C++等编程语言；\n4、乐观向上、积极主动，可以接受夜班。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025307538,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178743792710893677","name":"供应链类","en_name":"Supply Chain","i18n_name":"供应链类"},"job_id":"7670919030803482926","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code"