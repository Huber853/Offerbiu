{"code":0,"data":{"job_post_detail":{"id":"7669685095146457397","title":"AI产品经理（医疗大模型训练方向） - 小荷健康","description":"团队介绍：小荷健康是字节跳动旗下的医疗健康品牌，我们致力于利用大模型技术，探索医疗健康服务的新范式，孵化了“小荷AI医生”app，为用户提供专业的健康咨询服务。小荷健康拥有专业的医学和互联网产研团队，认真探索AI医疗。\n\n1、负责医疗大模型的能力定义和评测方法探索，牵引模型能力提升；\n2、参与训练医疗大模型，基于对医疗场景的抽象，制定参与制定数据策略和训练策略。","requirement":"1、2027届获得本科及以上学历；\n2、对大模型策略、应用、医疗有浓厚的兴趣或知识储备；\n3、充满了好奇心和创新精神，愿意花时间了解前沿方法和行业进展，擅长和有良好习惯阅读最新的论文和技术报告；\n4、具有协作精神的团队成员；擅长在关注细节的同时，专注于优先目标和大局。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785737800981,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A210990A","job_id":"7669685358863485237","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}