{"code":0,"data":{"job_post_detail":{"id":"7670934932043516179","title":"安全合规工程师","description":"1、调研集团各产品存在的安全和隐私合规问题，并推动业务方整改；\n2、维护日常隐私合规监控体系，定期统计分析各项隐私合规运营指标；\n3、参与各类安全与隐私合规认证项目（如ISO/IEC 27001、CCRC、ISO/IEC 27701等），推动集团内部各个部门产品达到认证要求；\n4、解决集团各部门安全与隐私需求，以安全与隐私视角对业务需求进行评估与审核；\n5、对接监管机构、上级部门的信息安全排查、整改工作。","requirement":"1、本科及以上，信息安全/计算机/网络/通信/电子信息等相关背景，具备网络，计算机，通信，信息安全，数据安全相关技术基本理论基础，对网络安全，信息安全，数据安全风险和防护措施有探索和钻研精神；\n2、知晓网络安全和数据隐私相关的法律法规，了解国际和国内安全标准；\n3、具备较强的人际交往和沟通能力，擅长跨部门合作及内外部协调，责任心强，工作态度积极主动；\n4、具有信息安全背景优先，具有手机厂商，互联网合规/检测机构实习经验优先；\n5、有安全合规经验者优先，如ISO27001、隐私相关标准认证等，持有CISA、CISSP、CIPP相关资质证书的优先。","city_info":{"code":"CT_163","name":"新加坡","en_name":"Singapore","i18n_name":"新加坡"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028800427,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670934932043385107","city_list":[{"code":"CT_163","name":"新加坡","en_name":"Singapore","location_type":3,"i18n_name":"新加坡","py_name":"xinjiapo","mdm_code":"MDCY00004467","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_del