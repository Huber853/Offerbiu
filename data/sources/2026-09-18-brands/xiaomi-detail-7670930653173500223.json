{"code":0,"data":{"job_post_detail":{"id":"7670930653173500223","title":"嵌入式软件研发工程师-家电","description":"1、负责产品嵌入式平台的研究，包括软件平台选型、方案制定、流程设计等；\n2、负责产品流程控制软件的产品开发维护，包括生产事故的排查解决、与供应商之间的技术协作、文档撰写；\n3、负责产品变频软件的产品开发维护，包括生产事故的排查解决、与供应商之间的技术协作、文档撰写、电机测试等；\n4、研究产品嵌入式软件前沿技术和竞品分析，进行技术创新。","requirement":"1、硕士及以上学历，计算机、自动化、电气工程、电机控制、数学等相关专业；\n2、熟练使用至少一种编程语言（如C、Java、Python等编程语言），有嵌入式平台开发经验值者优先；\n3、熟悉驱动模型，熟悉以下一种或几种IIC，SPI，USB，PCIe，UART等总线驱动；熟悉Timer，IPC，PMIC等驱动；\n4、熟悉自动控制原理、PID控制原理、电力电子技术、永磁同步电机控制理论者优先；\n5、具备较强的自驱力、学习能力、抗压能力和团队协作能力、沟通能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027904996,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670930653173336383","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","p