{"code":0,"data":{"job_post_detail":{"id":"7665568162248788229","title":"客户端开发工程师 - 中国交易与广告","description":"团队介绍：中国交易与广告，负责抖音电商、生活服务、广告营销等营收业务的研发。用技术带来美好生活，让用户发现更多优价好物，为用户提供更丰富独特的生活体验；连接海量用户与商家，促进交易达成，让生态里全流程体验更流畅，助力营收业务长效增长。\n加入团队，你将投身流量与增长主战场，挑战复杂业务场景技术难题；直面真实商家和用户，用技术解决看得见的问题，在实战中快速成长，书写属于你的价值故事！\n\n1、负责电商业务相关产品迭代改进及移动新产品的开发；\n2、参与APP性能、体验优化及质量监控评估体系建设；\n3、参与客户端基础组件及架构设计，推进研发效率；\n4、参与Hybrid容器搭建，组件化、Flutter等跨平台\u0026动态化技术调研。","requirement":"1、2027届获得本科及以上学历，计算机相关专业；\n2、热爱计算机科学和互联网技术，对移动产品有浓厚兴趣；\n3、扎实的数据结构和算法基础，熟练掌握至少一门编程语言（包括但不限于：Java、Kotlin、Objective-C、Swift、C、C++、JS、Python）；\n4、关注用户体验，能够积极把技术转化到用户体验改进上；\n5、对新技术保持热情，具备良好的分析、解决问题的能力。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784779260080,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A226401B","job_id":"7665568162013825333","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correla