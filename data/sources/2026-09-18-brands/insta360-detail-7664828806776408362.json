{"code":0,"data":{"job_post_detail":{"id":"7664828806776408362","title":"海外销售专员-2027校招","description":"1、负责市场渠道建设和管理，与垂直渠道/零售KA体系/渠道代理商、经销商制定可行的销售方案，灵活谈判，做好区域sell-in，sell-out管理，对相应的销售考核指标及经营指标负责；\n2、挖掘市场机会点，开展新客户开发和签约工作，管理客户关系，处理与客户之间的日常沟通，满足客户需求同时贯彻我方策略，培育市场，拉动销售；\n3、做好零售下沉和展陈管理工作，持续推动零售终端覆盖率提高，零售展陈入店增加\u0026日常维护，做好在当地市场的产品和品牌本地化宣传；\n4、收集行业及市场信息，为制定\u0026调整销售\u0026市场战略提供信息输入；\n5、不定期参加海外市场展会，海外客户拜访等。","requirement":"1、本科及以上学历，专业不限； \n2、英语流利，额外掌握一门小语种非常加分（如意大利语/西语/德语/阿拉伯语/日语/韩语等）； \n3、有敏锐的市场洞察力，对市场机会点的识别有准确的判断力； \n4、具有出色的沟通能力，项目管理能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784607118967,"channel_online_status":1,"job_id":"7664828806776195370","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}