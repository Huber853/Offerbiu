{"code":0,"data":{"job_post_detail":{"id":"7670923558532794643","title":"开发者运营","description":"1、围绕小米生态平台，负责生态内合作伙伴的引入、洽谈、维系；\n2、赋能合作伙伴，协助其快速熟悉、了解、接入合作Hyper OS系统与生态；\n3、挖掘合作伙伴需求，为系统和平台能力提供场景需求，推动系统和平台能力的建设；\n4、负责平台活动和运营，举办开发者活动、平台宣传，负责开发者官网服务模块的搭建、运维；\n5、针对关键课题、关键伙伴，设计专项策略和创新模式，负责生态伙伴合作项目的运作管理和推进落地；\n6、负责开发者的应用体验管理，与技术团队协作，建立和维护应用体验标准与流程，保障在不同设备、系统与网络环境下稳定运行；\n7、对开发者关系进行维护，提供专业的咨询和指导服务，了解开发者在平台经营的需求鱼困难并推动解决，提升开发者满意度和配合度。","requirement":"1、本科及以上学历；\n2、了解常见互联网产品的运营模式；\n3、对产品和服务有一定分析能力，对场景卖点提炼具备洞察力；\n4、有较强的策划能力，出色的项目规划和执行能力，良好的沟通表达能力；\n5、有互联网公司实习经验者优先。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026148056,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670923558532614419","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_ty