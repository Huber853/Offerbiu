{"code":0,"data":{"job_post_detail":{"id":"7667961040244869429","title":"AI浏览器客户端工程师 - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、负责Web引擎及客户端基础能力的研发、维护与持续优化，为公司各业务线提供稳定、高效的Web技术底座；\n2、参与XR、AI等新硬件的Web引擎建设，与OS、图形等团队协作，推进Web渲染架构重构、性能优化及Web3D/XR新能力落地；\n3、探索AI浏览器及AI web内容生成等前沿方向，推动Web、AI与空间计算技术融合；\n4、参与图文、音频、视频等多模态数据抓取引擎和处理系统建设，为公司AI大模型训练提供数据抓取服务。","requirement":"1、2027届获得本科及以上学历；\n2、熟悉C/C++，具备扎实的数据结构、算法基础；具备良好的工程实践能力，善于使用AI编程工具；\n3、对Web引擎、2d图形渲染、XR、AI或多模态数据处理中的一个或多个方向感兴趣；\n4、具备较强的学习能力、问题分析能力和沟通协作能力，能够将技术方案落地；\n5、具备Chromium、CEF、Electron、WebView、WebGL/WebGPU、3D/XR、爬虫或音视频处理经验者优先；\n6、有AI Agent、智能浏览器、个人技术项目、开源贡献或竞赛经历者优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785337032053,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A50333","job_id":"7667962656661506309","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"