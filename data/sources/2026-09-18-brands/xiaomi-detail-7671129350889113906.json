{"code":0,"data":{"job_post_detail":{"id":"7671129350889113906","title":"芯片硬件工程师","description":"1.基于手机和车的应用场景，负责SOC芯片平台的硬件系统方案设计； \n2.负责SOC和电源芯片的IO定义，pinmap定义，PCB堆叠评估，电源完整性和信号完整性仿真分析； \n3.负责SOC外围配套电源管理/充电等芯片的详细规格定义； \n4.负责SOC芯片的通用开发平台单板以及电源套片等单元测试平台单板的设计和开发交付，硬件参考设计文档的撰写和交付； \n5.SOC芯片平台的产品化过程问题定位和解决，协助手机和车的成功量产。","requirement":"1.硕士研究生及以上学历，电子/电气/自动化/电磁/集成电路相关专业背景； \n2.电路分析/模电/数电等基础学科扎实； \n3.熟悉各类电源（buck，boost，LDO，chargepump）的基础原理和工作特性 \n4.熟悉各类常见的硬件接口，能进行总线行为分析（UART，I2C，SPI，DDR）； \n5.能理解信号完整性和电源完整性理论的核心重点，能分析和解决信号完整性和电源完整性问题为加分项； \n6.具备信号链相关的知识（AD/DA，高速接口）为加分项； \n7.熟练使用EDA软件绘制原理图和PCB； \n8.了解PCBA的生产工艺和流程。","city_info":{"code":"CT_155","name":"西安","en_name":"Xi'an","i18n_name":"西安"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786074023025,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671129350888933682","city_list":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_lis