{"code":0,"data":{"job_post_detail":{"id":"7657144041779611910","title":"嵌入式工程师-电池（AG）-2027校招","description":"1、参与产品的电池管理系统(BMS)固件开发及产品固件维护；\n2、负责固件的自测,配合硬件、算法、测试团队进行软硬件联调、问题定位与性能优化；\n3、参与BMS固件公版平台的开发与维护；\n4、配合产线生产开发产测固件，产测功能接口，输出软件设计文档，接口文档等技术方案文档。","requirement":"1、本科及以上学历，电子/通信/电气/自动化/计算机类相关专业；\n2、精通C/C++语言，具有良好的代码编写习惯，有Linux、主流RTOS开发经验；\n3、了解基本电子元器件的工作原理，了解单片机GPIO，ADC，PWM等外设的工作原理，熟练掌握IIC、UART、SPI等通信协议的时序及工作原理；\n4、至少掌握一种编程工具，具备AI辅助编程的经验；\n5、善于沟通，有较强的责任感和自驱力，良好的团队合作精神及较强的抗压能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782818029749,"channel_online_status":1,"job_id":"7657144041779464454","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}