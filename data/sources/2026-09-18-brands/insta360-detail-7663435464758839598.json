{"code":0,"data":{"job_post_detail":{"id":"7663435464758839598","title":"认证工程师-2027校招","description":"1、协助完成公司产品各项国内外认证申请、测试跟进及资料准备工作，包括但不限于 CE、FCC、IC、CCC、SRRC、BIS、MIC、KC认证等；\n2、跟踪认证项目进度，与国内外认证实验室、认证机构及供应商保持高效沟通，及时解决认证过程中出现的问题；\n3、负责认证资料的整理与编制，包括技术文件、符合性声明、产品标签及用户手册等；\n4、协助建立和维护认证知识库、标准流程及测试规范，为团队提供可复用的认证资源。","requirement":"1、熟练使用办公软件（飞书多维表格、Excel、Word、PowerPoint、Claude Code、Codex），有较强的数据处理和文档编写能力者优先；\n2、对电子产品认证、法规标准或产品测试领域有浓厚兴趣，有相关实习或项目经验者优先；\n3、英语读写能力良好，能够熟练阅读英文技术标准、测试报告及认证文件；\n4、具备良好的沟通表达能力和团队协作精神，积极主动，责任心强；\n5、注重细节，具有较强的逻辑思维能力和资料整理、分析、归档能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784282938393,"channel_online_status":1,"job_id":"7663435464758675758","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}