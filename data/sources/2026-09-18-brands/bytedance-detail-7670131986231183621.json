{"code":0,"data":{"job_post_detail":{"id":"7670131986231183621","title":"主播策略运营 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、对主播进行用户画像分析，制定运营策略，解决不同层级主播痛点；\n2、沉淀主播运营方法论，制定精细化运营方案，为开播、看播、营收提升等业务指标负责；\n3、结合用户需求建立问题暴露机制、监控主播风险，输出优化方案；\n4、运用数据分析工具，监测主播行为和直播互动效果，根据数据调整策略、优化内容，并拆解定制目标。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、具备较强的执行能力、沟通能力及服务意识；\n3、思维逻辑清晰，具备良好的自主学习、自我驱动能力，主动性与责任心强；\n4、能够熟练使用各类办公软件；\n5、热爱直播、熟悉直播产品者优先。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785841875998,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A189225","job_id":"7670131258567788853","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"