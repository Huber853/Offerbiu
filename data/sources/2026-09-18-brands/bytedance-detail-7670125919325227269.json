{"code":0,"data":{"job_post_detail":{"id":"7670125919325227269","title":"产品经理 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、负责抖音用户体验与服务的产品建设与迭代，提供体验问题发现、分析和处置、服务工具等相关的产品解决方案，并对所负责模块的最终指标负责；\n2、基于数据、内外部调研和产品思考，站在业务视角深度洞察痛点和需求，诊断问题并给出系统性的解决方案，并落地成产品能力；\n3、跨团队沟通协作，推进项目在业务侧实施落地，监控业务核心数据指标，提出优化建议，牵引运营团队优化服务策略，以产品视角驱动改进业务流程。","requirement":"1、2027届获得本科及以上学历，计算机相关专业优先；\n2、逻辑思维好，擅长问题的分析、拆解、归纳；\n3、有良好的书面和口头表达能力，具备良好的沟通与团队协同意识，能有效推进跨团队合作；\n4、具备强烈的好奇心、同理心，具有换位思考的意识和能力，有韧性、有上进心。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785840560393,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A113914","job_id":"7670125701729405189","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":