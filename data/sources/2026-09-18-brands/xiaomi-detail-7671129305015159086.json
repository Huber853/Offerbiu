{"code":0,"data":{"job_post_detail":{"id":"7671129305015159086","title":"芯片DFT设计工程师","description":"1.完成SOC芯片DFT设计工作，Bist，Jtag，Scan，ATPG等；\r\n2.完成DFT方案，设计，仿真，时序分析等；\r\n3.负责芯片投片前各项signoff检查；\r\n4.参与先进工艺的导入，诊断良率问题，催熟工艺达成量产目标。","requirement":"1.微电子.计算机等相关专业，硕士及以上学历；\r\n2.具有扎实的数字电路理论基础，熟悉数字电路IC设计流程；\r\n3.掌握Verilog语言，静态时序分析概念清晰；\r\n4.熟悉DFT相关EDA工具（如Mentor/Synopsys）；\r\n5.熟悉脚本语言，tcl，perl，或python；\r\n6.具有良好的沟通与组织协调能力。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786073995792,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671129305015011630","city_list":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_155","name":"西安","en_name":"Xi'a