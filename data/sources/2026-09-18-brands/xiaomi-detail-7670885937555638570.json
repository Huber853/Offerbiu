{"code":0,"data":{"job_post_detail":{"id":"7670885937555638570","title":"零售主管-俄语","description":"1、沟通协调资源，参与制定手机产品零售策略和发展规划，对接产品、市场等相关部门，根据新品上市节奏、产品卖点、竞品分析等输出零售侧新品上市策略及方案；\n2、根据公司的相关制度要求，正确分配零售月度，季度，年度预算；实时追踪零售预算使用进度并定期反馈分客户，分投入类型的预算使用，为业务的费用投入提出指导性建议；\n3、了解行业动态，不断调整和优化产品上市方案及运营策略，定期收集竞争对手情况，从产品和零售角度进行分析并提出应对策略；\n4、参与反馈每周、月，季度零售重要要素（产品销量，阵地运营）的进展评审，根据各要素目标，拉通各项指标的达成情况。","requirement":"1、具备良好的运营规划的能力，能够制定和把握零售上市的整体节奏和方向；\n2、熟练使用office软件，具备良好的数字分析能力及数字敏感度；\n3、具有较强的学习能力和跨部门跨国家沟通能力，具有团队意识，善于交流；\n4、结果导向，细节导向，有韧性和多任务处理能力；\n5、良好俄语能力，兼具英语者优先考虑。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017485158,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879437933","name":"销售类","en_name":"Sales","i18n_name":"销售类"},"job_id":"7670885937555474730","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":