{"code":0,"data":{"job_post_detail":{"id":"7670885167280900393","title":"客户端工程师","description":"1、参与 AI 多模态应用客户端长期架构建设，优化架构设计以提升整体迭代效率与运行性能；\n2、参与客户端架构升级，设计适配大模型、多模态算法高速迭代的技术方案；\n3、负责基于 Flutter 的跨平台（Android/iOS）核心功能开发，攻克音视频、多媒体处理等关键技术难点；\n4、协同服务端、算法策略团队完成联调适配，保障客户端功能落地质量与用户交互体验。\n\n\n \n","requirement":"1、计算机软件相关专业本科或以上学历，有创业经验优先；\n2、精通 Flutter 框架，熟练使用 Dart 语言，深入理解 Flutter 原理；\n3、熟悉 Android 和 iOS 原生开发，具备独立处理平台相关功能（如原生混编、性能调优）的能力；\n4、具备扎实的计算机基础、数据结构和常用算法知识；\n5、熟练掌握设计模式，拥有分析源码解决问题的能力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017289824,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670885167280703785","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"