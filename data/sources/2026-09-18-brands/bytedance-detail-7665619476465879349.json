{"code":0,"data":{"job_post_detail":{"id":"7665619476465879349","title":"AI量子化学研究员 - AI for Science","description":"团队介绍：AI for Science 团队专注于科学计算与物质发现领域的前瞻技术探索，围绕生物和材料领域基础模型、量子化学、AI分子动力学、高通量实验技术等方向，用 AI 推动科学领域的研究范式突破，也在实际应用场景中创造价值。我们希望用 AI 赋能科学，探索 AI 在科研领域的变革，拓展人类认知边界！\n\n1、从事机器学习与科学计算的交叉研究，重点推动机器学习方法在量子物理、量子化学等领域的应用；\n2、研发面向大规模科学计算的高性能数值算法、模拟方法及相关软件。","requirement":"1、2027届获得博士学位，计算机科学、机器学习、物理、化学、数学等相关专业优先；\n2、具备扎实的数学基础和良好的编程能力（包括AI辅助开发），能够高质量完成算法开发、实验验证及问题分析；\n3、熟练应用最新的AI工具，将其有效融入科研、编程及日常工作流程，提升研发效率和工作质量；\n4、具有独立研究和创新的才能，能够在跨学科的环境中成长。","job_category":{"id":"6704215956018694411","name":"算法","en_name":"Algorithm","i18n_name":"算法","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784791421365,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A80982B","job_id":"7663686312038074677","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[