{"code":0,"data":{"job_post_detail":{"id":"7667551288914282757","title":"独立端产品运营 - 抖音社交与互动","description":"团队介绍：抖音社交与互动团队服务于抖音连接人与人的愿景，希望为用户提供更好的社交、创作体验，以拓宽抖音的使用场景，成为更多人打开和使用抖音的新理由，提升抖音的用户规模。我们是一支有朝气、背景多元的团队，致力为用户提供最佳的产品体验，热衷听取用户声音和反馈，也运用科学严谨的分析方法，仔细衡量我们的工作成果。抖音社交与互动欢迎你的加入，和我们一起做有挑战的事情。\n\n1、协助独立端活动开展跨团队沟通协作，例如与设计、研发及产品团队协作；\n2、独立负责大型活动中一个模块的具体交付，例如整体设计风格交付或用户侧需求交付；\n3、应对多线程任务，能够快速理解AI相关功能模块并推进落地。","requirement":"1、2027届获得本科及以上学历；\n2、有较强的沟通能力，能够进行跨团队的良好沟通，对于AI相关的功能有自己了解和研究，对于AIGC生图，Prompt书写等情况有基础认知；\n3、在AI相关的行业实习过，了解行业情况，并且对于活动运营有基础的能力；\n4、对新知识学习能力强，对创新有自己的想法。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785241003203,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A80666","job_id":"7667551186825185589","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深