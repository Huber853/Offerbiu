{"code":0,"data":{"job_post_detail":{"id":"7670893035149052211","title":"嵌入式软件研发工程师","description":"1、负责操作系统相关的研发工作。包括但不限于如下系统模块：图形渲染、相机、音视频、显示、智能计算、驱动框架等； \n2、负责SOC的多媒体相关方案设计以及开发工作；\n3、负责Android相关的图形、显示、视频驱动开发和维护，以及游戏渲染的优化工作，对接三方应用，深度开发优化方案；\n4、负责Android相关的AI、相机驱动开发，以及相机相关的前后处理算法开发，大模型算法的研究优化；\n5、负责Android Hal和Android framework层开发和设计工作，负责MediaServer、SurfaceFlinger等模块；\n6、负责新技术的预研和产品实现，创造性解决产品在实现过程中的技术难题，应用前沿技术(如AI技术等)提升产品的核心竞争力。","requirement":"1、计算机、软件、电子、通信、信息安全等相关专业本科及以上学历；\n2、具备较强的学习能力，良好的沟通力和执行力；\n3、熟练使用C/C++语言；熟悉JAVA/python等；熟悉操作系统原理；\n4、有AI、信号处理、系统安全、嵌入式软件开发经验者优先；\n5、有开源社区经验，ACM比赛经历者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786019024462,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670893035148888371","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectabili