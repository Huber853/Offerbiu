{"code":0,"data":{"job_post_detail":{"id":"7663789547784587583","title":"雇主品牌专员-2027校招","description":"1、策划与执行校园招聘活动：参与宣讲会、招聘会等线下活动的全流程策划与执行；\n2、负责活动全周期内容策划和宣发，擅长多种形式内容输出与制作；\n3、负责雇主品牌新媒体账号的日常运营，完成内容发布、用户互动、数据监测，结合热点优化内容方向，提升账号传播力；\n4、负责宣传物料的设计制作，运用 AIGC、设计软件，创造出优质内容或爆款视频。","requirement":"1、2027届及以后毕业的高校在校生，市场营销、新闻传播、中文等相关专业优先；\n2、网感突出，有优秀的文案创作与内容策划能力，有自媒体、公众号、小红书等平台运营经验者优先；\n3、具备AIGC创作能力，熟练使用AI创作工具，会使用图片编辑软件和视频剪辑软件者优先；\n4、细心耐心，逻辑清晰，具备优秀的数据统筹与成果展示能力，能独立完成数据整理与报告输出；\n5、有校园活动宣传、内容创作、赛事运营相关经历者优先，投递请附上过往作品集（文案、设计、运营数据成果均可，作品集为核心评估项）。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784366282807,"channel_online_status":1,"job_id":"7663789547784440127","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}