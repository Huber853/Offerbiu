{"code":0,"data":{"job_post_detail":{"id":"7670910761502148890","title":"短距通信测试开发工程师","description":"岗位描述：\n1、负责参与解决方案产品中短距通信组件的测试执行，测试用例编写及评审；\n2、负责测试环境的搭建、针对业务产品进行功能和非功能测试；\n3、需要与芯片/软件/硬件上下游团队开展深入合作交流，进行问题的调试和分析；\n4、对芯片/软件问题进行跟踪分析和报告，推动问题及时合理地解决；\n5、汇总测试执行情况，编写各阶段测试报告； \n6、跟进协议演进，参与新协议测试分析及交付件落地","requirement":"1、本科及以上学历，电子，通信，计算机等相关专业毕业生，具备无线通信相关专业知识；\n2、熟悉通信原理，信号系统，了解OFDM , MIMO等基础知识；\n3、有一定的编程基础和脚本开发能力；\n4、工作认真踏实，有良好的学习和沟通协调能力，以及团队合作精神。","city_info":{"code":"CT_155","name":"西安","en_name":"Xi'an","i18n_name":"西安"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786023093597,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7670910761501968666","city_list":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1}],"tag_list":[],"storefront_mode":1,"