{"code":0,"data":{"job_post_detail":{"id":"7670918704973334822","title":"设计传播专员-汽车","description":"1、协助设计团队的传播工作，提升设计团队知名度、国际化影响力，以及进行品牌设计形象正面推广；\n 2、协助设计传播活动的包装、策划，进行活动启动至执行落地的全流程管理。与市场、销售、公关、人力等部门协作，确保设计传播工作资源的合理分配和有效利用，实现工作目标，活动不限于校企合作、设计大赛、策展、行业峰会等；\n3、协同品牌公关团队输出设计物料、发布及传播工作； \n4、协助设计团队新媒体运营工作，运营微信公众号、小红书、抖音等自媒体，策划与输出优质、有高度传播性的设计传播内容； \n5、与学术界、媒体届友好积极配合，确保设计传播相关项目能够顺利推进；\n6、具备优秀的平面设计能力。","requirement":"1、本科及以上学历，专业覆盖工业设计、视觉设计、市场营销、广告传媒、影视等相关专业； 2、具备开阔的视野、创新的思维，以及团队协作能力、组织管理能力；\n3、具备优秀的沟通表达能力、英文沟通能力、逻辑思考能力、资源整合协调能力；\n4、具有大型设计传播工作的策划、执行经验、具有新媒体账号运营经验。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025080090,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051890796","name":"市场类","en_name":"Marketing","i18n_name":"市场类"},"job_id":"7670918704973170982","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location