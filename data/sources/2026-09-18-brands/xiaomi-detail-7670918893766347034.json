{"code":0,"data":{"job_post_detail":{"id":"7670918893766347034","title":"电子料SIE工程师-汽车","description":"1、参与供应商的针对相关零件的APQP评估工作；\n2、参与识别相关零件的关键特性或特殊特性，确保零件的产品及过程管理有效性；\n3、参与供应商及相关零部件的选择及评审，并从技术，质量及可靠性进行评估；\n4、针对已失效或潜在失效问题，参与供应商端的失效分析，支持推进供应商进行落地改善，直至问题关闭；\n5、参与薄弱供应商或零部件的质量改善活动并确保改善效果及风险遏制；\n6、参与供应商端产品，过程及体系审核并跟进闭环；\n7、定期开展供应商改进工作的有效性评估及优化；\n8、参与或主导相关零部件的评审，确保变更风险受控；\n9、参与制定并持续优化供应商及相关零部件的管理流程文件。","requirement":"1、电子科学与技术，微电子，材料科学与工程，物理学等相关领域本科或以上学历；\n2、具备半导体物理，半导体工艺，集成电路制造等基本知识；\n3、了解SPC，FMEA，MSA，APQP，PPAP等工具，了解IATF16949，ISO9001等标准；\n4、能熟练运用办公及数据分析软件，并可以独立完成数据处理及分析，图表/PPT制作等；\n5、具备良好的英语听说读写能力，学习力，沟通协调能力及逻辑分析能力；\n6、具备较强的主动能力，责任心及团队合作能力。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025146629,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670918893766166810","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id