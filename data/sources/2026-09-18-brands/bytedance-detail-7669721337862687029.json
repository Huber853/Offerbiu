{"code":0,"data":{"job_post_detail":{"id":"7669721337862687029","title":"游戏场景原画设计师 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、根据项目现有美术风格，独立设计场景生态环境、科幻场景建筑及相关组件；\n2、在既有的资产条件下，产出相关组件、生态环境或科幻建筑的气氛图；\n3、配合上下游部门，根据引擎内场景表现进行画面效果的优化与迭代。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有写实科幻类场景相关设计作品，在此基础上另有生态环境作品者优先；对镜头选择、光影处理有审美能力；对生态地质地形或科幻建筑设计有一定的知识储备；\n3、熟练掌握Blender，Photoshop软件，使用3D前期+2D后期的流程；\n4、热爱游戏行业，了解3A游戏制作流程，具备良好的沟通协作能力与团队意识。","job_category":{"id":"6850051246036879630","name":"游戏美术","en_name":"Game Art","i18n_name":"游戏美术","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746156294,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A173092","job_id":"7660726586710804741","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","n