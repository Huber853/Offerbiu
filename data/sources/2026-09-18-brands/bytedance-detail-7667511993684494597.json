{"code":0,"data":{"job_post_detail":{"id":"7667511993684494597","title":"威胁情报运营工程师 - 安全与风控","description":"团队介绍：我们通过部署先进的安全系统、推行标准化操作流程，构建基于零信任的安全防护体系，提升字节跳动全球办公环境的整体安全态势。我们坚持以主动预防为核心，同时构建敏捷高效的安全响应能力，为全球办公环境提供持续、可靠的安全保障。\n\n1、负责对黑灰产情报线索进行打标和线索的初步研判；\n2、负责对部分场景的情报线索进行覆盖和准确率提升；\n3、负责黑灰产情报的调查和研究，并持续跟进黑灰产上下游链条的逻辑和技术。","requirement":"1、2027届获得本科及以上学历，信息安全、计算机科学等相关专业优先；\n2、考虑问题富有前瞻性，逻辑思维强，具备分析复杂问题的能力，有黑灰产运营经验的优先；\n3、对各类业务风险敏锐感知，有深入挖掘的精神，具备风险情报收集能力和数据分析能力，有大数据处理相关工作经验优先；\n4、思路清晰，善于主动思考，有创新、能独立分析和解决问题，拥有强烈的责任心和团队合作精神，出色的学习能力。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785231779517,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A192958","job_id":"7667511610208028933","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list