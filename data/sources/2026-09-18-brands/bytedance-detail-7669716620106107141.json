{"code":0,"data":{"job_post_detail":{"id":"7669716620106107141","title":"游戏关卡策划（搜打撤） - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、负责设计并跟进制作游戏中的关卡场景；\n2、负责设计并跟进制作游戏中关卡所需的各种功能机制；\n3、负责设计并跟进制作游戏中的各种关卡玩法；\n4、负责设计并跟进制作关卡相关的一些系统功能。","requirement":"1、2027届获得本科及以上学历；\n2、逻辑思维能力强，有优秀的文字和语言沟通表达能力；\n3、有优秀的空间想象能力，能使用软件搭建关卡白模；\n4、动手能力强，能独自设计并验证玩法原型；\n5、了解市面上各种主流的3D游戏关卡和地图设计思路，能分析推导市场游戏系统的核心设计思路和方法论；\n6、游戏面广泛，熟悉主机游戏，对市面上主流动作类游戏和竞技类游戏都有所涉猎，相关游戏水平较高的优先。","job_category":{"id":"6850051245139298567","name":"游戏系统策划","en_name":"Game System","i18n_name":"游戏系统策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745075022,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A158527","job_id":"7667108078810761477","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[