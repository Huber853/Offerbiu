{"code":0,"data":{"job_post_detail":{"id":"7669693155660417285","title":"活动运营 - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、参与爆款作品打造，通过精准的内容亮点提炼，挖掘并推广番茄小说潜力爆款书；\n2、理解用户和内容，通过策划和落地好玩的互动活动、推书活动、端外营销事件等，打造爆款作品；\n3、负责活动全链路监控与分析，联动作者及上下游团队，结合读者偏好及品类趋势，进行活动基建优化。","requirement":"1、2027届获得本科及以上学历；\n2、有丰富的实习经历，熟悉网文行业者或有丰富网文阅读经验者优先；\n3、执行力强、可独立开展运营活动，善于思考，有用户视角，具备严谨的工作态度；\n4、有基本的数据能力和策略能力，善于通过数据洞察发掘分析，有SQL基础优先。","job_category":{"id":"6704215961064442123","name":"内容运营","en_name":"Content ops","i18n_name":"内容运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785739666314,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A71997","job_id":"7668204752140290357","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_f