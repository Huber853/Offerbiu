{"code":0,"data":{"job_post_detail":{"id":"7665570008453597493","title":"安全工程师（电商商家） - 中国交易与广告","description":"团队介绍：中国交易与广告，负责抖音电商、生活服务、广告营销等营收业务的研发。用技术带来美好生活，让用户发现更多优价好物，为用户提供更丰富独特的生活体验；连接海量用户与商家，促进交易达成，让生态里全流程体验更流畅，助力营收业务长效增长。\n加入团队，你将投身流量与增长主战场，挑战复杂业务场景技术难题；直面真实商家和用户，用技术解决看得见的问题，在实战中快速成长，书写属于你的价值故事！\n\n1、参与电商安全防御实战及红蓝对抗演练项目；\n2、有效对接安全研发团队，将前沿攻防经验沉淀为产品/工具等自动化服务模块；\n3、研究并跟进最新的安全漏洞与安全动态，并能够分析定性对电商业务的实际影响。","requirement":"1、2027届获得本科及以上学历，计算机相关专业；\n2、有过作为一线技术成员深度参与攻防赛事的经验，熟悉当下攻防流行的各类漏洞的原理及利用；\n3、熟悉Java漏洞挖掘及利用，挖掘过国内外常见的Java项目；\n4、熟悉开发测试流程，熟练掌握Go/Python，具备扎实的开发技能基础，熟悉常用的开发协作流程者优先；\n5、具有自我思考和理解能力，能够独立分析问题及提出解决方案；\n6、善于跨团队沟通和协调，具备良好的团队意识和自驱力。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784779606686,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A255363","job_id":"7665569666542930229","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlati