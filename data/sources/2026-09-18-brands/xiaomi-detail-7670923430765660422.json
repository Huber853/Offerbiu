{"code":0,"data":{"job_post_detail":{"id":"7670923430765660422","title":"运维工程师","description":"1.负责跟踪业务系统的用户反馈，针对反馈分析提炼,推动系统改进和相关需求落地；\n2.能结合业务场景设计用户调研方案推动提升系统质量，提升用户满意度； \n3.通过梳理系统的流程和功能，发现用户痛点，提出相关业务解决方案或技术产品需求；\n4.能够根据症状标签和故障原因制定自研系统的改善计划并推动改进；\n5.有质量地完成问题知识库周月复盘、月度总结分析等知识管理的工作。","requirement":"1.本科及以上学历，计算机，供应链，系统工程，统计学，数学等相关专业优先；\n2.能够与业务、产品、和技术研发进行有效地沟通并有一定的持续跟进能力； \n3.具备良好的责任心和团队协作意识、较强的学习意愿； \n4.具有良好的心态，有正确的职业观，耐心细致，有责任心，工作勤奋，善于思考问题，有时间观念，独立性强，具有团队合作精神。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026170679,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761246949179500","name":"运维类","en_name":"Maintenance","i18n_name":"运维类"},"job_id":"7670923430750341382","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"tag_list