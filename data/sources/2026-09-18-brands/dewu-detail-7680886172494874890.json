{"code":0,"data":{"job_post_detail":{"id":"7680886172494874890","title":"【27届校招】用户产品经理","description":"1. 负责得物App用户端核心产品功能的设计与迭代，持续提升用户体验与转化；\n2. 深入洞察年轻用户的需求与行为，通过用户调研、数据分析、竞品分析等方式发现产品机会与体验优化点；\n3. 撰写高质量产品需求文档（PRD），协同设计、研发、测试等团队推进功能落地，并对上线效果负责；\n4. 跟踪核心产品指标（留存、转化、使用时长、满意度等），以数据驱动产品决策与迭代；\n5. 关注行业趋势与年轻用户消费习惯变化，探索创新的产品形态与互动方式。","requirement":"1. 2027届毕业生，本科及以上学历，专业不限，计算机、心理学、工业设计、市场营销等相关专业优先；\n2. 互联网产品的重度用户，对电商或社区类产品有深入理解和个人思考，有产品实习经验者优先；\n3. 具备较强的逻辑思维和数据分析能力，能用数据支撑产品决策；\n4. 具备优秀的用户同理心，能从年轻用户视角思考问题，注重体验细节；\n5. 具备较强的自驱力、沟通协调能力和项目推动力，能在快节奏环境中高效协作。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788345897383,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287149935865874725","name":"产品类","i18n_name":"产品类"},"job_id":"7680885492381387046","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_