{"code":0,"data":{"job_post_detail":{"id":"7670885367776725286","title":"产品技术工程师","description":"岗位描述：\n1、产品在服务端产生的质量问题预警及推进改善；\n2、参与编写产品技术知识与文档，参与一线服务人员技能培训，保障一线人员技术服务能力；\n3、服务工治具的创新及优化，提高服务人员解决问题能力；\n4、负责项目功能测试、外观标准、BOM组合方案、故障代码等资料撰写与运营；\n5、负责服务不良物料分析、产品类技术升级鉴定，协助处理解决紧急突发事件。","requirement":"1、对技术问题及科技类产品功能特性有兴趣，具备基础问题的拆解判断及分析能力；\n2、良好的逻辑思维能力，良好的文字语言分析和理解能力；\n3、熟悉Excel报表及PPT的制作；\n4、对行业动态敏感，具备良好的职业素养与职业道德，敬业诚信、严谨务实；\n5、拥有良好的跨部门沟通能力与积极学习的心态，工作耐心、细致；\n6、本科及以上学历，计算机系统架构、数据分析等相关专业优先。\n\n加分项\n1、对手机/电视/笔记本/大家电/小家电/智能设备等任一产品线有深入了解，熟悉行业发展及技术特性、产品特性者优先；\n2、擅长数据分析，有十万级或以上数据分析项目经验者优先；\n3、有科技媒体内容运营、专栏撰写经验，或有长期更新维护技术类 博客/公众号/视频号经验者优先；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017236654,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879437933","name":"销售类","en_name":"Sales","i18n_name":"销售类"},"job_id":"7670885367776561446","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_de