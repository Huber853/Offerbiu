{"code":0,"data":{"job_post_detail":{"id":"7670918767479785778","title":"OTA测试工程师-汽车","description":"1.负责OTA的车云端到端测试，包括参与需求分析，制定测试计划与方案，定义测试策略，完成用例设计与审核，进行缺陷跟踪和软件质量分析，风险分析；\n2.负责OTA系统HIL台架/实车环境下的联调和测试工作；\n3.负责OTA的各软件基线交付质量，包括OTA功能、体验，性能和稳定性；\n4.负责开发OTA自动化测试系统与测试工具，完成测试工具的代码编写、调试、测试，协助核心零部件的OTA功能快速测试和迭代；\n5.负责定位和跟踪测试中发现的问题，对问题进行分析和解决，并进行测试结果的记录和分析；\n6.负责产品研发过程中的需求评审、设计评审和，发现潜在问题并及时反馈；","requirement":"1.本科及以上学历，通信工程、计算机,电气或者自动化等工科专业优先；\n2.具有一定的编程能力，熟悉Python，C，C++等编程语言；\n3.具备良好的沟通能力，有较强的责任心及团队合作精神；\n4.具有自驱力，善于思考和总结，有一定的突破和革新力；","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025024438,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7670918505123334409","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海"