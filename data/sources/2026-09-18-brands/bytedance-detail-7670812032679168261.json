{"code":0,"data":{"job_post_detail":{"id":"7670812032679168261","title":"平台产品运营经理 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责官网平台产品AI运营工作，深刻理解和定义行业智能化背景下用户旅程，识别瓶颈和爽点优化提升客户体验；\n2、结合最新AI和大模型技术，通过创新的模式为内外部客户提供平台官网解决方案，完成沉淀和复用、结合Agent推广；\n3、通过最新的AI工具深入分析场景，通过智能化手段沉淀问题自助和智能解决方案，进行快速和规模化闭环运营并达成业务目标。","requirement":"1、2027届获得本科及以上学历，计算机及相关专业优先；\n2、对AI和云计算业务感兴趣，具备一定的平台产品实习经验；\n3、保持好奇心，具备较好的抽象思维，善于总结、归纳和抽象。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786000157505,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A27532","job_id":"7670811547749812533","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code