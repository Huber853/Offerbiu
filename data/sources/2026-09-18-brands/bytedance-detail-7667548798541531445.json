{"code":0,"data":{"job_post_detail":{"id":"7667548798541531445","title":"战略分析师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责制定火山引擎在AI大模型领域的战略规划，包括大模型、AI应用、GPU基础设施等的AI全栈战略；\n2、追踪、分析全球大模型等领域的前沿技术趋势，研究全球顶尖的AI公司，思考、探索下一代AI产品形态与商业模式，推动业务创新；\n3、参与AI大模型相关业务的孵化与落地，支持业务落地中的行业和公司研究、目标与战略制定、产品长期演进路线讨论等；\n4、协助潜在的战略投资及生态合作项目，协调资源、推动开展外部战略合作和内部跨团队协同类项目。","requirement":"1、2027届获得硕士及以上学位，理工科/经济管理相关专业优先；\n2、对AI等新技术、新趋势有兴趣，希望在新领域探索和成长；\n3、自驱、学习能力强、较好的沟通和协作能力，具备良好的英文书面及口头表达能力；\n4、较强的逻辑思考、信息收集分析能力和认知挖掘能力，具有商业思维；\n5、在科技企业战略或投资部、咨询公司、VC/PE等有丰富的实习经验。","job_category":{"id":"6704215882438019342","name":"商业运营","en_name":"Commerce ops","i18n_name":"商业运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785240570237,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A82470","job_id":"7667548299126622469","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"