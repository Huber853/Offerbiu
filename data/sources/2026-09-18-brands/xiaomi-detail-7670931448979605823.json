{"code":0,"data":{"job_post_detail":{"id":"7670931448979605823","title":"PACK电气工程师-汽车","description":"1.负责动力电池电气开发技术路线, 及前沿技术和先进工艺研究；\n2.负责动力电池电气需求分析（线束、CCS、汇流排、BDU等）；\n3.负责动力电池高压连接设计，低压电气设计，结构设计和方案设计；\n4.根据动力电池要求绘制电气原理图，3D数模和2D图纸，并按流程发布、上传、归档；\n5.负责对产品或零件，制定测试计划和测试策略。","requirement":"1.本科及以上学历,电气工程/自动化/机电工程/车辆工程/机械工程/控制工程/材料工程等相关专业；\n2.熟悉3D数模绘图工具，如CATIA、soliworks；\n3.具有系统工程思维，逻辑清晰，表达准确顺畅；\n4.责任心强，勤奋踏实，积极主动，有创新力，良好的沟通，团队合作能力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028076970,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670931448979441983","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京",