{"code":0,"data":{"job_post_detail":{"id":"7667877734431492357","title":"AI Agent开发工程师 - APM","description":"团队介绍：字节跳动APM(Application Performance Management) 团队负责公司所有服务端、移动端、前端、跨端产品的稳定性和性能质量监控保障，构建业界领先的可观测性基础设施，结合机器学习智能化，提供一站式平台覆盖字节跳动各业务线的排障、监控和稳定性提升等需求。\n\n1、负责字节跳动监控观测相关产品核心功能开发；\n2、打造业界领先的一站式监控、链路追踪、归因、报警、修复平台；\n3、利用最新的LLM技术，建设前沿的可观测AI Agent。","requirement":"1、2027届获得本科及以上学历，计算机、通信和电子信息科学等相关专业优先；\n2、能熟练使用一种编程语言，包括但不限于Golang/Python/Java/Rust/C++/C；\n3、熟悉使用Linux操作系统，了解存储、网络I/O等相关原理；\n4、熟悉大型分布式存储系统，比如Hive，ClickHouse，Prometheus，InfluxDB；\n5、掌握MySQL、Redis、MQ等常用存储系统的使用。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785316996188,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A139173","job_id":"7667876774607063301","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":