{"code":0,"data":{"job_post_detail":{"id":"7670931130141821247","title":"热管理软件建模工程师-汽车","description":"1.承接系统需求，进行软件模块的详细设计，完成软件需求文档\u0026软件详细设计文档；\r\n2.完成舒适性控制的simulink建模（包括HMI交互.HVAC舒适性.空气质量管理控制）；\r\n3.收集测试/台架试验/整车标定团队的问题反馈，并及时解决；\r\n4.联合测试/台架试验/整车标定团队，支持其相关工作。","requirement":"1.本科及以上学历，制冷/传热/热力/控制工程专业优先，有传热/制冷方面的背景知识；\r\n2.熟练掌握MATLABSimulink模型开发和软件开发工具链；\r\n3.熟悉C语言；\r\n4.熟悉ASPICE开发流程；\r\n5.熟悉空调热泵系统的工作原理；\r\n6.熟悉空调热管理系统各部件的结构；\r\n7.沟通技巧，团队合作精神，积极主动。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028096230,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670931130141657407","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}]