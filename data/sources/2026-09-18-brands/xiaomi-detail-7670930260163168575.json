{"code":0,"data":{"job_post_detail":{"id":"7670930260163168575","title":"软件测试工程师","description":"1、负责相关平台的测试工作，制定项目测试方案，计划并实施，保证项目质量和进度；\n2、根据产品和项目特点，提出合理的技术解决方案，并负责设计和实现相应工具、平台，提高效率与质量；\n3、设计与执行测试用例，跟踪定位产品软件中的缺陷或问题；\n4、参与产品需求、系统设计和程序代码的评审工作，并提出改进意见；\n5、评估项目质量风险，与产品经理和开发人员就项目进度和问题进行沟通。","requirement":"1、计算机及相关专业本科以上学历；\n2、具备测试实习经验优先；\n3、自动化测试常用工具（如monkeyrunner,appium,selenium）等；\n4、掌握PHP/JAVA/C/C++或几种脚本语言如python/shell 等，能熟练编写代码；\n5、精通软件测试理论和方法，熟悉互联网行业测试环境及相关技术；\n6、熟悉Linux/Unix操作系统，或LAMP架构；\n7、善于学习和运用新知识，具有良好的分析和解决问题能力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027854695,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7670930260163004735","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"j