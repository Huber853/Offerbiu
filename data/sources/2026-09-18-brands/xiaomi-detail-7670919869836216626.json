{"code":0,"data":{"job_post_detail":{"id":"7670919869836216626","title":"内饰灯具工程师-汽车","description":"1. 负责车内部照明系统，前OHC,后阅读灯，前后行李箱照明灯具，座舱内所有氛围灯具开发工作； \n2. 负责内饰灯具零件前瞻技术的研究，照明/信号光学性能的标准制订和夜视评估等工作；\n3. 编制DV/PV试验计划，跟踪试验验证并推动问题闭环；\n4. 参与DFMEA编制与特殊特性清单梳理；\n5. 量产阶段驻厂跟进质量问题，深挖根因并推动整改；\n6. 参与供应商技术对接，跟进零件交付与EA认可；\n7. 沉淀项目经验，输出技术规范、Checklist及培训资料；","requirement":"1. 本科及以上学历，车辆工程，机械设计，材料等专业；\n2. 熟悉CATIA软件，具备一定的软件开发技能如C语言，C++等；\n3. 熟悉机械设计原理，了解车灯产品的基本结构；\n4. 喜欢有挑战性的工作，思路开阔，逻辑分析能力强；\n5. 对新能源汽车有行业看法，对汽车有热衷，有责任心，认可小米汽车；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025312544,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919869836052786","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":