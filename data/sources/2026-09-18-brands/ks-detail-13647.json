{"code":0,"message":"OK","result":{"id":13647,"code":"437c1e7b4def4a26a966c379b9a3bae9","type":"outer","hasInner":null,"positionStatusCode":"Release","recruitProjectCode":"schoolr","recruitSubProjectCode":"20271779425607","hcHoldTime":null,"name":"HR-招聘类","departmentCode":null,"departmentName":null,"businessDirectoryCode":null,"positionClassCode":"3","ifFrontLineEmployee":null,"welfareLabelCode":null,"workingHoursNature":"1001","positionNatureCode":"fulltime","positionCategoryCode":"function","positionRankCode":null,"positionLevelCode":null,"workLocationCode":null,"recruitNumber":null,"allocateResumeWeight":null,"allocateWaterLevel":null,"headCountUsed":null,"description":"在快手，AI正在进入简历搜索、渠道触达、日程协调——你要做的，是AI做不到的那部分：\n判断一份简历背后的信号；\n激活一个没打算换工作的人；\n帮业务看清他们真正需要的人，而不只是他们说想要的。\n\n【这个岗位在做什么】\n1、深度理解业务与组织需求，理解岗位背后的真实需要，帮业务看清并匹配真正需要的人才\n2、接手AI推荐的候选人，做真正意义上的判断——推进还是pass，为什么\n3、主导候选人关键节点的沟通，精细化人选吸引策略，持续提升招聘效率和人选体验\n4、持续关注行业和人才动态，为业务输出有效市场信息；\n5、观察AI在具体场景里的局限，反馈推动优化。 \n\n【为什么是快手】\n已有工具-快手的AI工具已经部署在日常工作流里，不是愿景，是现在就在跑的系统；\n你来定义-这套系统还在被定义：招聘HR能做什么、AI该做什么、边界在哪——还没有固定答案；\n亲自参与-你不是在等公司想好了再给你工具，你是参与\"AI时代招聘应该怎么做\"这个问题的回答过程。 ","positionDemand":"1、对人有真实好奇：能从对话里感知对方的动机和顾虑，去深度感受每个人的职业选择；\n2、能做模糊判断：一个人要不要，没有标准答案，你能做出判断并承担它；\n3、真正用起AI工具：从第一天上手，而不是“了解它的存在”；\n4、会质疑AI的结论：知道什么时候该信，什么时候该推翻；\n5、本科及以上，有招聘或互联网相关实习经验者优先。","smartResumeConfig":null,"enableIntelligent":null,"recruitLeaderNumber":null,"recruitLeaderName":null,"recruitLeaderUsername":null,"outRelationPositionId":null,"ifParticipateBeisen":null,"evaluateCompanyCode":null,"evaluateProjectCode":null,"writeExamType":null,"ifShowRecruitWebsite":true,"ifShowRecommendWebsite":true,"ifRecruitWebsiteHot":null,"ifRecommendWebsiteHot":null,"finalInterviewerCode":null,"auditStartUser":null,"auditStartTime":null,"positionAuditProcessId":null,"businessAuditTemplateCode":null,"auditTemplateCode":null,"offerAuditProcessId":null,"pauseTime":null,"releaseTime":"2026-08-12 21:36:09","closeTime":null,"closeUserId":null,"positionLabel":null,"updateTime":17870