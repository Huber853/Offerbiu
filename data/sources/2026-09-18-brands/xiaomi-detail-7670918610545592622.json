{"code":0,"data":{"job_post_detail":{"id":"7670918610545592622","title":"动力零部件试验验证工程师-汽车","description":"1、负责电驱/电池系统及其零部件台架测试指导书制定，包含DV/PV测试，强检试验和EOL等；\n2、负责第三方试验室能力和设备评审，指导供应商进行相关试验台架搭建，自动化测试及监控并开展试验工作；\n3、负责制定测试计划并管控测试节点保障测试进度和测试质量；\n4、负责解决试验过程中的相关问题及分析产品失效模式，与开发同事共同开展设计优化并验证。","requirement":"1、本科及以上学历，电气工程/自动控制/汽车工程/电子信息等相关专业，英语CET4；\n2、精通台架等相关测试设备，能够指导测试环境搭建，确保实验环境符合验证过程要求；\n3、能够利用相关专业软件和标定工具，进行产品测试验证及相关实验数据处理与分析，如CANoe、INCA、Python、Jbeam、Uniplot等工具；\n4、具备一定的试验问题分析能力，能够根据实验数据，针对产品设计状态进行评判以及分析失效原因；\n5、工作踏实，良好的沟通能力，具有责任感和团队奉献精神。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025059707,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670917965064653107","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,