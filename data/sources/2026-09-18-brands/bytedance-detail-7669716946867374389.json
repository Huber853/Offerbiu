{"code":0,"data":{"job_post_detail":{"id":"7669716946867374389","title":"游戏算法工程师（强化学习方向） - AIGC","description":"团队介绍：游戏-AIGC部门，致力于将生成式AI落地到游戏中，包括但不限于模型、贴图、动画、场景、剧情、对话、玩法等游戏核心元素的AI生成和AI提效。部门近几年一直在游戏AI和数字人方向持续深耕，欢迎加入我们。\n\n1、参与游戏AI Bot研发，探索AI Bot在线上商业落地价值以及游戏制作过程中的提质提效；\n2、参与游戏AI Bot训练，包括但不限于策略优化、复杂奖励设计、环境交互建模、风格化等工作；\n3、参与测试AI表现，针对游戏中的AI行为表现，分析训练数据和评估指标，优化AI训练方案；\n4、参与AI难度多样化、拟人化、平衡性测试等开发；\n5、探索AI Bot与LLM结合落地。","requirement":"1、2027届获得本科及以上学历，计算机、人工智能、自动化、软件工程、数学等相关专业优先；\n2、熟悉Python编程，具备良好的代码实现和调试能力，能够独立阅读、修改和维护工程代码；\n3、熟悉至少一种深度学习框架，如TensorFlow或PyTorch；\n4、熟悉强化学习的基本原理和常见的强化学习算法；\n5、有游戏AI、仿真环境、分布式训练、强化学习Bot工程项目经验者优先。","job_category":{"id":"6704215956018694411","name":"算法","en_name":"Algorithm","i18n_name":"算法","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745221969,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A235040C","job_id":"7662208279154870533","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag