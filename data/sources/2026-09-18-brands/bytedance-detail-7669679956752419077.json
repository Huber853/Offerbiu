{"code":0,"data":{"job_post_detail":{"id":"7669679956752419077","title":"平台产品经理 - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、建设番茄系平台产品，致力于打造大规模、高复杂度的平台产品系统，包括但不限于创作者平台、增长平台、效率平台；\n2、负责一个或者多个关键模块的优化迭代，抽象产品服务，高效沉淀平台能力；\n3、深入理解业务的实际需求与应用需求，转化为具有复用性、可用性的平台产品方案，推进高质量落地；\n4、其他服务于业务目标的相关产品工作。","requirement":"1、2027届获得本科及以上学历；\n2、善于抓本质、抽象归纳、流程优化，高效执行与落地；目标意识强，有良好的主人翁心态及同理心；\n3、沟通与协作技巧成熟，有责任心及驱动力推动项目落地；\n4、对平台产品方向有兴趣，成长意愿强。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785736711040,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A209213","job_id":"7668199897137711413","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name"