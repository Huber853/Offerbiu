{"code":0,"data":{"job_post_detail":{"id":"7670915181790447899","title":"全栈开发工程师-汽车","description":"1、参与公司核心Web产品、业务平台、后台管理系统和工具需求开发；\n2、负责前端页面开发、组件实现、交互效果落地、基础性能优化，保证代码规范、页面美观流畅；\n3、参与后端业务接口开发、数据逻辑实现、数据库读写与简单表结构设计，配合完成业务功能闭环；\n4、参与项目代码评审、技术沉淀、文档编写，持续优化代码质量与研发效率；\n5、跟进前沿开发技术，参与团队技术分享，结合业务场景学习工程化、自动化部署等能力；\n6、配合产品、设计、测试团队完成需求对接、问题修复、版本迭代，保障项目稳定交付。","requirement":"1、有计算机、软件工程、人工智能开发基础，具备AI开发基础能力；\n2、掌握Web/Java基础，熟练使用集合类，具备多线程并发编程的能力；\n3、掌握Spring，SpringBoot，SpringCloud框架，Mysql，Redis等存储中间件，熟悉消息中间件；\n4、熟练使用Git，Maven等项目管理、版本管理工具；\n5、掌握大数据生态技术栈（Spark、Flink、MQ等）；\n6、掌握基本的数仓方法论、熟悉机器学习/深度学习算法数据工程、模型开发；\n7、具备较强的学历能力、逻辑分析能力，问题排查能力。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024177292,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670915181790251291","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_