{"code":0,"data":{"job_post_detail":{"id":"7670123048703445253","title":"具身智能研发工程师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、参与具身智能研究，推动具身智能解决方案的研发落地工作，包括但不限于：多模态交互，具身大脑、Agent系统，世界模型，RL强化学习，VLA、VLN、运控等方向；\n2、参与具身智能解决方案中的软件架构设计，模型研发、数据研发、仿真评测和集成部署工作；\n3、与团队成员紧密协作，共同解决复杂的跨领域技术难题。","requirement":"1、2027届获得硕士及以上学位，计算机科学、数据工程、机器人或相关背景；\n2、精通Python/C++，具备扎实的工程能力和良好的代码习惯；\n3、有机器人系统经验者加分，你的工作将能立刻落地到真实机器人体内；\n4、对前沿技术保持好奇心与热情，愿意在具身智能领域迎接挑战、突破边界；\n5、具备出色的沟通能力和团队协作精神，能够高效指导和推动他人开展研究工作。","job_category":{"id":"6704215956018694411","name":"算法","en_name":"Algorithm","i18n_name":"算法","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785839874964,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A201486A","job_id":"7670122728549337349","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_