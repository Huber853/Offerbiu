{"code":0,"data":{"job_post_detail":{"id":"7670465951632312629","title":"战略分析师 - Global Business Solutions","description":"团队介绍：Global Business Solutions (GBS) 负责TikTok为主的全球产品商业化相关工作，为全球品牌和广告商提供集成的数字营销解决方案。具体包括各区域销售、销售运营、渠道管理、商业化战略、To B市场营销、营销科学、商业化合作和商业内容安全等职能。\n\n1、作为战略伙伴，支持国际化广告销售团队，与业务团队紧密合作，通过重点专项的方式寻找收入提升机会；\n2、对接业务负责人，根据业务需求，完成产品洞察、数据分析和客户调研，产出策略建议，协助业务负责人做出关键产品决策；\n3、主动发现问题和业务痛点，组织关键协作方讨论，产出可落地的解决方案，并协调资源推动落地。","requirement":"1、2027届获得本科及以上学历；\n2、中英双语流利，可作为工作语言；\n3、具备结构化思维，能够独立开展行业研究；\n4、具备优秀的逻辑思考能力和数据分析能力；\n5、具有良好的沟通协调、资源调动、项目推动管理能力。","job_category":{"id":"6704216232129726734","name":"战略","en_name":"Strategy","i18n_name":"战略","depth":2,"parent":{"id":"6704215913488451847","name":"职能 / 支持","en_name":"Corporate Function / Support","i18n_name":"职能 / 支持","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785919529932,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A110689A","job_id":"7670465256843512069","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_lis