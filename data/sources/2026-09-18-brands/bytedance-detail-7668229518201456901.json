{"code":0,"data":{"job_post_detail":{"id":"7668229518201456901","title":"广告产品运营 - 规模化增长","description":"团队介绍：规模化增长团队通过产品驱动举措、代理商与线上销售以及 AI 赋能项目等可扩展渠道，推动收入及 eMAA 的加速增长。我们向潜在客户及现有客户引入精准的广告产品与行业最佳实践。\n\n1、负责或主导或参与广告产品运营工作，推动新功能的上线发布，提升产品在全球范围内的渗透率及用户粘性；\n2、及时排查并解决用户反馈的问题，发掘产品提升的机会点，提升用户满意度；\n3、负责运营流程优化，用户互动及调研事项，提升内部运营效率；\n4、与用户深度互动，了解使用场景及业务难点，形成业务需求，并进一步推动需求实现；\n5、与产品、技术、销售等相关合作团队进行跨部门合作，推动关键项目的执行。","requirement":"1、2027届获得本科及以上学历；\n2、具备流利地道的英语听说读写能力；\n3、良好的自我驱动力，能够在工作环境中处理多项任务；\n4、较强的逻辑思维能力，善于分析处理数据。","job_category":{"id":"6704215882438019342","name":"商业运营","en_name":"Commerce ops","i18n_name":"商业运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785398867594,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A119313B","job_id":"7668216470825437445","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city