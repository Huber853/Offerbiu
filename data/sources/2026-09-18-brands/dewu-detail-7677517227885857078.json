{"code":0,"data":{"job_post_detail":{"id":"7677517227885857078","title":"【27届校招】出海体验策略运营-得物国际","description":"负责得物app出海电商业务体验监控与优化，搭建体验数据体系、发现问题、推动问题解决：\n岗位描述：\n1、体验指标体系搭建：围绕出海业务全链路（浏览、下单、支付、履约、售后），设计并落地体验核心指标与看板，建立可量化的体验度量体系；\n2、体验问题发现与归因：通过数据监控、用户反馈分析、竞品对标等手段，主动识别体验洼地与异常波动，完成问题定位与影响面评估；\n3、跨团队协作推动闭环：协同产品、技术、履约、客服等团队，推动体验问题解决落地，跟踪方案效果并持续迭代；\n4、竞品体验对标：定期跟踪当地海外竞品体验策略，输出对标报告，为体验优化提供外部视角。","requirement":"1、2027届应届生，本科及以上学历，统计学、计算机、应用数学、电子商务、理工科等相关专业优先；\n2、具备 SQL 或 Python 等数据处理能力；\n3、逻辑清晰，对数据敏感，有较强的沟通和推动力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787562251349,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287150094318389559","name":"运营类","i18n_name":"运营类"},"job_id":"7677517227885545782","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type