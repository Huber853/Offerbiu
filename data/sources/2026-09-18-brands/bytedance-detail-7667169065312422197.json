{"code":0,"data":{"job_post_detail":{"id":"7667169065312422197","title":"内部风险运营工程师 - 安全与风控","description":"团队介绍：我们通过部署先进的安全系统、推行标准化操作流程，构建基于零信任的安全防护体系，提升字节跳动全球办公环境的整体安全态势。我们坚持以主动预防为核心，同时构建敏捷高效的安全响应能力，为全球办公环境提供持续、可靠的安全保障。\n\n1、负责对内部威胁相关告警进行初步分析与分级；\n2、对可疑事件进行基础调查，并按照流程完成初步处置或上报；\n3、整理日常告警数据、处置记录，参与编写周期性安全运营报告；\n4、通过处理告警的实践，发现现有检测策略的不足，并提出优化建议。","requirement":"1、2027届获得本科及以上学历，网络安全、信息安全、计算机科学、信息技术等相关专业优先；\n2、具备优秀的自主学习能力和数据分析能力，对数据敏感，逻辑性强，善于发现问题；具备强烈的责任心、自驱力和沟通能力。\n\n加分项\n1、了解大语言模型，对AIAgent有强烈兴趣，解决过实际问题；\n2、了解SIEM/SOC、EDR、DLP、SWG、审计日志平台等相关知识。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785152099769,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A92750","job_id":"7667169626891209013","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_lis