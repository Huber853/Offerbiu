{"code":0,"data":{"job_post_detail":{"id":"7680376718741915958","title":"供应链运营管理专员-成本方向","description":"1、信息化：协助制定采购域信息化规划，推动采购信息系统、采购成本管理等核心系统的建设与迭代；\n2、流程体系：协助梳理核心采购流程架构，推动管理体系优化；\n3、指标体系：协助制定采购成本业务指标体系，辅助业务持续改善与问题解决；\n4、数据分析：协助建立成本分析模型，开展预算与实际对比分析，输出多维度成本洞察支持经营决策；\n5、项目管理：协同供应链、成本部、财务等多部门推进流程落地与系统上线。","requirement":"1、大学本科及以上学历，理工科专业优先；\n2、有采购或供应链管理经验实习，或硬件制造行业实习经验优先；\n3、初步了解制造业成本核算逻辑与采购业务全流程，有系统建设或实施的实习经验优先；\n4、具备基本的采购成本管理专业知识的优先；\n5、具备良好的沟通协调能力，较强的组织能力和高效执行力；\n6、真诚热爱，坚韧乐观，责任心强。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788227106605,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178743792710893677","name":"供应链类","en_name":"Supply Chain","i18n_name":"供应链类"},"job_id":"7680376718741784886","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000