{"code":0,"data":{"job_post_detail":{"id":"7670127830298757429","title":"创作者增长运营 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、作为平台与用户的桥梁，为用户增长负责，通过运营策略沉淀，支持垂类/子垂类作者在平台上成长，实现涨粉升级的目标；\n2、搭建社群运营体系，建设社群工作流，持续提升社群活跃度，设计流失用户召回机制，助力创作者实现身份升级；\n3、定期分析运营数据，持续优化运营策略，识别作者成长及体验问题，并推动系统性解决；\n4、高效推进日常运营项目，确保各环节顺利落地。","requirement":"1、2027届获得本科及以上学历；\n2、有内容运营、创作者运营经验优先；\n3、有敏锐的问题洞察能力及良好的逻辑思考能力；\n4、有良好的书面和口头表达能力，具备良好的沟通与团队协同意识，能有效推进跨团队合作；\n5、具备强烈的好奇心、同理心，具有换位思考的意识和能力，有韧性、有上进心。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785840822453,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A179661A","job_id":"7670127164620441909","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3