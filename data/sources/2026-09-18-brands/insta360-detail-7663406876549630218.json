{"code":0,"data":{"job_post_detail":{"id":"7663406876549630218","title":"视觉算法工程师（标定方向）-2027校招","description":"1、承担运动相机、全景相机等防抖算法研发、优化、维护等工作，深度参与产品全周期研发；\n2、研究先进的防抖解决方案，包括但不限于EIS、OIS、IBIS和HIS；\n3、研究基于IMU、视觉的姿态估计算法；\n4、视觉SLAM/VIO方案研发和优化方案研发和优化；\n5、相机和IMU标定；\n6、研究传感器相关的智能运动识别算法。","requirement":"\"1、硕士及以上学历，数字图像处理、计算机视觉、摄影测量等相关专业；\n2、熟练掌握C/C++、Python；\n3、数学功底扎实，熟悉信号处理、kalman滤波、多视几何等相关算法；\n4、熟悉相机模型、投影和坐标系转换；\n5、熟悉图像处理和计算机视觉基础知识，具备IMU、防抖、运动估计和图像对齐方面的经验；\n6、有较强的逻辑思维能力和问题解决能力，较好的沟通表达能力。\n加分项：\n1、有视觉SLAM或者VIO经验；\n2、有相机和IMU标定经验。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784276135684,"channel_online_status":1,"job_id":"7663406876549482762","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[{"id":"7673730692275407113","name":{"name":"置顶","en_name":"置顶","i18n_name":"置顶"},"style":"{\"backgroundColor\":\"rgba(245, 74, 69, 0.2)\",\"color\":\"rgba(98, 28, 24, 1)\"}","scope_list":[{"id":"7673730692275439881","name":{"name":