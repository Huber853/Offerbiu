{"code":0,"data":{"job_post_detail":{"id":"7670923173756733737","title":"AI生态产品经理","description":"1.需求调研与分析：负责收集并整理业务需求，能独立完成需求文档；\n2.产品设计与规划：参与C、B端产品的功能设计和流程规划，绘制产品原型图，撰写详细的产品功能说明书；能够发现所负责模块体验问题并快速给出解决方案去优化； \n3.项目跟进与协调：跟进产品开发进度，及时解决项目中出现的问题和风险；与跨部门团队进行沟通协调，确保项目按时交付，达成预期目标；\n4.市场调研与竞品分析：关注竞品和行业动态，结合用户需求和反馈，推动产品和服务的进化。","requirement":"1.技能要求：具备一定的产品设计和原型制作能力，熟练使用Axure、Figma等工具；\n2.素质要求：具备较好的逻辑思维能力和问题解决能力，能够快速理解复杂的业务需求；具备较强的学习能力和自我驱动力，能够快速适应新的工作环境和任务要求；对B端产品有浓厚的兴趣和热情，有相关实习经验者优先；\n3.经验要求：有负责过B端产品或AI产品经验优先；熟悉行业，对行业场景，行业用户需求进行分析和提炼，为B端用户提供系统级解决方案。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026180099,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670923173756553513","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,