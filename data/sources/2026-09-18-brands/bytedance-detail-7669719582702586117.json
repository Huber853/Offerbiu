{"code":0,"data":{"job_post_detail":{"id":"7669719582702586117","title":"休闲游戏系统策划 - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、针对游戏中各模块功能和系统，能够独立完成设计并持续优化；\n2、结合游戏玩法，合理规划道具产销，设计丰富的运营活动；\n3、熟悉产品和各品类游戏商业化功能，能够举一反三，对自身产品的商业化功能进行持续优化；\n4、对接美术设计师、开发工程师、QA，跟踪把控质量，细致验收需求，对上线后的结果进行深入总结复盘。","requirement":"1、2027届获得本科及以上学历，产品设计或计算机专业优先；\n2、热爱游戏行业，具备良好的分析能力，对游戏产品有一定理解和思考；\n3、有较好的沟通能力和学习能力，对工作有责任感；\n4、熟练掌握PS、Axure、Office等软件，具备完整输出策划需求的能力。","job_category":{"id":"6850051245139298567","name":"游戏系统策划","en_name":"Game System","i18n_name":"游戏系统策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745868584,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A164906A","job_id":"7661882003006458117","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correl