{"code":0,"data":{"job_post_detail":{"id":"7670931024013199654","title":"流程质量管理专员-local","description":"岗位亮点\n深入参与产品在日本本土化（Localization）与技术落地全过程的核心中台岗位。\n连接总部研发/产品团队与日本本地市场，把控产品定义、技术合规与用户体验。\n\n岗位职责\n产品需求与原型设计、协助梳理日本本地市场的产品功能需求\n产品本土化与技术合规、协助推进产品在日本本地的技术适配\n项目进度与多任务管理、擅长多任务管理（Multi-tasking），跟踪产品从开发、测试、上市到版本迭代的生命周期节点，确保项目按时交付。\n跨国与跨部门沟通协同、作为技术与业务的桥梁，高效对接总部研发/产品线、本地 GTM、测试团队及外部技术合作伙伴。","requirement":"学历与专业背景：\n本科及以上学历；\n理工科相关专业（计算机、软件工程、电子信息、通信工程等）或市场营销、管理学、经济学、统计学等相关专业优先。\n工具与专业技能：\n・精通/熟练掌握 Word、Excel、PPT 等基础办公软件，具备优秀的 PPT 方案制作与数据分析能力。\n语言能力：\n日语 \u0026 中文： 具备良好的日文及中文沟通能力，能无障碍进行跨国团队协作与组织协调。\n英语：具备良好的听说读写能力，能够进行技术文档阅读交流）。\n核心能力：\n具备极强的时间管理能力与多任务并行处理能力。\n学习能力强，具备良好的逻辑思考能力、组织协调能力与“One Team”团队合作精神。","city_info":{"code":"CT_34","name":"东京","en_name":"Tokyo","i18n_name":"东京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028630365,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879388781","name":"服务类","en_name":"Service","i18n_name":"服务类"},"job_id":"7670931024013068582","city_list":[{"code":"CT_34","name":"东京","en_name":"Tokyo","location_type":3,"i18n_name":"东京","py_name":"dongjing","mdm_code":"MDCY00002748","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_