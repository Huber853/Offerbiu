{"code":0,"data":{"job_post_detail":{"id":"7671294856539654436","title":"视频算法工程师","description":"岗位描述：\n1、参与移动端视频图像处理算法研究，包括但不限于基于深度学习的视频图像处理；\n2、对现有算法进行效果及性能优化；\n3、探索与跟进前沿技术，推动计算机视觉算法和深度学习在实际应用领域的性能优化和落地。","requirement":"任职要求：\n1、计算机、信号处理、通信等相关专业硕士及以上学历；\n2、具备扎实的C/C++、数据结构与算法基础知识，良好的编程动手能力、逻辑思维和快速学习能力；\n3、熟练使用一种深度学习框架，如Pytorch、TensorFlow等；\n4、具备模式识别、视频图像处理、机器视觉、信号处理或人工智能等方面基础知识；\n5、有计算机视觉方面研究与应用经验、在国际视频图像领域学术期刊会议上有论文发表者优先。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112702396,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761476330340460","name":"算法类","en_name":"Algorithm","i18n_name":"算法类"},"job_id":"7671294856539523364","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode":1,