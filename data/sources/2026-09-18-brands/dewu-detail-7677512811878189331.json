{"code":0,"data":{"job_post_detail":{"id":"7677512811878189331","title":"【27届校招】商家履约产品运营-得物国际","description":"1、负责POIZON 国际电商商家产品运营/解决方案相关工作，提升商家入平台仓全链路产品体验，如：平台仓商家入驻、入库单管理、选品打包规范、商家发货、关务备案、库存管理、收货/理货报告等；\n2、调研收集海外商家备货入仓全链路需求机会，撰写业务MRD需求和方案，协同产品和运营推进产品方案持续迭代升级；\n3、负责产品上线后的商家培训宣导，通过产品化方式降低商家学习成本，保障商家使用产品体验；\n4、对商家入仓全链路产品满意度及CPO负责，建立不同渠道商家产品满意度反馈，定期开展调研分析识别并解决商家问题；\n5、搭建完善的数据化运营体系，通过数据驱动产品迭代与效果优化，并能挖掘业务机会点，推动产品持续优化与改进。","requirement":"1、2027届应届生，本科及以上学历，具备电商商家产品实习经验，有较好的用户视角；有国际电商商家备货，入仓等经验优先\n2、数据驱动，具有业务思维，善于从业务视角分析问题并提出产品解决方案；\n3、自驱力强、善于沟通、协调资源能力强，善于影响和推动协作方，确保需求落地；\n4、具有较好的学习能力，较强的数据敏感度和分析能力，逻辑思维缜密，有一定的抗压能力；\n5、英语可作为工作语言者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787561607062,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287150094318389559","name":"运营类","i18n_name":"运营类"},"job_id":"7677510388456802566","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_nam