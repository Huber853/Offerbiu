{"code":0,"data":{"job_post_detail":{"id":"7677512186726107443","title":"【27届校招】商家运营-得物国际","description":"本岗位有跨类目轮岗安排（具体以Offer前后的沟通信息为准）\n1、负责平台商家群体的日常运营：商家入驻引导、平台运营规范宣导、商家日常咨询答疑，保障商家在平台的正常运营；\n2、负责商家运营数据跟进：定期产出商家经营数据报表，识别异常与增长机会，输出运营建议并跟进落地；\n3、独立对接所辖商家：建立商家沟通机制，收集商家反馈与需求，联动产品、体验等团队推动问题解决与规则优化；\n4、在Mentor指导下参与重点项目：如重点商家扶持、品类增长专项等，逐步形成自己的方法论。","requirement":"1、2027届应届生，本科及以上学历，专业不限（经管、电商、外语类优先）；\n2、英语可作为工作语言；掌握日语/韩语/法语/意大利语等其他语言为加分项；\n3、对电商行业有热情，有电商平台/品牌/商家实习经历者优先；\n4、具备良好的数据敏感度与逻辑分析能力，能熟练使用 Excel 等工具；\n5、自驱力强、结果导向，具备出色的沟通协调与抗压能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787562302400,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287150094318389559","name":"运营类","i18n_name":"运营类"},"job_id":"7677512186725796147","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode":1,"stor