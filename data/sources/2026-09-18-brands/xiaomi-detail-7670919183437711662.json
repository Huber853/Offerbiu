{"code":0,"data":{"job_post_detail":{"id":"7670919183437711662","title":"材料开发工程师-汽车","description":"1. 负责整车材料对标、选材策略、问题总结横展及材料性能项目交付；\n2. 负责各造车阶段材料一车一档性能验证、整车材料性能验收以及相关材料失效分析；\n3. 负责车内空气质量、整车防腐、整车老化或回收可持续环保属性目标定义、分解、验证及项目交付；\n4. 负责建立材料标准、体系流程、材料数据库及平台化实施；\n5. 负责新材料新技术开发应用落地；\n6. 负责制定材料技术应用发展规划。","requirement":"1. 材料学、化工等相关专业方向，本科及以上学历；\n2. 熟悉钢镁铝合金材料或高分子材料等理论知识，熟悉相关材料成形工艺及原理；\n3. 了解材料各种性能测试分析方法及工具；\n4. 具有材料开发或环保性能开发相关课题研究经验者优先；\n5. 具有良好的沟通能力。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025158983,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919183437547822","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_s