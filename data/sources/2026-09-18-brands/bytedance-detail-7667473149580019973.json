{"code":0,"data":{"job_post_detail":{"id":"7667473149580019973","title":"客户端开发工程师 - 抖音研发","description":"团队介绍：抖音研发部门负责多款大型产品的研发，包括但不限于抖音、西瓜视频、汽水音乐。\n加入我们，你将有机会参与亿级用户场景的开发与架构工作，使用前沿的技术助力业务一起不断成长。\n\n1、参与大型客户端应用产品基建设施的设计、开发、测试、维护和优化工作；\n2、参与大型客户端AI4SE场景的Agent工程化建设，包括不限于智能单测、代码理解、架构分析、代码重构、端到端Agent Skills的AI应用设施的建设落地；\n3、参与新技术的研究，为客户端产品的持续创新提供技术支持。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程、人工智能等相关专业优先；\n2、对LLM、Agent、向量数据库，Pyspark大数据分析、RAG有深入研究或项目经验者优先；\n3、熟悉移动端研发体系或深度参与开源项目者优先；\n4、热爱计算机科学和互联网技术，系统掌握计算机原理或LLM原理，熟悉至少一门编程语言，包括但不仅限于：C、C++、Python、Go、OC、Swift；\n5、自驱，有强烈的求知欲和好奇心，优秀的学习、沟通能力和解决问题的能力。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785222731427,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A244283","job_id":"7664880788235946293","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1},{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_