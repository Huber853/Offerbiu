{"code":0,"data":{"job_post_detail":{"id":"7668526256773990709","title":"前端开发工程师（网络） - AI算力基础设施","description":"团队介绍：字节跳动基础设施部门，负责字节跳动的全栈算力基础设施，从芯片服务器产研、到超大规模数据中心，到传统云平台和如今的AI Native Cloud，全方位为抖音、豆包、今日头条、飞书、火山引擎等各类产品提供领先、稳定的百万量级大规模算力基础设施服务。我们的领域涵盖数据中心建设、内核操作系统开发、服务器集群管理、高速网络通信、EB级数据存储体系、搜索型数据库探索、基于LLM的AI基础设施的研发调度与治理等，致力于打造业界领先的、面向LLM的AI云原生基础设施架构与产品矩阵。\n\n1、参与字节跳动网络产品前端研发与体验技术创新工作；\n2、面向全球客户，深入发掘、理解、分析业务需求，撰写技术方案并落地实现；\n3、参与前端架构设计演进、AI研发效能提升、自动化测试、运维等建设工作；\n4、参与Agent中间件、大规模网络节点可视化、页面自动化生成与操作等多个方向的探索。","requirement":"1、2027届获得本科及以上学历，计算机等相关专业优先；\n2、熟练掌握主流前端技术栈与应用框架，具备AI编程实践经验，理论与工程能力兼备；\n3、良好的沟通和团队协作能力，热爱技术、责任心强，具备强烈的好奇心和快速学习能力。","job_category":{"id":"6704215958816295181","name":"基础架构","en_name":"Infrastructure","i18n_name":"基础架构","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785467905596,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A49420","job_id":"7668526168911628597","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status"