{"code":0,"data":{"job_post_detail":{"id":"7670908142096697627","title":"SOC软件测试开发工程师","description":"1、熟悉Linux系统内核命令操作以及Android系统分层架构；\n2、了解SOC芯片相关模块领域工作： CPU，LPDDR，UFS/EMMC，GPU，NPU，MainBus的原理，了解这些模块工作模式以及工作场景；\n3、了解总线接口I2C，I3C，SPI，SPMI，USB，PCIE以及各外设加载相关的工作模式；\n4、需要与芯片/软件/硬件团队开展深入合作交流，进行问题的调试和分析；\n5、对芯片/软件问题进行跟踪分析和报告，推动问题及时合理地解决；\n6、汇总测试执行情况，编写各阶段测试报告。","requirement":"1、本科以上学历，微电子/计算机/软件/自动化/数学相关专业； \n2、对芯片SOC架构或者嵌入式系统软硬件工作原理有一定学习了解，掌握计算机体系结构知识；\n3、熟练掌握shell脚本语言或者熟练掌握C/C++语言，熟悉/python/java语言在windows/linux系统上的使用了解FPGA原型板的工作机制；\n4、了解Lauterbach工具的调试使用积极主动，责任感强，具备良好的沟通能力和团队合作精神。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786023080406,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7670908142096517403","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobCha