{"code":0,"data":{"job_post_detail":{"id":"7670934733808159022","title":"电商销售主管-local","description":"岗位描述：\n1、推动客户电商布局发展，如主力平台Amazon/eBay/Aliexpress份额的抢夺，新平台的布局与投入；\n2、建立与维护客情关系，做好紧密的客户沟通工作，高效落实公司战略；\n3、达成手机及IoT产品销售任务，结合市场情况和部门的销售任务，完成分解到客户的月度销售任务；\n4、掌握客户整体的 sell in/sell through/sell out 完整闭环，监控客户库存周转、合规激活、线上零售，及时了解客户库存及流速情况，保证良性销售；\n5、了解行业动向及市场情况，包括竞品情况，沟通调整销售方案；\n6、协调各种干扰客户发展的问题，如各种仓库，授权，合同、售后等，确保业务顺利推进。","requirement":"1、本科及以上学历，市场营销、国际贸易或理工类专业优先；\n2、具备对手机行业及电商的认知；\n3、具备较强的谈判能力、沟通能力；\n4、有强大的自驱力，高效的执行力，善于思考，逻辑性强。","city_info":{"code":"CT_204","name":"米兰","en_name":"Milan","i18n_name":"米兰"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028691648,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879437933","name":"销售类","en_name":"Sales","i18n_name":"销售类"},"job_id":"7670934733807978798","city_list":[{"code":"CT_204","name":"米兰","en_name":"Milan","location_type":3,"i18n_name":"米兰","py_name":"milan","mdm_code":"MDCY00007340","node_status":1},{"code":"CT_1102404","name":"杜塞尔多夫","en_name":"Düsseldorf","location_type":3,"i18n_name":"杜塞尔多夫","py_name":"dusaierduofu","mdm_code":"MDCY00001065","node_status":1},{"code":"CT_96","name":"马德里","en_name":"Madrid","location_type":3,"i18n_name":"马德里","py_name":"madeli","mdm_code":"MDCY00003410","node_status":1},{"code":"CT_93","name":"伦敦","en_name":"London","location_type":3,"i18n_name":"伦敦","py_name":"lundun","mdm_code":"MDCY00003714","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":