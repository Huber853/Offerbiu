{"code":0,"data":{"job_post_detail":{"id":"7670914736652863782","title":"乘员舱舒适性开发工程师-汽车","description":"1. 负责整车乘员舱舒适性属性开发及项目交付，含VDS目标定义及分解、开发策划、性能集成、仿真分析、试验验证及项目交付等；\n2. 负责整车乘员舱舒适性仿真业务的开展及项目交付，如除霜除雾、吹面吹脚、采暖降温、外循环进气阻力、空调风噪等，含仿真建模、分析优化、方案推进与跟踪落实，报告编制及相关交付物归档等；\n3. 负责构建人体热舒适性模型，开发智能识别算法，实现实时感知与预测，研究并优化热舒适性调控策略；\n4. 负责整车乘员舱舒适性试验策划、试验验证、对标分析、问题总结与横展等；","requirement":"1. 热能与动力、低温与制冷、暖通、车辆工程、机械等专业硕士及以上学历；\n2. 熟悉空调热管理系统工作原理和系统零部件； \n3. 熟悉STAR-CCM+等相关流体仿真软件； \n4. 责任心强，勤奋踏实，积极主动，有创新思维，良好的沟通、团队合作及英语水平；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024028276,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670914678173157670","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list"