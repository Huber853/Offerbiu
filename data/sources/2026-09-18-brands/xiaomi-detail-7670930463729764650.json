{"code":0,"data":{"job_post_detail":{"id":"7670930463729764650","title":"运营专员-汽车","description":"1、数据报表与分析： 负责部门日报、周报及月度运营数据的收集、清洗与汇总，协助生成数据可视化图表供决策参考；\n2、对账与费用结算： 协助处理物流承运商及第三方服务商的运费对账、发票审核及报销立项流程，确保账目清晰准确；\n3、系统与主数据维护： 协助维护供应链/交付相关系统（ERP/TMS/WMS）的基础主数据，确保系统数据准确无误；\n4、行政与流程支持： 协助整理部门 SOP（标准作业程序）文档，跟踪部门重点项目的节点落实，提供日常行政与后勤支持。","requirement":"1、应届毕业生，本科及以上学历，统计学、数据分析、物流管理、财务管理、电子商务等专业优先；\n2、精通 Excel（熟悉数据透视表、常用函数，会 VBA 或 Power BI/Tableau 者优先），具备良好打字与文档撰写能力；\n3、极强的细心度与耐心，对数据准确性有“洁癖”；\n4、优秀的学习能力，能够快速上手各类供应链软件和公司内部系统；\n5、具备良好的团队协作精神，有良好的问题追踪与闭环意识。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028050908,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670930463729600810","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i1