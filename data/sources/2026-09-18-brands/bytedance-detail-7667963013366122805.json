{"code":0,"data":{"job_post_detail":{"id":"7667963013366122805","title":"跨平台研发工程师（基础建设方向） - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、负责CI系统的核心能力开发和架构优化，如CommitQueue、分布式调度服务、配置服务、动态Pipeline定制以及指标监控等；\n2、开发和优化多种操作系统（Android、iOS、Mac、Windows、Linux）的统一构建工具和源码管理工具；\n3、设计并实现跨平台的云端构建服务，并负责其核心代码的开发和系统性能的优化。","requirement":"1、2027届获得本科及以上学历，计算机科学、电子工程等相关专业优先；\n2、熟练掌握包括但不限于C/C++、Objective-C/Swift、Java、Python、JavaScript、Go等一种或多种编程语言；\n3、对常规的数据结构，算法，计算机网络和操作系统知识等具有深刻的理解；\n4、具有良好的英语读写能力，能够阅读和理解英文的技术文档。\n\n加分项：\n1、熟悉Android/iOS构建流程，具备基础架构自动化、DevOps或CI/CD方面的实践经验；\n2、曾参与过分布式系统、网络、计算或存储、数据库相关的开发项目。","job_category":{"id":"6704215958816295181","name":"基础架构","en_name":"Infrastructure","i18n_name":"基础架构","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785336767279,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A114841A","job_id":"7667962145032505653","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"