{"code":0,"data":{"job_post_detail":{"id":"7669718332707866885","title":"游戏客户端开发工程师 - ZERO36工作室","description":"团队介绍：ZERO36工作室旗下有《航海王热血航线》、《花亦山心之月》、《初音未来：缤纷舞台》多款游戏产品。\nZERO，是从0开始，是不念过往，不畏将来；是回到原点，对知识诚实；是一切开始的基础。\n36，如果加上°C，即为人体的温度，戒骄戒躁保持初衷，用\"温度\"拉齐大家的目标和价值观，做有温度的产品，有温度的运营，成为一个有温度的团队，欢迎加入我们！\n\n1、参与游戏客户端功能开发；\n2、参与游戏工具、工具链、编辑器的开发与维护。","requirement":"1、2027届获得本科及以上学历，计算机相关专业优先；\n2、扎实的计算机基础，熟练掌握C#/C++；\n3、有游戏引擎使用经验（Unity，Unreal等）优先，有游戏项目开发经验优先；\n4、有团队合作精神，良好的沟通协作，强烈的责任心。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745586962,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A202126","job_id":"7661889426739792133","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":