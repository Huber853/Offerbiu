{"code":0,"data":{"job_post_detail":{"id":"7670919675983235354","title":"电驱工艺工程师-汽车","description":"1. 负责基于新产品定义产线RFQ，根据产能需求规划产线结构，确定整体方案与夹具方案；\n2. 负责跟踪供应商设计制造进度，主导设备各阶段验收及安装调试交付全流程；\n3. 负责编制维护PDM/规划工艺/PFMEA/CP等工艺文件，编制修订工艺标准；\n4. 负责项目同步工程，持续优化产品结构保证可制造性，在质量、成本、效率、安全等方向发现并改善问题；\n5. 负责快速响应量产线问题，从工艺流程和方法层面支持生产维修解决产线问题；\n6. 负责持续跟踪设备爬坡直至SOP，与供应商确认设备详细方案并优化关键技术点。","requirement":"1. 本科及以上学历，机械/自动化/电机及相关专业；\n2. 了解电驱构造及前沿技术；\n3. 具备电驱、电机相关课程设计或实习经历优先；\n4. 了解PFMEA、控制计划等质量工具优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025251138,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7208442611194445933","name":"生产制造类","en_name":"Manufacturing","i18n_name":"生产制造类"},"job_id":"7670919675983055130","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_sta