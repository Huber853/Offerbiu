{"code":0,"data":{"job_post_detail":{"id":"7670889516681791771","title":"软件开发工程师-java方向","description":"1、参与基于 Java 技术栈的软件项目开发，包括需求分析、设计、编码和单元测试。\n2、协助团队进行代码审查，确保代码质量和可维护性，遵循公司的开发规范和流程。\n3、和产品/测试/运营进行密切沟通，能够根据需求提出合理技术方案；\n4、负责软件开发过程中的问题分析和总结，提供建议和帮助改善研发流程；\n5、关注行业技术发展趋势，积极学习新技术，为项目引入创新的解决方案。","requirement":"1、计算机科学、软件工程等相关专业，具备扎实的计算机理论基础，本科及以上学历；\n2、熟练掌握 Java 编程语言，熟悉常用的设计模式和数据结构；\n3、了解常用的 Java 开发框架，如 Spring、Spring Boot、MyBatis 等；\n4、熟悉数据库开发，掌握 SQL 语言，了解 MySQL 等主流数据库；\n5、具备良好的沟通能力和团队协作精神，学习能力强，对技术有热情，有强烈的责任心。\n","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018388646,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670889516681611547","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"add