{"code":0,"data":{"job_post_detail":{"id":"7670923881368094982","title":"机械工程师-机器人","description":"1、负责机器人本体机械结构方案设计；完成三维建模、工程图纸输出及 BOM 管理，确保设计可制造、可装配；\n2、进行机器人运动学与动力学建模分析，验证关节布局、运动范围、负载能力及动态性能；\n3、跟进样机装配、调试与测试，解决试产及量产过程中的结构问题；\n4、与电气、算法、软件团队紧密协作，推动跨学科联合设计。","requirement":"1、硕士及以上学历，机械工程、机器人工程等相关专业；\n2、精通 SolidWorks / Creo / CATIA 中至少一种三维建模软件，熟练掌握工程制图规范；\n3、具备扎实的机械设计基础，熟悉常用材料特性、加工工艺及公差分析；\n4、掌握运动学、动力学分析方法，熟悉 ADAMS / MATLAB / Simscape 等多体动力学仿真工具；\n了解有限元分析（ANSYS / Abaqus / HyperMesh 等）工具；\n5、有机器人项目经历、竞赛获奖或专利成果者优先；\n6、较强的逻辑思维与沟通协作能力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026312870,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670923881365358854","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i