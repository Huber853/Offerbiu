Code":null,"writeExamType":null,"ifShowRecruitWebsite":true,"ifShowRecommendWebsite":true,"ifRecruitWebsiteHot":1789456159000,"ifRecommendWebsiteHot":1789456159000,"finalInterviewerCode":null,"auditStartUser":null,"auditStartTime":null,"positionAuditProcessId":null,"businessAuditTemplateCode":null,"auditTemplateCode":null,"offerAuditProcessId":null,"pauseTime":null,"releaseTime":"2026-08-12 16:41:32","closeTime":null,"closeUserId":null,"positionLabel":null,"updateTime":1789614307000,"recruiterScreenEvalFilteringAccuracy":null,"positionObservers":null,"applyNum":0,"entryNum":0,"hcHoldYear":null,"process":null,"workLocationDicts":[{"name":"上海","code":"shanghai"},{"name":"北京","code":"beijing"}],"jobPortrait":null,"ifHasSmartAnalysis":null,"enablePass":null,"enableAutoElimination":null,"hasIntelligentAuth":null,"ifCollect":null},{"id":13295,"code":"91287cfbd99449f0b53e1fa81c2f30e1","type":"outer","hasInner":null,"positionStatusCode":"Release","recruitProjectCode":"schoolr","recruitSubProjectCode":"20271779425607","hcHoldTime":null,"name":"数据科学家","departmentCode":null,"departmentName":null,"businessDirectoryCode":null,"positionClassCode":"3","ifFrontLineEmployee":null,"welfareLabelCode":null,"workingHoursNature":"1001","positionNatureCode":"fulltime","positionCategoryCode":"analysis","positionRankCode":null,"positionLevelCode":null,"workLocationCode":null,"recruitNumber":null,"allocateResumeWeight":null,"allocateWaterLevel":null,"headCountUsed":null,"description":"【加入我们，你将做什么？】\n1. 基于数据分析、量化建模、市场调研等工具对产品和市场进行理解和刻画，解决短视频、直播及新产品增长相关的各种复杂商业分析问题，能独立完成从方案设计、数据加工与分析，到结论展示的整个流程；\n2. 对公司内外部数据进行挖掘，在深入的产品理解与用户洞察基础上，自主发掘课题，提出有实效的建议，驱动产品迭代；\n3. 针对不同业务：市场、产品、增长等业务线做数据支持。\n\n【加入我们，你能获得什么？】\n1. “牛人”导师团零距离带教\n实战派领航员：由多位数据分析负责人担任主导师团，人均操盘过亿级数据的拆解；\n1v1成长伙伴：同时配备资深导师全程带教，从需求拆解到方案落地，手把手带你入门并逐步突破认知的盲区；\n咖啡基金：配备咖啡基金，可用于定期与导师的「咖啡角」讨论会。\n2. 快手流量生态全景认知\n深度解析流量体系：深度理解公司业务，参与进核心业务的数据拆解分析；\n真实战场带练： 在快手真实业务场景中实战，理解数据如何驱动亿级流量分配；\n全局视野构建： 横向理解用户、内容、商户三端诉求，培养业务拆解能力。\n3. 与算法+策略组成黄金铁三角\n强协同工作模式： 与算法、策略产品组成“铁三角”，全程参与需求迭代的闭环体系；\n硬核技能打造： 学习从用户角度看问题，用数据分析反推用户本质需求；\n决策话语权培养： 掌握用户+算法双语言驱动产品，成为懂产品的数据牛人。","positionDemand":"1. 本科及以上学历，工学/理学以及工程相关的专业优先，有数据相关竞赛经历优先；\n2. 扎实的分析基础或代码能力，擅长使用各种工具进行数据分析，熟练掌握熟练使用SQL、Python或R进行数据提取和分析，并能基于数据洞察持续反哺业务；\n3. 互联网产品重度使用者，有互联网策略产品/数据分析等相关实习经验优先，对用户需求和商业逻辑敏感，逻辑清晰，具备结构化思考和系统性解决问题的能力，能独立输出产品方案；\n4. 良好的跨界协同、沟通表达、项目管理能力，能协调多方资源推动目标达成；\n5. 较强的自驱力和抗压力，对业务未知领域持续保持好奇与探索，适应互联网快速迭代的环境；\n6. 熟练使用 AI 工具（Data Agent、ChatGPT、Copilot 等），对“用 AI 解决什么问题”有清晰判断——知道何时用 AI、何时不用，能问出正确的问题再交给 AI 处理。\n\n【我们寻找这样的你】\n1. 痴迷用数据和逻辑破解复杂问题，对用户行为背后的规律充满好奇；\n2. 渴望在万亿级流量战场上操盘核心策略，同时对能够拥有硬核的分析能力，有强烈诉求；\n3. 期待与顶尖人才并肩作战，乐于沟通协调资源，三年内成长为独当一面的数据牛人。","smartResumeConfig":null,"enableIntelligent":null,"recruitLeaderNumber":null,"recruitLeaderName":null,"recruitLeaderUsername":null,"outRelationPositionId":null,"ifParticipateBeisen":null,"evaluateCompanyCode":null,"evaluateProjectCode":null,"writeExamType":null,"ifShowRecruitWebsite":true,"ifShowRecommendWebsite":true,"ifRecruitWebsiteHot":1789456145000,"ifRecommendWebsiteHot":1789456145000,"finalInterviewerCode":null,"auditStartUser":null,"auditStartTime":null,"positionAuditProcessId":null,"businessAuditTemplateCode":null,"auditTemplateCode":null,"offerAuditProcessId":null,"pauseTime":null,"releaseTime":"2026-08-09 18:03:16","closeTime":null,"closeUserId":null,"positionLabel":null,"updateTime":1789440956000,"recruiterScreenEvalFilteringAccuracy":null,"positionObservers":null,"applyNum":0,"entryNum":0,"hcHoldYear":null,"process":null,"workLocationDicts":[{"name":"北京","code":"beijing"}],"jobPortrait":null,"ifHasSmartAnalysis":null,"enablePass":null,"enableAutoElimination":null,"hasIntelligentAuth":null,"ifCollect":null},{"id":13145,"code":"7746933f8afa43bb9708bc47f621ae3d","type":"outer","hasInner":null,"positionStatusCode":"Release","recruitProjectCode":"schoolr","recruitSubProjectCode":"20271779425607","hcHoldTime":null,"name":"AI Agent 全栈工程师-音视频方向","departmentCode":null,"departmentName":null,"businessDirectoryCode":null,"positionClassCod