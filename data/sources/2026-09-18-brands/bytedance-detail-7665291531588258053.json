{"code":0,"data":{"job_post_detail":{"id":"7665291531588258053","title":"模型运营（广告方向） - 内容质量与数据服务平台","description":"团队介绍：CQC（中国内容质量与数据服务平台）归属于抖音集团，负责今日头条、抖音、西瓜视频等产品内容和抖音集团商业内容的安全质量与体验，支持各产品的运营和增长，以及为产品线提供AI算法算力的基础支持服务。\n\n1、负责内容质量策略的编制及迭代；\n2、通过算法模型、工具等自动化产品运营手段不断优化迭代相关产品；\n3、根据行业大模型需求，设计和构建合适的模型，进行实验和测试，并不断优化模型的性能和效果。","requirement":"1、2027届获得本科及以上学历，自然语言处理、计算机、人工智能、数据科学等相关专业优先，其余专业有模型领域研究实践经验亦可；\n2、了解模型技术，参与过模型训练和优化迭代过程，熟练掌握Prompt编写、应用和优化技巧，了解AI Agents原理，对人机辅助有兴趣有行动；\n3、具备较好的学习能力和沟通协调能力，协调推进各方达到项目目标。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_22","name":"成都","en_name":"Chengdu","i18n_name":"成都"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784715056932,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A180881","job_id":"7665291755504044293","city_list":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name