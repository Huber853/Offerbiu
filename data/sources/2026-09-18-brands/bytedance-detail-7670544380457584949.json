{"code":0,"data":{"job_post_detail":{"id":"7670544380457584949","title":"AI训练/推理框架研发工程师 - 火山方舟","description":"团队介绍：火山方舟是火山引擎推出的一站式大模型服务平台，是中国大模型市场产品和份额领跑者。平台提供模型推理、评测、精调等全流程服务。方舟搭载了豆包及业界主流大模型，提供丰富的插件生态和AI应用开发服务，并通过稳定可靠的安全互信方案、专业的算法技术服务，全方位保障企业级AI应用落地。\n\n1、参与火山自研训推框架开发，包括xLLM（LLM推理）、veFuser（DiT推理）、veOmini（LLM/DiT训练）、veRL（强化学习），保持框架的先进性；\n2、参与框架-平台协同设计，实现异构资源智能调度与弹性扩缩容；\n3、参与异构芯片（GPU、NPU等）上的算子适配开发，提供多元的算力供应方式。","requirement":"1、2027届获得本科及以上学历，计算机、人工智能、信息安全等相关专业；\n2、熟悉Linux开发环境，良好的系统编程、数据结构、算法基础、系统设计能力；\n3、乐于挑战没有明显答案的问题，快速理解业务场景，从具体问题中抽象出通用的解决方案；\n4、有实际的分布式系统相关经验者优先；\n5、对机器学习系统有经验者优先。","job_category":{"id":"6704219534724696331","name":"机器学习","en_name":"Machine learning","i18n_name":"机器学习","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785938010968,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A11939","job_id":"7670544862778738949","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list