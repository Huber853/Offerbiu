{"code":0,"data":{"job_post_detail":{"id":"7663432110748862739","title":"Visual Designer（电商方向）-2027校招","description":"1、协助完成电商全渠道基础视觉设计，包括推广素材、详情页辅助设计、活动页面元素制作等；\n2、参与设计素材整理、优化，配合高级设计师完成版式调整、色彩适配等基础工作，确保品牌风格统一；\n3、关注电商设计市场趋势，收集行业优秀案例，为团队提供创意参考，辅助完成用户行为相关的基础分析；\n4、协同运营、产品团队，跟进设计需求落地，及时反馈执行过程中的问题，配合完成设计方案的小幅迭代。","requirement":"1、基础能力：设计类相关专业（视觉传达、平面设计等）在校学生，具备扎实的美术功底，能独立完成设计作品需求，电商实习经历加分；\n2、工具掌握：掌握Figma、Photoshop、Illustrator 等基础设计工具，有电商、网页等设计作品加分；\n3、认知与潜力：对电商行业有一定了解，愿意主动学习市场趋势和用户行为逻辑，具备较强的观察力和执行力；\n4、素质要求：认真细致，能承受一定的工作节奏，良好的沟通协作能力，愿意接受团队指导并快速改进。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784281956536,"channel_online_status":1,"job_id":"7663431677814278406","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}