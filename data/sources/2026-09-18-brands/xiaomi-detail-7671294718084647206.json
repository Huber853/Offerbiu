{"code":0,"data":{"job_post_detail":{"id":"7671294718084647206","title":"认证测试工程师-手机","description":"1.参与手机、平板、穿戴等整机研发上市流程,负责国内CCC等,以及海外CE/FCC等全球准入认证,把控项目排期,保障产品顺利上市。\n2.跟进射频、EMC、安规、SAR等认证测试,对接研发团队定位问题、输出整改方案、完成复测闭环,沉淀认证问题案例。\n3.跟踪国内外终端法规、行业标准更新,开展产品变更合规评审,管控量产认证一致性,维护证书、报告台账及技术档案。\n4.对内拉通硬件、射频、结构、项目团队同步认证需求与风险；对外对接检测实验室、认证机构,高效推进测试与取证工作,输出项目进度及复盘报告。","requirement":"1. 通信、电子信息、自动化相关专业本科及以上,211和985优先；\n2.熟悉模电/数电、电磁场、电磁兼容、无线通信（4G/5G/WiFi/蓝牙）基础原理,了解手机硬件、射频架构优先；\n3.结果导向,自我驱动,具备良好的自学能力；\n4.具有良好的沟通能力,团队协作意愿和能力；\n5.英语四级及以上水平,具备良好的读写能力；\n6.熟练使用office等办公软件。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112532019,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7671294718084516134","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type