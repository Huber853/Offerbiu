{"code":0,"data":{"job_post_detail":{"id":"7672285925036968197","title":"策略产品经理 - 红果短剧","description":"团队介绍：红果短剧是抖音集团2023年推出的免费看剧产品，致力于为用户提供海量免费优质短剧，同时也为用户提供电影、电视剧、小说、有声书等多元内容，满足不同用户的内容消费需求。\n\n1、负责短剧各方向和场景下的功能和策略设计，如分发推荐、搜索等，提升短剧用户的消费体验和时长；\n2、分析内容特性、用户消费行为和场景特点，通过数据分析发现优化点，AB实验验证和归因优化思路；\n3、独立完成相关产品需求文档的撰写，推动需求落地，持续关注指标变化，善于通过数据发现问题及论证假设。","requirement":"1、2027届获得本科及以上学历；\n2、对数据敏感，能透过数据分析业务现状，会SQL和基础分析和工具者优先；\n3、对短剧有热情，对内容消费产品有好奇心，有用户视角愿意思考，具有良好的团队沟通与项目推动能力。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786343382880,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A150149","job_id":"7672285807403075893","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_