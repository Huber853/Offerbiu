{"code":0,"data":{"job_post_detail":{"id":"7673503996564769060","title":"体验设计师-2027校招","description":"我们正在寻找一位兼具创新视野与数据思维的体验设计师，专注于提升新品发布全周期的用户体验。你将参与官网产品页、上市推文、包装等设计工作，助力打造具有行业竞争力的用户体验。\n1、协助开展用户研究和数据分析工作，并完成产品体验方案的交付；\n2、与跨部门团队紧密合作，推动体验设计方案的落地与执行； \n3、持续关注全球体验设计趋势，结合前沿技术探索设计创新边界； \n4、主动发现项目中的问题，优化交互设计流程，提升设计一致性与工作成效。","requirement":"1、本科及以上学历，交互、体验设计相关专业，2027 届应届毕业生； \n2、具备扎实的体验设计理论基础，对用户体验有深刻的理解和敏锐度； \n3、能够熟练使用主流设计工具，对新兴设计趋势和工具保持关注与学习热情；\n4、有完整项目经历或实习经验（实习经历不限行业），能展示体现独立思考与执行能力的交互设计作品； \n5、具有优秀的沟通协作与抗压能力；具备长期与公司共同发展的意愿，持续进步。喜欢迎接创新，有好玩的生活概念。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786627300966,"channel_online_status":1,"job_id":"7673503996564605220","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}