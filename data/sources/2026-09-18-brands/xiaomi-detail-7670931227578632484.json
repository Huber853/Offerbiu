{"code":0,"data":{"job_post_detail":{"id":"7670931227578632484","title":"硬件项目经理","description":"1、参与硬件项目的需求分析，协助制定项目计划、进度安排和资源分配；\n2、跟踪项目进展，协调硬件开发、测试、生产等团队的工作，确保项目按时交付；\n3、协助管理项目风险，识别潜在问题并提出解决方案；\n4、与客户、供应商及其他相关方保持沟通，确保项目目标一致；\n5、撰写项目文档，包括需求文档、项目报告和总结；\n6、学习并应用项目管理工具（如JIRA、Microsoft Project）。","requirement":"1、本科以上学历，自动化、计算机、机电一体化以及商务管理等相关专业；\n2、有电子通讯相关行业实习经历优先；\n3、具备英语读写能力，能够使用英语作为工作沟通语言者优先；\n4、了解硬件开发流程和项目管理基本理论（如瀑布模型、敏捷开发）。\n5、对硬件开发工具（如Altium Designer、Cadence）有基本了解者优先。\n6、具备良好的沟通能力和团队协作能力。具备较强的逻辑思维和问题解决能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027951048,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670931227578468644","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code