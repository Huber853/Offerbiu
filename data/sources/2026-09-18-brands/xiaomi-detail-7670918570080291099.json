{"code":0,"data":{"job_post_detail":{"id":"7670918570080291099","title":"动力及热管理零部件可靠性工程师-汽车","description":"1. 对动力（电池、电驱、充电、高压线束、增程器）及热管理零部件中的某一类或多类零部件进行系统架构评估、软硬件和结构设计评审、生产工艺评审，识别产品可靠性风险，提出改进建议或风险闭环方案；\n2. 负责动力及热管理零部件的失效模式分析、载荷分析、强度分析及验证试验策划；\n3. 负责零部件试验标准的正向设计开发，熟练掌握可靠性置信度等计算逻辑及方法。\n4. 深度参与零部件早期失效、随机失效、老化失效等不同类型失效问题的分析和闭环；","requirement":"1. 硕士及以上学历, 车辆工程、能源与动力工程、电气工程、机械工程、仪器科学与技术、材料科学与工程、可靠性等相关专业；\n2. 研究课题领域包含动力及热管理零部件以下方向的某一类：可靠性工程、产品设计、仿真计算、试验设计、基于数据的载荷分解提取；\n3. 熟练掌握可靠性理论并实践应用、擅长机械/热/电载荷下零部件寿命计算方法并有应用经验者优先；\n4. 责任心强，勤奋踏实，积极主动，有创新力，良好的沟通，团队合作及英语水平。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025067033,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670918570080127259","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanj