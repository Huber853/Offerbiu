{"code":0,"data":{"job_post_detail":{"id":"7670924160045992246","title":"产品经理-汽车座舱/APP","description":"1、参与小米汽车智能座舱产品的需求调研、竞品分析与用户研究，输出产品洞察报告\n2、协助完成座舱功能（系统/驾驶/影像/车控/娱乐/出行/人车家等模块等）产品方案设计，撰写PRD并推动评审\n3、跟进座舱功能从开发到验收的全流程，协调研发、设计、测试等角色确保按期交付\n4、参与内测体验分析，收集用户反馈，提炼体验问题并推动优化闭环\n5、跟踪行业动态与竞品座舱功能迭代（智能语音、车机交互、多屏联动、AI大模型上车等），形成竞品周报\n6、支持产品运营相关数据分析，协助建立座舱功能的数据监控体系","requirement":"1、本科及以上学历，计算机、人机交互、工业设计、电子信息、车辆工程等相关专业优先\n2、对智能座舱/智能汽车/消费电子产品有浓厚兴趣，有相关实习或项目经历者优先\n3、具备良好的逻辑思维和结构化表达能力，能清晰拆解复杂问题\n4、自驱力强，对细节敏感，具备快速学习新领域知识的能力\n5、加分项：有AI/大模型产品体验、语音交互设计、HMI设计、数据分析经验","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026339580,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670924160039061802","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],