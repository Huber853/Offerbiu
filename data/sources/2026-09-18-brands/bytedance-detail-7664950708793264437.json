{"code":0,"data":{"job_post_detail":{"id":"7664950708793264437","title":"后端开发工程师 - 中国交易与广告","description":"团队介绍：中国交易与广告，负责抖音电商、生活服务、广告营销等营收业务的研发。用技术带来美好生活，让用户发现更多优价好物，为用户提供更丰富独特的生活体验；连接海量用户与商家，促进交易达成，让生态里全流程体验更流畅，助力营收业务长效增长。\n加入团队，你将投身流量与增长主战场，挑战复杂业务场景技术难题；直面真实商家和用户，用技术解决看得见的问题，在实战中快速成长，书写属于你的价值故事！\n\n1、负责电商业务相关后台研发，探索字节跳动平台（抖音、抖音火山版、西瓜视频、今日头条等）全域兴趣电商模式，承担系统的设计开发维护工作；\n2、负责高质量的设计和编码，承担重点、难点的技术攻坚；\n3、负责在线大流量高并发系统设计和性能调优；\n4、参与产品讨论和开发实现。","requirement":"1、2027届获得本科及以上学历，计算机相关专业；\n2、学习能力强，有独立解决问题的能力；\n3、熟悉面向对象编程，掌握Java/C++/Python/Go中的至少一门语言，Java/Go背景优先；\n4、有良好的沟通能力和业务理解能力。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784635497581,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A10695","job_id":"7664949991756663093","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_lis