{"code":0,"data":{"job_post_detail":{"id":"7668275336506476805","title":"算法工程师 - Seed","description":"团队介绍：产品研发和工程架构-Seed 团队深耕大模型技术在场景中的创新应用，负责多款现象级AI产品的工程研发 —— 包括豆包、飞书、豆包工作、豆包爱学、Gauth、猫箱等创新产品，覆盖消费级与企业级多个场景。我们致力于将大模型能力从 \"生成内容\" 推进到 \"完成工作\"，让 AI 服务用户日常与企业协作。你将面对多模态交互、工具调用可靠性、企业级数据安全等真实工程挑战，与团队一起推动 AI 生产力落地。\n\n1、参与字节跳动豆包办公与飞书AI业务相关研发工作，打造以人工智能技术为亮点的产品功能；\n2、参与产品功能中通用Agent、办公套件领域的效果优化；\n3、参与评测集构建、自动化评测、模型训练、Skill优化等算法效果研发任务。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、良好的编码能力，良好的数据结构与算法基础，掌握Python、C/C++、Golang等编程语言之一；\n3、熟练使用AI Coding工具，比如TRAE、Codex、Claude Code等；\n4、了解大模型前沿技术，具备Agent落地经验者优先。","job_category":{"id":"6704215956018694411","name":"算法","en_name":"Algorithm","i18n_name":"算法","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785409491623,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A96644B","job_id":"7668274396583151925","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefro