{"code":0,"data":{"job_post_detail":{"id":"7667167697989552389","title":"安全检测工程师 - 安全与风控","description":"团队介绍：我们通过部署先进的安全系统、推行标准化操作流程，构建基于零信任的安全防护体系，提升字节跳动全球办公环境的整体安全态势。我们坚持以主动预防为核心，同时构建敏捷高效的安全响应能力，为全球办公环境提供持续、可靠的安全保障。\n\n1、研究内部威胁场景和典型行为链路，设计规则、检测假设和风险特征；\n2、分析IAM、终端、代码平台、云盘、数据库等日志，验证数据完整性和日志语义；\n3、将调查经验转化为规则、标签和模型特征；\n4、分析告警和案件，持续优化检测策略，建设检测覆盖矩阵和攻击模拟能力。","requirement":"1、2027届获得本科及以上学历；\n2、理解身份、权限、终端、代码、数据和云平台安全；熟悉SQL，并掌握至少一种编程或脚本语言；\n3、能够分析用户、设备、资源和权限之间的关系；\n4、具备基本的数据分析和机器学习知识；\n5、能够与算法和平台工程师协作。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785151643796,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A150690","job_id":"7667167557801822517","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_l