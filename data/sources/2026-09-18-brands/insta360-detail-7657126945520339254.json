{"code":0,"data":{"job_post_detail":{"id":"7657126945520339254","title":"嵌入式工程师-2027校招","description":"1、根据项目需求开发嵌入式 Linux 驱动、系统软件及启动相关功能；\n2、负责 Linux 驱动和系统移植、启动流程及 Linux 平台化通用能力建设；\n3、参与产品软硬件联调，分析并解决开发过程中的问题；\n4、负责编写软件设计文档，参与需求分析和讨论，学习新领域产品技术并探索验证。","requirement":"1、全日制硕士(含)以上学历，计算机、电子、通信、自动化、集成电路及相关专业；\n2、熟练掌握 C 语言，了解 C++ / Python，熟悉操作系统、计算机组成、数据结构；\n3、熟悉嵌入式 Linux 开发环境，有嵌入式  Linux 相关课程设计、竞赛或实习经历；\n4、熟悉UART / I2C / SPI 等常见总线，熟练使用示波器或逻辑分析仪进行调试；\n5、有 Linux 内核模块、设备树、驱动开发，或 USB / 电源 / 存储等方向实践者优先；\n6、做事积极负责，对于嵌入式linux底层方向有极大的兴趣者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782814225259,"channel_online_status":1,"job_id":"7657126945520191798","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}