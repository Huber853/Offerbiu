{"code":0,"data":{"job_post_detail":{"id":"7669684790506211589","title":"漫剧产品运营 - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、以搜索转化为核心目标，支持搜索各项评估，动态优化策略并保障落地；\n2、参与各场景内容模型的准召评估，能够根据对内容和体裁的理解提出优化建议；\n3、协助搭建内容分类体系，提升内容分发效率，降低用户找剧难度；\n4、深入洞察用户，站在用户视角结合数据，发现业务关键问题并做出合理假设；支持日常运营工作，协助推进运营数据分析与策略迭代，通过定期复盘业务数据及用户反馈，持续优化运营方案。","requirement":"1、2027届获得本科及以上学历；数学、计算机、统筹学相关专业优先；\n2、具备优秀的内容理解能力及逻辑思维能力；自驱力强，拥有良好的用户视角、出色的沟通协作能力和执行力；\n3、具备基本的数据处理和分析能力；\n4、对网文、漫剧、短剧等内容感兴趣，对AI行业发展有好奇心。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785737736834,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A205653","job_id":"7668204662978660661","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name