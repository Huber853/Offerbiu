{"code":0,"data":{"job_post_detail":{"id":"7671294190080379146","title":"技术规划项目管理-汽车","description":"1、负责小米汽车核心预研项目的管理与交付协调；\n2、负责预研技术管理工作、组织预研技术决策、管控各部门预研技术问题改进状态；\n3、负责项目目会议的组织、项目任务的追踪和闭环、识别并管控项目风险、并监控各部门目标达成状态；\n4、负责工程设计变更的评审组织、状态管控；\n5、负责各专业零部件开发业务相关管理（方案选型、技术协议、商务定点、工程样件认可等）；\n6、负责阀点交付物管控、评审组织与问题落实；\n7、负责跨部门问题及资源的协调。","requirement":"1、熟悉整车开发相关知识，对于行业内新技术及学术界新方向有敏感性，对技术落地要求及路径有认知；\n2、大学本科及以上学历；\n3、具备优秀的沟通能力、问题分析能力、持续学习能力，以及良好的主动工作习惯和职业素养。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112501239,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473497709","name":"管理类","en_name":"Management","i18n_name":"管理类"},"job_id":"7671294190080248074","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],