{"code":0,"data":{"job_post_detail":{"id":"7670923466132408614","title":"AI 运维工程师","description":"1、负责小米AI平台业务的相关运维工作；\n2、工作涵盖容量管理、灾备管理、活动重保、日常Oncall、troubleshooting、业务巡检、故障预案、架构优化、技术运营等，做到7*24小时快速响应；\n3、与DEVS共同设计产品后端架构，实现分布式、全球集群化运维管理，制定并实施相关运维技术方案，确保服务高效、稳定的运行；\n4、研发设计自动化运维工具，减少日常重复性工作，用DevOps工具化思维解决业务问题，提升运维效率；\n5、通过技术手段进行成本控制及优化，通过工具化及流程提升服务管理效率。","requirement":"1、本科及以上学历，理解操作系统基本原理，具备较好的计算机网络和体系结构基础；\n2、熟练使用Linux系统，熟悉Python/Go/Shell等至少一种主流编程语言；\n3、良好的逻辑思维和分析能力，热衷于解决问题、追求极致；\n4、强烈的责任心、进取心、团队合作精神和owner意识。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026118307,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670923466132228390","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wu