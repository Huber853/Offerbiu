{"code":0,"data":{"job_post_detail":{"id":"7663064541588228405","title":"质量策略运营 - 内容质量与数据服务平台","description":"团队介绍：CQC（中国内容质量与数据服务平台）归属于抖音集团，负责今日头条、抖音、西瓜视频等产品内容和抖音集团商业内容的安全质量与体验，支持各产品的运营和增长，以及为产品线提供AI算法算力的基础支持服务。\n\n1、通过建设多场景多能力的质量策略，满足产品质量需求，并根据需求变化持续迭代；\n2、负责执行质量控制活动，制定质量标准，确保交付的数据符合产品需求；\n3、根据业务现状调整内容治理策略，根据数据发现业务中存在的问题并且跟进解决，保障业务能够更高效地发现质量问题；\n4、对各项业务指标的达成负责，包括但不限于内容治理人力成本管理、效率管理、质量管理等。","requirement":"1、2027届获得本科及以上学历；\n2、了解内容风控内容治理的链路逻辑，有内容风控行业实习经验优先；\n3、有一定的数据敏感性，具备较强的数据分析和复盘总结能力，善于系统性解决问题；\n4、较强的自主学习能力与自驱力，有同理心、责任感和团队合作精神。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_22","name":"成都","en_name":"Chengdu","i18n_name":"成都"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784196261500,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A34420A","job_id":"7663063077177084213","city_list":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_ty