{"code":0,"data":{"job_post_detail":{"id":"7670918768210643210","title":"整车硬件开发系统产品经理-汽车","description":"1.负责对整车属性开发、协同设计等领域数字化系统的产品需求挖掘和分析； \n2.负责产品功能定义与需求定义，撰写产品需求文档，并跟进实施落地，参与功能验收测试； \n3.负责项目进度和项目质量管理，确保产品需求合理拆解与排期，跟进交付的关键节点； \n4.负责硬件开发系统的运维支持、用户培训及运营，协助更新维护操作指南及发版说明；\n5.负责产品数据分析与指标定义，对系统的业务和用户数据进行统计分析以及产品化呈现。","requirement":"1.汽车工程、机械设计、计算机、通信、自动化、产品设计等相关专业； \n2.具备自我驱动能力，积极学习汽车专业知识，具备互联网思维和用户思维，紧跟行业趋势，善于创新；\n3.有良好的沟通与协调能力，团队协作意识强，能够快速理解业务需求；\n4.参与过产品项目设计，了解敏捷开发方法论，善于解决复杂问题，有产品运营经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025089473,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670918768210413834","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY000000