{"code":0,"data":{"job_post_detail":{"id":"7670918737407838515","title":"整车工艺工程师-汽车","description":"1.负责负责新车型产品导入前的钣金软模零件开发，试制生产线规划，设备的调研及实施导入等；\n2.负责试制新项目的工艺开发（规划工艺、工艺流程图、操作指导书等），车身装焊验证及工艺优化；\n3.负责制定项目计划，推动制造团队完成项目各节点要求;\n4.负责新车型试制的质量提升活动,工艺验证开发,工装夹具设备验证及优化,BOM材料及零部件状态及需求确认等;\n5.负责协调各相关部门解决新车型试制生产问题;\n6.负责领域新设备新技术及数字化的应用的研究和开发;\n7.负责车身油漆工艺过程开发和策划。","requirement":"1.汽车、机械相关专业，本科及以上学历；\n2.对试制车身油漆或者总装电池等工艺感兴趣或有过相关学习和实习经验；\n3.能熟练使用OFFICE，有试制相关软件（CATIA/AUTOCAD等）能力的优先； \n4.良好的沟通表达能力，逻辑思维能力强；良好团队合作精神；较强的学习创新能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025275764,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7208442611194445933","name":"生产制造类","en_name":"Manufacturing","i18n_name":"生产制造类"},"job_id":"7670918737407658291","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","m