{"code":0,"data":{"job_post_detail":{"id":"7670924324123527460","title":"车载Audio软件工程师-汽车","description":"1.参与车载音频系统的开发、调试与优化工作；\n2.协助完成音频 HAL 层、中间件，DSP等代码实现；\n3.参与音频路由、混音、多通道音频处理等核心功能的开发;\n4.编写和维护音频相关模块的技术文档；\n5.配合测试团队进行音频功能验证及问题定位；\n6.跟踪并研究行业前沿音频技术，提升车载音频体验。","requirement":"1.本科及以上学历，电子信息工程、通信工程、计算机科学、自动化、人工智能等相关专业；\n2.熟悉 C/C++ 编程语言，有良好的编程习惯；熟悉 Linux/Android/Rtos/QNX等系统，了解基本的系统架构；\n3.了解音频相关基础知识者优先，如音频编解码格式、数字信号处理等；\n4.有嵌入式开发经验者优先，熟悉 ALSA、AudioFlinger、HAL 层开发者，流媒体，音频编解码优先；\n5.具备良好的沟通能力和学习能力，责任心强，能承受一定压力；\n6.有意向毕业后从事车载音频系统开发方向者优先考虑。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026371950,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670924324123347236","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_ty