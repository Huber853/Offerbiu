{"code":0,"data":{"job_post_detail":{"id":"7669721709076678917","title":"游戏GamePlay开发工程师 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、负责角色、输入控制、相机、移动物理及同步、技能等模块的开发与相关技术研究；\n2、负责枪械武器手感、角色动画表现力、武器组装的设计和提升；\n3、负责游戏性能优化相关工作，针对需求定制增改UE5底层功能；\n4、开展全平台兼容性分析、疑难问题定位及性能适配方案制定工作；\n5、与策划及美术团队深入合作，实现业界领先的手感和表现效果。","requirement":"1、2027届获得本科及以上学历；\n2、熟悉C/C++，具备扎实的数学、图形、数据结构和算法基础，熟悉常用设计模式；\n3、熟悉角色、输入控制、相机、移动物理及同步、技能等模块，并有相应开发经验；\n4、熟悉动画、GAS等底层架构，并具有相应开发经验；\n5、熟悉3D游戏性能和内存优化；\n6、热爱游戏及开发工作，自驱力强、责任心强、善于沟通，对射击品类有一定技术研究者优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746320143,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A203645","job_id":"7660420759773350197","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list