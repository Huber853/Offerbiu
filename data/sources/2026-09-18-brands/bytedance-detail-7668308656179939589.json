{"code":0,"data":{"job_post_detail":{"id":"7668308656179939589","title":"安全研发工程师（AI For渗透测试） - 安全与风控","description":"团队介绍：负责公司大模型信息安全保障体系，持续识别和治理大模型衍生出的新型风险，并建设相应安全产品,保障大模型及其应用在训练、推理和部署等阶段的安全。同时将大模型相关技术应用到安全技术和安全运营领域，实现技术突破，做到效果和效率双提升。\n\n1、参与大模型应用于漏洞扫描、自动化渗透测试的研究与开发；\n2、参与漏洞扫描插件的编写和扫描能力的持续开发优化；\n3、负责公司安全漏洞事件应急响应相关工作；\n4、开展漏洞检测新技术的研究和开发工作。","requirement":"1、2027届获得本科及以上学历，计算机/软件/信息安全/人工智能等相关专业；\n2、有CTF比赛获奖经历、动态扫描工具（DAST、IAST等）开发经验、AI for Security相关项目实践经验者优先；至少熟练掌握以下一种或多种编程语言：Python、Go；\n3、熟悉各类漏洞原理、挖掘与防御；\n4、具备良好的逻辑思维能力、沟通能力、学习能力。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785417360472,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A04372A","job_id":"7668308341093615877","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"addre