{"code":0,"data":{"job_post_detail":{"id":"7667609460127516933","title":"用户研究分析师 - 经营办公室（用户研究）","description":"团队介绍：隶属字节跳动经营办公室，对接抖音集团各项业务，通过对用户、创作者、商家的定性、定量研究，针对业务关键发展方向暴露问题、探索解法、激发灵感，为各产品提供支持，帮助业务在各个阶段更加健康稳固的成长。\n\n1、协助完成各类用户研究工作，包括但不限于桌面材料梳理，用户访谈，焦点小组，可用性测试，问卷数据分析等；\n2、能灵活通过各种方式快速进行市场信息扫描与分析整合，高效为业务提供有价值的信息和建议；\n3、独立思考解决问题，深度参与研究项目的执行、推进、落地工作。","requirement":"1、2027届获得本科及以上学历，心理学、社会学、市场营销、广告等相关专业优先；\n2、对用户研究和互联网产品有强烈兴趣，能独立进行分析与判断；\n3、了解常用的用户研究方法，具备数据敏感性；\n4、学习能力强、善于思考和总结，能持续积极地学习并优化工作；\n5、英语能作为工作语言者优先。","job_category":{"id":"6709824272996501772","name":"用户研究","en_name":"User Research","i18n_name":"用户研究","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785254501647,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A258044A","job_id":"7662631588686317829","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"ci