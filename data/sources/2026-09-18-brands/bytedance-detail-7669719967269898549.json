{"code":0,"data":{"job_post_detail":{"id":"7669719967269898549","title":"游戏服务端开发工程师 - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、负责游戏服务器的功能开发以及维护；\n2、与策划人员配合，讨论设计文档，完成逻辑实现；\n3、解决游戏开发、线上问题，能够与运维沟通，保持游戏服务器稳定；\n4、实时了解服务器瓶颈，结合线上日志情况对服务器进行调优；\n5、确保游戏开发时间和质量，保证项目开发周期可控。","requirement":"1、2027届获得本科及以上学历，计算机专业或数学专业优先；\n2、熟练掌握Java、Go、C++中的一种或者多种，有良好的编程习惯；\n3、基础扎实，熟练掌握算法，数据结构相关知识，熟悉面对对象编程，具备合理运用设计模式的能力；\n4、了解常用的Linux命令；熟悉TCP/UDP协议；\n5、热爱游戏、深度体验过某一款游戏的同学优先。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745843211,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A124057A","job_id":"7661885896438794549","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"corre