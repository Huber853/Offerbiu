{"code":0,"data":{"job_post_detail":{"id":"7680771602925979957","title":"智能产品经理 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、参与生活服务客服产品整体需求分析和规划，设计产品原型，并撰写需求文档；\n2、具备一定数据分析能力，对产品运营数据进行追踪和分析，制定优化方案并推动产品持续迭代；\n3、负责用户调研、用户反馈收集，辅助决策及方案的输出，反哺产品上线迭代；\n4、与研发、运营等部门密切合作，推进产品的快速升级，保证产品按时、高质量上线。","requirement":"1、2027届获得硕士及以上学位，计算机、软件工程、经济学、管理学等相关专业优先；\n2、热爱产品，对使用的产品自己独特的思考和见解，有数据建模经验优先；\n3、具备较好逻辑思维能力及沟通协调能力；\n4、对数据敏感，具备良好的数据分析能力和意识，善于发掘背后数据的问题；\n5、具备较强的学习能力，能快速拓展自己的知识范围。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_22","name":"成都","en_name":"Chengdu","i18n_name":"成都"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788319219368,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A143755A","job_id":"7680772010309749045","city_list":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post