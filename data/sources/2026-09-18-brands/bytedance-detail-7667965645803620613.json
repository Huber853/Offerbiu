{"code":0,"data":{"job_post_detail":{"id":"7667965645803620613","title":"前端开发工程师（构建工具与编译器方向） - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、参与完善Rspack基础能力，将各项功能对齐Webpack；\n2、参与Rspack相关工具链及生态的开发和维护；\n3、参与提升Rspack构建性能，完善性能观测实验室，研发可跨平台共享的缓存体系；\n4、参与建设质量保障体系，保障项目升级不对上游的项目造成break，保障项目长期健康；\n5、与公司及社区内的伙伴合作，参与推进Rspack在业务项目及社区框架中的落地；\n6、跟进前端社区的变动，参与实践最新的前端技术并跟进到架构设计之中。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、熟悉社区中的主流构建工具，包括Webpack/Rspack/Vite等，有相关开发经验；\n3、有Rust/Go/C++/Node.js Native Addon开发经验，熟练掌握Rust语言者优先；\n4、持续关注全球技术社区中的主流技术、前沿领域和最佳实践；\n5、有自己的开源项目、技术产品或开源社区贡献经验优先。","job_category":{"id":"6704215886108035339","name":"前端","en_name":"Frontend","i18n_name":"前端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785337567035,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A83483A","job_id":"7667964373496023349","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_