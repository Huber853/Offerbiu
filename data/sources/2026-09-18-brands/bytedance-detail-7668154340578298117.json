{"code":0,"data":{"job_post_detail":{"id":"7668154340578298117","title":"数据分析师（国际化广告数据科学方向） - 国际化广告数据科学","description":"团队介绍：商业化产品数据科学团队致力于推动数据驱动的决策方式并成为这一理念的倡导者，我们的愿景是打造世界一流的数据科学团队，通过严谨的数据分析驱动业务决策，并以数据科学为核心动力推动国际化业务的商业化进程及可持续收入增长。\n\n1、负责商业变现业务数据科学工作，包括日常数据统计分析，针对异常情况协调资源进行跟踪和深入分析等；\n2、协助数据科学家对数据洞察以及定性和定量分析，迅速定位内部问题或发现机会；\n3、协助数据科学家进行数据科学体系建设和完善，挖掘流量、产品、策略方面的商业变现机会。","requirement":"1、2027届获得本科及以上学历；\n2、熟练使用SQL、Excel至少一种脚本语言，熟悉常用数据统计和分析方法；\n3、良好的沟通能力、团队合作精神和主动意识；\n4、良好的逻辑思维能力、业务解读能力和快速学习能力；\n5、对数字比较敏感，热爱数据科学工作。","job_category":{"id":"6704216224387041544","name":"数据分析","en_name":"Data analysis","i18n_name":"数据分析","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785381324925,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A85631A","job_id":"7668153500998027525","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[]