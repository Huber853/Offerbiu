{"code":0,"data":{"job_post_detail":{"id":"7670885425268410687","title":"交互设计师","description":"1.参与Xiaomi HyperOS设计系统的建设工作，持续提升小米手机、Pad产品等产品的操作体验一致性；\n2.参与编写人机设计指南、交互设计模式文档及组件库规范；\n3.负责设计系统落地业务中的反馈与跟进，根据用户反馈、测试和相关角色的有效意见改进设计；\n4.负责标准化设计相关统计，推动设计到研发的一致性程度提升。","requirement":"1.设计、人机交互、视觉传达等相关领域的学士学位及以上；\n2.对细节敏感，具备系统化思维和结构性表达能力；\n3.具备共赢精神，有过成功的项目合作经历；\n4.对新技术、新设计趋势有良好的洞察；\n5.对小米价值观认同并充满热情，勇于挑战。\n\n加分项：\n1.对 Xiaomi HyperOS 及其他智能设备OS等操作系统知识熟悉且感兴趣，有自主研究、分享等经验；\n2.在小米社区等操作系统社区活跃者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017309754,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473464941","name":"设计类","en_name":"Design","i18n_name":"设计类"},"job_id":"7670885425268214079","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_sta