{"code":0,"data":{"job_post_detail":{"id":"7667510780866070789","title":"技术战略 - 人力与管理部","description":"团队介绍：人力与管理部作为公司的职能部门之一，助力字节跳动从一家创业公司发展成为拥有超过十万名员工的全球化公司。人力与管理部以“释放人才成长力，激发组织生命力”为使命，在组织、人才、文化等方面持续像打造产品一样打造公司，推动业务成长。\n\n1、研究AGI/LLM相关的前沿技术领域动态，包括但不限于模型、AI软件算法、产品/应用及相关基础设施；\n2、对主流AGI公司的战略和竞争性动向进行深度研究，聚焦于其科技，产品，组织以及人才领域；\n3、组织管理层团队讨论，同步前沿技术发展情况，为关键决策提供战略支持；\n4、持续跟踪战略与管理举措的执行情况。","requirement":"1、2027届获得本科及以上学历，计算机科学、人工智能、数据科学、微电子学、自动化等理工类专业优先；\n2、科技领域战略管理咨询、投资、技术管理相关工作经验，具备较好的技术理解能力；\n3、对前沿新兴科技有高度好奇心，洞察力、结构化思维、逻辑性、学习能力强；\n4、自驱力强，能够主动发现问题并自主推进研究，善于从问题本质出发，从全局深度思考问题；\n5、良好的沟通能力和跨团队协作能力；\n6、中英文听说读写熟练，可作为工作语言使用。","job_category":{"id":"6704216386916321540","name":"人力","en_name":"HR","i18n_name":"人力","depth":2,"parent":{"id":"6704215913488451847","name":"职能 / 支持","en_name":"Corporate Function / Support","i18n_name":"职能 / 支持","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785231486399,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A175910A","job_id":"7667510011178486069","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job