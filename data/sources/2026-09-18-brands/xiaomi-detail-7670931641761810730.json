{"code":0,"data":{"job_post_detail":{"id":"7670931641761810730","title":"电机控制器应用软件工程师-汽车","description":"1.负责电驱动产品中的电机控制器应用层软件开发及测试相关工作；\n2.电机控制器复杂驱动、应用层、功能安全和信息安全相关软件开发；\n3.软件需求评估，模型建模，评审；\n4.软件模块和集成测试，编写开发技术文档；\n5.HIL/PIL测试，制定测试计划和测试策略，设计测试用例和脚本；\n6.应用层软件的台架和车辆匹配标定。","requirement":"1.电气工程、自动控制，汽车电子等相关专业硕士及以上学历；\n2.熟练使用汽车电子软件开发工具链以及相关流程和工具；\n3.具有英飞凌Aurix，ST或者其他主流单片机开发经验；\n4.精通电机控制算法，IGBT温度模型以及复杂驱动开发。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028135687,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670931641761646890","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list