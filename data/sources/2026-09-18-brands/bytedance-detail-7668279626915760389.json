{"code":0,"data":{"job_post_detail":{"id":"7668279626915760389","title":"抖音内容标准运营 - 抖音社区治理","description":"团队介绍：抖音致力于打造一个开放、积极、多元、友善的平台，鼓励表达、沟通和记录，激发创造，丰富人们的精神世界，让现实生活更美好。我们通过AI算法驱动的个性化推荐与智能创作工具，满足用户表达、学习、娱乐、社交、消费等需求。回顾抖音一路走来的历程，我们在帮助亿万用户记录美好生活的过程中，努力变得更好。抖音社区治理团队负责抖音的社区治理工作，包括视频、直播等多体裁的内容治理，以及安全产品中台能力建设。\n\n1、支持内容标准生产、迭代等演变的过程管理，研究分析违法违规、公序良俗、生态治理等内容风险类别和相关指标；\n2、针对标准的制定和应用，提炼总结标准运营管理原则与方法，同时协助管理应用；\n3、通过事件、舆论、调研等一系列反馈能具象分析内容风险的水位变化。","requirement":"1、2027届获得本科及以上学历，社会学、传播学、数据统计学相关专业；\n2、内容理解能力强、文字敏感度高，认真负责，主观能动性强，有团队协作意识；\n3、掌握一定的统计分析方法。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785410588748,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A56005A","job_id":"7667872985836472629","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","lo