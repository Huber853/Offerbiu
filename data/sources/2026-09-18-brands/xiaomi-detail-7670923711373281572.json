{"code":0,"data":{"job_post_detail":{"id":"7670923711373281572","title":"云计算开发工程师","description":"1. 一站式研发效能平台建设：整合全生命周期工具链，打通数据孤岛，构建可视化效能度量体系，为研发提效提供精准数据支撑；\n2. AI Native研发范式建设：落地智能编码、AI评审、智能测试等AI原生应用，推动研发模式从“工具辅助”向“AI驱动”升级，提升代码质量与交付效率；\n3. CI/CD与容器平台建设：构建基于Kubernetes的高可用容器化流水线，优化构建调度引擎与制品管理，完善发布编排与资源调度能力，支撑海量业务高频迭代的稳定交付与弹性伸缩。","requirement":"1 .计算机、软件工程或相关专业本科及以上学历；\n2. 具备扎实的编程基础，熟练掌握Java/Go/Python中至少一门语言，对数据结构与算法有良好理解；\n3. 对DevOps、云原生、AI工程化等领域有浓厚兴趣，有相关开源项目、实习经历或课程设计者优先；\n4. 具备优秀的逻辑思维与问题拆解能力，对“提升效率”有天然的敏感度和热情；\n5. 拥有良好的沟通协作意识，能够在跨团队项目中清晰表达技术方案并推动落地。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026196521,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670923711373101348","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","loc