{"code":0,"data":{"job_post_detail":{"id":"7670928942572390719","title":"供应商质量管理","description":"岗位描述：\n面向供应商的质量管理，通过供应商认证、供应商质量体系和制程审核、供应商协同及绩效管理、质量风险管理、供应商质量改善等关键行为，保证物料/制造工程类以及售后各项质量目标达成：\n1、供应商质量管理；\n2、供应商日常稽核与考核；\n3、物料异常处理、分析、反馈和改善；\n4、二级原材料器件的失效分析及改善；\n5、供应商二级材料供应商品质管控及品质持续改善；\n6、物料的PCN变更及物料品质不良的索赔等相关品质工作；\n7、新材料的导入验证以及新供应商品质能力、供货能力等综合考评。","requirement":"任职要求：\n1、正直诚信，真诚热爱；\n2、本科及以上学历，工科背景，光学类专业背景优先；\n3、具备较强的逻辑思维能力，较好的沟通能力和团队合作能力；\n4、有自驱力，高标准要求自己，心理素质强，抗压能力高；\n5、具有良好的英文听说读写能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027346104,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178743792710893677","name":"供应链类","en_name":"Supply Chain","i18n_name":"供应链类"},"job_id":"7670928942572226879","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","n