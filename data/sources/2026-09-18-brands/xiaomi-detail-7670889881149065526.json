{"code":0,"data":{"job_post_detail":{"id":"7670889881149065526","title":"光学工程师-手机","description":"1、小米期待屏幕光学工程师的加入，共同致力于OLED与柔性显示等新兴显示技术的图像质量提升；\r\n2、研究先进的显示技术，分析设计、工艺、光学效果、功耗、成本与可行性之间的权衡关系；\r\n3、与面板以及IC供应商合作，通过图像与信号处理突破面板的光学效果限制；\r\n4、与显示架构、原型设计、系统整合、测试以及调试等不同功能团队合作完成项目工作。","requirement":"1、本科及以上，有屏幕相关领域技术背景，如电子工程，材料科学，显示技术等相关专业；\r\n2、具备卓越的团队合作和沟通能力，能够和不同部门（研发、设计、市场等）协调工作；\r\n3、具备创新思维，分析用户需求和数据处理能力；\r\n4、具备半导体技术和图像处理相关知识者优先；\r\n5、参加过显示领域相关项目开发经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018310055,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670889881148918070","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{