{"code":0,"data":{"job_post_detail":{"id":"7670923392070125865","title":"大数据运维工程师","description":"1、我们为小米的站点稳定性提供系统和工具，是稳定性工程专家；\n2、实践DevOps和GoogleSRE的工程思想；\n3、站在软件生命周期全局考虑如何保障系统健壮性，稳定性，并通过软件工程技术为站点保驾护航；\n4、站在用户/工程师的角度提供易用的工具和平台产品，不断完善使用体验；\n5、负责集团基础软件/工具/平台的设计和研发，维护小米各项业务的稳定运行；\n6、按照优秀的工程实践完成需求，设计，编码，测试，发布的软件开发流程；\n7、按照标准编写设计/开发/运维/用户文。","requirement":"1、本科及以上学历，计算机或相关专业；\n2、熟练掌握Python/Golang语言及常用开发框架与工具，熟悉Linux开发环境；\n3、熟练掌握linux基础，了解分布式系统原理；\n4、有良好的分析和解决问题能力，对解决有挑战的问题充满热情；\n5、有强烈的上进心，自我驱动，学习适应能力强；\n6、了解和掌握Hadoop生态相关技能者优先。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026163872,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761246949179500","name":"运维类","en_name":"Maintenance","i18n_name":"运维类"},"job_id":"7670923392069945641","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_nam