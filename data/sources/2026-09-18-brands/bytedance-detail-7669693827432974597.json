{"code":0,"data":{"job_post_detail":{"id":"7669693827432974597","title":"内容策略运营 - 今日头条","description":"团队介绍：产品覆盖今日头条、头条极速版等各类产品，为上亿用户持续提供优质的资讯、视频等服务。我们通过建立良好的内容生态，鼓励优质的原创内容，为创作者提供优质的服务和创作体验，促进创作和交流，同时我们致力于通过尽可能丰富的内容体裁和尽可能多的分发方式，连接人与信息，丰富大家的精神生活，让人们看到更大的世界。\n\n1、分析刻画今日头条作者内容流量结构及供需关系，从数据角度理解和解释今日头条内容生态和供需变化；\n2、负责今日头条APP内容质量工作，制定并执行内容及账号的管控规则，为平台安全、内容质量和用户体验负责；\n3、负责今日头条垂类内容运营，结合平台用户特征，策划端内专题、话题活动等传播方案；\n4、与技术、产品协同，通过数据分析洞察，完善搜索场景推荐策略与推动持续迭代，提升搜索渗透。","requirement":"1、2027届获得本科及以上学历，社会学、统计学等相关专业优先；\n2、对内容型产品感兴趣，对作者与内容有自己的理解，有产品运营等相关实习经验的优先；\n3、具备严谨的逻辑思维能力，对数据敏感、善于从数据中发现问题，自驱力；\n4、解决问题注重过程和结果，关注细节。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785739786785,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A198023","job_id":"7667858932249151749","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_deliv