{"code":0,"data":{"job_post_detail":{"id":"7669698605365709061","title":"经营分析 - 抖音电商","description":"团队介绍：抖音电商以“总能发现好东西”为主张，致力于成为用户发现丰富好物的首选平台。众多抖音创作者通过短视频、直播、商城等丰富的形式，给用户提供更个性化、更生动、更高效的消费体验。同时，抖音电商积极引入优质合作伙伴，为商家变现提供多元的选择。\n\n1、协助策略团队展开经营分析、数据研究工作：包括但不限于周维度经营分析、行业的趋势分析及研究、数据收集整理与解读、业务指标分析等；\n2、参与业务指标体系和数据体系建设，协助数据监控看板建设和业务经营诊断报告输出，提供决策支持；\n3、协助推进分析建议在行业的应用推进，跟踪和复盘落地效果。","requirement":"1、2027届获得本科及以上学历，统计学、应用数学、计算机等理工科专业优先；\n2、对数据敏感，有较强的数据分析、数据整理能力，熟练使用SQL、Python等，有互联网数据分析、经营分析、商业分析实习经验优先；\n3、拥有较强的逻辑思维能力、自驱力和主动性，良好的团队沟通和合作能力，喜欢挑战性工作，工作激情饱满。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785740938331,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A167767","job_id":"7668621100525570309","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shangh