{"code":0,"data":{"job_post_detail":{"id":"7663428782733642030","title":"创意产品专员-2027校招","description":"参与Insta360 品牌周边与生活方式产品的规划与开发，基于用户洞察、品牌调性与市场趋势，推动产品从概念定义、开发落地到上市复盘的全流程管理，开发兼具功能性、设计感与传播力的生活方式产品。\n1、参与产品定义、功能方向与设计语言制定；\n2、规划与产品管理，制定阶段性产品路线图，推动功能服饰、周边系列化开发；\n3、参与项目协同，联动设计、供应链、市场等团队，推进打样、开发、量产与交付，确保项目按时落地；\n4、与市场团队紧密配合，提炼产品卖点，支持新品上市节奏、传播内容与 GTM 执行。","requirement":"1、本科及以上学历，服装设计、工业设计、材料工程等相关专业优先；\n2、有成功项目或爆款案例者优先；\n3、具备良好的审美力、产品规划能力、项目推进能力及跨部门协作能力；\n4、对科技品牌、年轻消费趋势及生活方式产品有持续关注，能够平衡创意表达与商业落地。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784281399653,"channel_online_status":1,"job_id":"7663428782733494574","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}