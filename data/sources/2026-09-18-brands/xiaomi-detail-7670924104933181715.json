{"code":0,"data":{"job_post_detail":{"id":"7670924104933181715","title":"内核开发工程师","description":"1、负责小米手机浏览器内核研发工作；\n2、负责Chromium内核的性能优化和功能改进；\n3、负责嵌入式 linux/RTOS 内核的定制，裁剪和优化；\n4、负责系统稳定性问题的排查，解决Watchdog、Kernel Panic、Subsystem Crash等系统性问题；\n5、跟踪最新的浏览器行业动向，新技术研究；\n6、和产品/测试/运营进行密切沟通，能够根据需求提出合理技术方案。","requirement":"1、本科及以上学历，计算机、软件或通信相关专业；\n2、熟悉C/C++语言编程，对C++11/14标准有较好的掌握，熟悉Linux环境；\n3、熟悉多线程编程技术，对常见的数据结构算法有一定的了解；\n4、熟悉计算机组成原理；\n5、熟悉RTOS 操作系统，熟悉嵌入式开发；\n6、有较强的快速学习能力，良好的分析和解决问题能力；\n7、有强烈的责任心和团队精神，善于沟通，自驱力强。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026206796,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670923711374461220","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"na