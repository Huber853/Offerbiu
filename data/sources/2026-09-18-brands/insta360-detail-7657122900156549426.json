{"code":0,"data":{"job_post_detail":{"id":"7657122900156549426","title":"天线工程师-2027校招","description":"1、根据产品需求进行天线方案及前瞻性技术评估，验证新技术在整机环境下的量产可行性与技术竞争力；\n2、负责项目中的天线全流程开发，包括天线架构设计、电磁场仿真、匹配电路调试、整机性能优化、生产制造问题解决等；\n3、参与天线领域的技术预研，如天线小型化设计、方向图调控等，并输出相关的技术预研文档；\n4、负责制定天线设计标准、测试规范及产测方案、天线仿真自动化等工作。","requirement":"1、本科及以上学历，电磁场与微波技术、无线电物理、通信工程、电子信息类相关专业，英语4级以上；\n2、扎实掌握电磁场与电磁波、天线原理、微波技术等基础理论；理解麦克斯韦方程组、传输线理论、S参数及Smith圆图；了解常见天线类型及其工作原理；\n3、具备良好的学习能力，责任心强，具备独立思考意识和钻研精神，拥有良好的团队协作能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782813021810,"channel_online_status":1,"job_id":"7657122900156369202","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}