{"code":0,"data":{"job_post_detail":{"id":"7670930676523321619","title":"保险产品经理","description":"方向一：\n1、参与制定车险及非车险业务发展规划，与需求部门对接负责车险及非车险产品的市场调研、用户需求分析、产品设计、产品迭代；\n2、与保险机构对接、保险招采、承保理赔流程、投保理赔运营管理；\n3、制定保险产品定制开发、上线、迭代管理制度、政策；主导建立和优化保险产品管理及运营系统模块； \n4、构建保险数据体系、经营分析体系、费率定价体系、赔付率预测体系，分析数据并撰写报告，为决策提供支持。 \n方向二：\n1、主导车险核心系统的产品设计工作，精准承接业务团队提出的车险需求，结合行业最佳实践，产出高质量的车险核心产品设计方案，确保系统满足业务需求和性能要求；\n2、深入研究车辆保险的业务发展方向，科学规划车险系统的迭代方向，推动系统持续优化升级；\n3、密切关注新技术发展趋势，积极探索新技术在车险系统设计中的应用场景，运用创新思维和技术手段。","requirement":"1、金融/保险专业优先，有相关行业实习经验优先；\n2、逻辑性强，学习能力强，沟通表达能力强；\n3、性格乐观，有较强的韧性，能承担压力较大的工作职责。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027874416,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670930676523157779","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","