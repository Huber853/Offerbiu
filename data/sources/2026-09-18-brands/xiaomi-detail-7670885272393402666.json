{"code":0,"data":{"job_post_detail":{"id":"7670885272393402666","title":"软件研发工程师","description":"1.参与业务系统的设计、开发与维护，负责功能模块的编码实现；\n2.根据需求文档完成技术方案设计，编写高质量、可维护的代码；\n3.协助团队完成代码审查、性能优化及技术问题排查；\n4.学习并掌握新技术栈，配合团队完成技术升级与创新；\n5.参与项目全生命周期管理，包括需求分析、开发测试及上线支持。","requirement":"1.本科及以上学历，计算机科学、软件工程、电子信息等相关专业；\n2.扎实的编程基础，熟悉算法与数据结构，掌握至少一门主流语言（如C++/Java/Python等）；\n3.了解Spring、MyBatis等主流开发框架，有简单项目实践经验优先；\n4.熟悉MySQL等关系型数据库，掌握SQL编写及基础优化；\n5.了解前端技术（HTML/CSS/JS）或常用工具链（Maven/Git）者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017273957,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670885272393206058","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_objec