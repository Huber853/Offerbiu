{"code":0,"data":{"job_post_detail":{"id":"7670919803402586414","title":"内饰集成工程师-汽车","description":"1. 负责协助内饰部门负责人完成内饰领域的项目开发管理工作；\n2. 负责独立完成内饰零部件的开发计划管理，开发风险识别；\n3. 配合项目经理完成各个阶段零部件的开发评审，问题跟进；\n4. 负责内饰开发中流程管理及优化，针对内饰各项变更EWO进行管控；","requirement":"1. 本科及以上学历，机械工程、车辆工程、材料工程等相关专业；\n2. 熟悉CATIA、等3D CAD软件操作，具备基本的机械设计与制图能力；\n3. 了解注塑、发泡、包覆等内饰工艺，熟悉材料基本性能；\n4. 具有良好的沟通协调能力和团队协作精神，能适应多项目并行开发节奏；\n5. 具备较强的学习能力与责任心，愿意深入现场解决实际问题；\n6. 有汽车相关实习经历、大学生方程式竞赛或结构设计竞赛经验者优先；\n7. 英语CET-4及以上，能阅读英文技术标准；\n8. 对新能源汽车有行业看法，对汽车有热衷，有责任心，认可小米汽车；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025306338,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919803402422574","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n