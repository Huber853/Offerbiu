{"code":0,"data":{"job_post_detail":{"id":"7663391354383124779","title":"跨境电商运营管培生（英语 ）-2027校招","description":"1、负责公司产品在跨境电商渠道（亚马逊/乐天/shopee/lazada等）的店铺运营工作，完成销售目标（具体渠道在入职后根据业务需求匹配）； \n2、结合平台大盘数据走向、产品和消费者人群特征、用户使用场景变化趋势等，对市场/竞争对手/业务问题进行深入分析，调整优化运营推广策略； \n3、监控所负责平台各业务板块的运营指标，如流量结构变化、产品转化率变化、VOC等，对运营数据进行整理分析，输出运营优化方案和业务洞察； \n4、与市场/设计部/产品部协同组织策划促销活动、新品上市等重要项目，并进行复盘总结，经验沉淀； \n5、对于电商行业动态及趋势保持高敏感度，迭代优化运营工作。","requirement":"1、语言类/商科/数据分析/理工类等专业，本科或以上学历，英语可作为工作语言，掌握小语种加分（如日语、德语、西语等）； \n2、出色的Stakeholder管理、沟通和跨团队协作能力，自驱力强，强结果导向；\n3、有较强的思维逻辑、学习能力、责任心和抗压能力； \n4、对海外市场、文化及消费者特性感兴趣。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784272537132,"channel_online_status":1,"job_id":"7663391354382977323","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}