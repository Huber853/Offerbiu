{"code":0,"data":{"job_post_detail":{"id":"7667551281497737525","title":"安全攻防工程师（AI+云） - 安全与风控","description":"团队介绍：我们团队为字节跳动旗下各类业务线提供信息安全保障。通过与各业务团队紧密协作，我们针对其特定的运营及业务需求，设计并落地专属安全策略。依托安全部门的专业能力，我们交付与业务目标高度契合、兼具成本效益与可扩展性的安全解决方案，助力各团队获取最高效、最可靠的安全服务与工具。\n\n1、参与字节跳动云产品和基础设施的风险评估和挖掘；\n2、安全风险的治理跟进；\n3、安全扫描能力开发。","requirement":"1、2027届获得本科及以上学历；\n2、熟练掌握常见Web、系统、Agent安全漏洞原理、利用方式以及对解决方案有较深入理解；\n3、精通Web攻击方法，能独立研究发现新的漏洞；\n4、熟悉白盒审计，能对Go、Python、Nodejs、Java等代码进行审计；\n5、具备一定的开发能力和AI、Agent使用经验，能将重复的工作自动化；\n6、热爱安全、有探索精神，耐心、责任心强，具备沟通能力和良好的团队意识。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785240912216,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A18111","job_id":"7667551182906935605","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_