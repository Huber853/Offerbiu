{"code":0,"data":{"job_post_detail":{"id":"7664506693116692774","title":"海外公关专员-2027校招","description":"1、参与公司海外品牌传播及公关项目的规划与执行，支持重点市场品牌影响力建设及传播目标达成；\n2、协助开展海外媒体关系管理、传播资源拓展及日常沟通，支持公司重点业务和品牌项目传播；\n3、参与新闻稿、媒体沟通材料、品牌内容及传播方案的策划与撰写，提升传播内容质量与影响力； \n4、开展行业研究、市场洞察及传播效果分析，为品牌传播策略优化提供支持；\n5、与市场、产品及区域团队协作，推动跨部门传播项目落地，并支持海外舆情监测及声誉管理相关工作。","requirement":"1、2027届本科及以上学历，新闻传播、公共关系、市场营销、英语、国际关系等相关专业优先；\n2、英语听说读写能力优秀，能够作为工作语言进行书面及日常沟通；\n3、对海外市场、国际传播、品牌营销或科技行业有浓厚兴趣； \n4、具备优秀的信息搜集、分析及内容撰写能力，逻辑清晰，表达准确； \n5、具备良好的跨文化沟通能力和团队协作意识；\n6、学习能力强，责任心强，能够适应多任务及快节奏工作环境； \n7、有硬件科技公司、出海企业等相关实习经历者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784532281377,"channel_online_status":1,"job_id":"7664506693116545318","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}