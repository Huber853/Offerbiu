{"code":0,"data":{"job_post_detail":{"id":"7670931105016908075","title":"数据分析师","description":"岗位描述：\n1、负责与产品沟通确定数据分析需求，并给出需求评估意见；\n2、基于业务需求设计合理的数据分析报表和实施方案；\n3、负责数据分析项目的开发和交付，保证项目按时保质上线；\n4、验证和评审外部实施团队的技术方案、开发规范等，保证项目风险可控；\n5、负责监控数据仓库系统运维，及时解决用户问题，确保模块的稳定可靠；\n6、根据业务现状，提出优化方案并推动落地。","requirement":"任职要求：\n1、本科及以上学历，计算机技术/信息管理/软件工程/数学/统计/物理相关专业优先；\n2、良好的逻辑思维能力，丰富的数据分析经验，有机器学习建模经验优先；\n3、精通Python/SAS/R 和 SQL等数据分析、处理语言/工具；\n4、沟通能力强，并且可以推动项目快速落地；\n5、学习能力强、具有团队合作精神和强烈的进取精神；\n6、具有良好的沟通表达能力及书面表达能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027964114,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670931105016744235","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MD