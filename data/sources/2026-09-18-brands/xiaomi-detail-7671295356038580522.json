{"code":0,"data":{"job_post_detail":{"id":"7671295356038580522","title":"相机项目经理","description":"1. 负责手机相机项目开发进度、风险及流程管控；\n2. 根据相机开发文档进行需求拆解、任务量化，组织和制定开发计划文档；\n3. 即时反馈阶段性项目成果，对项目进行全程跟踪，确保项目按计划落地；\n4. 负责相机项目问题管理和风险管理；\n5. 通过周报及项目日常汇报及时反馈项目状态，并组织相关的项目沟通会议。","requirement":"1. 本科及以上学历，理工科专业，对软件工程有一定程度的了解。\n2. 具有较强的英文读写能力，有口语交流能力者佳。\n3. 良好的语言表达能力及沟通能力，强烈的责任心与学习能力。\n4. 有在校项目管理组织经验者佳。\n5. 有光学方面背景经验优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112723548,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7671295356038416682","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_pro