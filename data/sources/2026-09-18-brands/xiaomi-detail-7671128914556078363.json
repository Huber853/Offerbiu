{"code":0,"data":{"job_post_detail":{"id":"7671128914556078363","title":"天线工程师-手机","description":"1.负责产品天线的前期方案评估，实现和验证等相关工作； \r\n2.按时保量完成项目的天线设计及验证工作； \r\n3.对于项目中问题点能够给出分析和解决意见； \r\n4.数据处理，给出有意义的报告和结论； \r\n5.天线相关的工厂支持； \r\n6.发掘天线新技术相关方向，并协助高级别工程师完成预研工作。","requirement":"1.电磁场.通信相关专业本科及以上学历； \r\n2.具有扎实的电磁场微波理论基础，熟悉数字通信基本原理； \r\n3.具有较强的动手能力，熟悉频谱仪.矢量网络分析仪等射频仪表的使用； \r\n4.熟悉常用的EDA设计工具，熟练运用射频仿真工具进行电路分析与设计； \r\n5.学习能力较强。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786073922672,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671128914555914523","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"