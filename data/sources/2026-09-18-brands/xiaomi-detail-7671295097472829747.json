{"code":0,"data":{"job_post_detail":{"id":"7671295097472829747","title":"电池研发工程师（结构方向）","description":"1. 负责电池行业领先Pack封装技术专项看护；\n2. 负责手机架构、结构与电池相关设计拉通，重大问题攻关解决；\n3. 负责电池结构设计标准维护和优化；\n4. 负责电池相关设计预研、项目开发设计评审看护；\n5. 协助售后问题技术攻关。","requirement":"1. 本科及以上学历，电化学、机械类、材料成型类等相关专业；\n2. 具有扎实的结构设计、塑胶模具、五金模具等相关基础知识，熟悉锂离子电芯、手机研发流程，同时具备手机结构设计和Pack 结构设计工作经验者优先； \n3. 能熟练使用Pro e, Auto CAD 等绘图软件；\n4. 具备较强的力学分析和持续学习能力，具备较强的FA分析或者力学仿真能力；\n5. 有较好的团队合作能力，主观能动性强，沟通能力和统筹能力。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112627869,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671295097472682291","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"co