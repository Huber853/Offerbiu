{"code":0,"data":{"job_post_detail":{"id":"7670885566489659674","title":"区域客服运营","description":"1.站点运营监督与指标交付\n监测各区域客服运营，搭建数据监测体系。根据业务变化调整运营策略，确保关键指标达成；建立风险预警机制，如旺季人力调配，保障服务质量；\n2.客户体验提升\n剖析用户案例，挖掘痛点需求。从服务流程、话术等多维度优化体验，收集区域侧反馈转化为改进措施；\n3.跨部门协作与问题解决\n联动产品研发、销售、物流、售后等部门，解决客服运营各类问题，提升用户满意度；\n4.数据跟踪与分析\n跟踪客服响应时间、问题解决率等运营数据，挖掘问题与机会，以数据驱动运营决策，提升服务效率与质量；\n5.新建站规划及跟进\n调研市场，制定建站方案，把控项目进度，保障新建站服务顺利开展及按时交付。","requirement":"1.具备良好的英语听说读写能力，可使用英语开展日常工作沟通、文档处理与业务协作；\n2.具有良好的沟通能力和协同能力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017264501,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670885566489495834","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status