{"code":0,"data":{"job_post_detail":{"id":"7668296797446244661","title":"抖音高热研判编辑 - 抖音内容运营","description":"团队介绍：致力于通过热点内容管理、平台沟通与信任建设、编辑与研判等手段，持续为打造健康繁荣的抖音内容生态护航，提升用户内容消费体验。同时我们希望以创新的智能内容挖掘与理解为手段，针对低质、争议、谣言、虚假等问题展开治理，营造一个良好的内容消费氛围。\n\n1、对社区内的高热度内容进行研判，识别并判断出符合平台需求的调性与品质内容；\n2、负责对平台高热度内容的质量把关，从舆情、用户和生态等多维度视角观测内容质量和内容风格，发现潜在隐患；并对高热度内容质量相关研判案例研究、数据进行周期性分析与总结；\n3、发现潜在问题及异常现象或数据，及时定位并分析完成研判报告。","requirement":"1、2027届获得本科及以上学历；\n2、对内容具有敏锐的感知，有一定内容审美、发现热点的眼光，同时具备发现问题、分析问题的能力，能发现高热内容可能存在的潜在风险；具备较强新闻敏感性，对时事热点有兴趣和研究；\n3、对新产品、新技术保持高度的好奇心和探索欲，工作细致耐心，责任心强，有团队合作精神。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785414735445,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A112968","job_id":"7668157108211058997","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"