{"code":0,"data":{"job_post_detail":{"id":"7667875532790155525","title":"生态后端开发工程师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责火山引擎/飞书生态平台的业务实现、系统重构及效能提升；\n2、业务实现：根据产品需求进行To B系统分析及设计，输出技术文档，完成系统开发、自测、联调、上线及缺陷解决；\n3、系统重构：自驱推动现有系统的拆分及重构，降低偶然复杂性，提升系统容错性、扩展性、易用性；\n4、效能提升：深入理解业务并做技术抽象，创新性的引入或自研各种通用平台及工具，以提升研发团队整体战斗力。","requirement":"1、2027届获得本科及以上学历；\n2、具有良好的沟通、团队协作能力、推动和落地能力，比较强的负责人意识，有项目的代码开发、系统设计、问题解决相关经验；\n3、有Harness工程具体案例实操经验，且在提升研发效率与代码质量方面有确切产出；\n4、具备良好AI协同能力，敢于提出问题、确定方向，并对AI产出结果有自主判断能力。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785316432912,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A200447","job_id":"7667875527952255237","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],