{"code":0,"data":{"job_post_detail":{"id":"7668527393919437061","title":"网络工程师 - AI算力基础设施","description":"团队介绍：字节跳动基础设施部门，负责字节跳动的全栈算力基础设施，从芯片服务器产研、到超大规模数据中心，到传统云平台和如今的AI Native Cloud，全方位为抖音、豆包、今日头条、飞书、火山引擎等各类产品提供领先、稳定的百万量级大规模算力基础设施服务。我们的领域涵盖数据中心建设、内核操作系统开发、服务器集群管理、高速网络通信、EB级数据存储体系、搜索型数据库探索、基于LLM的AI基础设施的研发调度与治理等，致力于打造业界领先的、面向LLM的AI云原生基础设施架构与产品矩阵。\n\n1、负责抖音集团和火山引擎数据大规模AI集群网络设施的规划、设计和运维工作；\n2、参与大规模AI集群网络设施的自动化平台的设计和落地工作；\n3、负责公网和专线的带宽容量，资源排布等规划以及成本管理工作。","requirement":"1、2027届获得本科及以上学历，网络工程、通信工程和计算机等相关专业优先；\n2、具备一定的数据分析能力，掌握至少一门开发语言，如Python、Golang等；\n3、熟悉如TCP/IP、BGP等常用网络协议，有校园网建设和维护经验优先；\n4、具有CCIE/HCIE、RHCE或者同等能力证书优先。","job_category":{"id":"6704215958816295181","name":"基础架构","en_name":"Infrastructure","i18n_name":"基础架构","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785468194504,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A70644A","job_id":"7668526842144540981","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[]