{"code":0,"data":{"job_post_detail":{"id":"7670923909382310194","title":"尺寸工程师-汽车","description":"1、负责开发车身、总装、电池等各类工装夹具的定位方案（MCP），车身定位焊点、上件顺序的开发；\n2、参与制定整车尺寸控制策略；\n3、负责将尺寸控制策略落实到车身，总装及电池等工艺部门；\n4、负责产品开发阶段同步工程工作，优化结构和工艺，提升尺寸鲁棒性；\n5、参与车身、总装工装夹具的设计审核及验收工作；\n6、参与编制车身及总装工装夹具PFMEA、控制计划；\n7、负责尺寸方面前瞻技术的跟踪，研究和应用（车身及总装车间自动化安装）。","requirement":"1、汽车、机械相关专业，本科以上学历；\n2、了解尺寸链分析及公差分配能力；\n3、熟练掌握Catia、OFFICE等软件，熟悉了解冲压/焊接/总装工艺相关知识；\n4、具有较强的团队协作能力，易沟通，抗压能力较强，能吃苦耐劳。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026234602,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178743792710893677","name":"供应链类","en_name":"Supply Chain","i18n_name":"供应链类"},"job_id":"7670923909382129970","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"tag_list":[],"storef