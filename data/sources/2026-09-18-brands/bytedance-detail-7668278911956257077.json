{"code":0,"data":{"job_post_detail":{"id":"7668278911956257077","title":"前端开发工程师 - Seed","description":"团队介绍：产品研发和工程架构-Seed 团队深耕大模型技术在场景中的创新应用，负责多款现象级AI产品的工程研发 —— 包括豆包、飞书、豆包工作、豆包爱学、Gauth、猫箱等创新产品，覆盖消费级与企业级多个场景。我们致力于将大模型能力从 \"生成内容\" 推进到 \"完成工作\"，让 AI 服务用户日常与企业协作。你将面对多模态交互、工具调用可靠性、企业级数据安全等真实工程挑战，与团队一起推动 AI 生产力落地。\n\n1、参与飞书文档及豆包办公创作产品的前端研发，打造自然、流畅的AI内容创作与协作体验；\n2、建设富文本、图形、表格、幻灯片等复杂编辑场景，持续优化渲染、性能和交互；\n3、解决超大型Web应用中的架构、实时协同和跨端一致性问题。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、熟悉JavaScript/TypeScript、HTML、CSS，了解React/Vue等主流框架；\n3、掌握常用数据结构与算法，了解浏览器、网络、性能优化和工程化基础；\n4、学习与动手能力强，关注AI技术发展，重视验证与结果质量；有AI项目或开源实践者加分。","job_category":{"id":"6704215886108035339","name":"前端","en_name":"Frontend","i18n_name":"前端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785410329197,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A204523","job_id":"7668277946646415669","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list"