{"code":0,"data":{"job_post_detail":{"id":"7674865705004976437","title":"产品经理（音乐） - TikTok","description":"团队介绍：TikTok是一个覆盖150个国家和地区的国际短视频平台，我们希望通过TikTok发现真实、有趣的瞬间，让生活更美好。TikTok在全球各地设有办公室，全球总部位于洛杉矶和新加坡，办公地点还包括纽约、伦敦、都柏林、巴黎、柏林、迪拜、雅加达、首尔和东京等多个城市。\n\n1、深入业务一线研究音乐的应用场景，并通过高效的产品化工具来沉淀音乐数据服务能力；\n2、理解音乐相关数据模型，通过数据分析、用户调研、反馈收集等手段发现用户需求和产品策略优化点，完成产品需求分析、方案设计、研发跟进和上线迭代；\n3、通过高效的跨部门沟通协作来把控项目节奏，跟踪行业动态与产品模式，为产品迭代提供方向。","requirement":"1、2027届获得本科及以上学历；\n2、对音乐行业感兴趣，视野开阔，有自己的音乐审美和品味；\n3、对产品工作有热情，有自己的产品价值主张，并且能够自洽的表达出来；\n4、英语流利，沟通能力强，结构化思维能力突出，对复杂问题的本质拥有足够的洞察力，良好的逻辑思维和学习能力，有好奇心和同理心。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786944244631,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A85846","job_id":"7674865577175845125","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_maj