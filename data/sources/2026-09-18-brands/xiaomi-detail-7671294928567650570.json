{"code":0,"data":{"job_post_detail":{"id":"7671294928567650570","title":"电池研发工程师（电芯方向）","description":"1.负责锂离子电芯新材料、新技术、新平台的开发及项目导入；\n2..负责锂离子电芯方案设计，样品制作跟进及验证；\n3.负责锂离子电芯材料选型，包括主材、辅材、电池配方等；\n4.负责研发阶段锂离子电芯失效异常的分析和改善；\n5. 负责锂离子电芯性能改善，如长寿命、高安全、低温充放电等；\n6.负责锂离子电芯充放电策略优化。","requirement":"1.应届毕业生，硕士及以上学历，电化学、化学及材料等相关专业;\n2.具有扎实的电化学、电池基础知识，熟悉锂离子电芯基本特性，具备电芯材料研发和分析能力；\n3.研究方向为锂离子电池、固态电池、硅碳负极、锂离子电池界面工程等；\n4.能熟练使用office办公软件、数据分析软件，熟悉电化学仿真软件；\n5.有较好的团队合作能力，主观能动性强。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112659325,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671294928567519498","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}