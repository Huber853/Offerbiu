{"code":0,"data":{"job_post_detail":{"id":"7663791003693959478","title":"组织文化专员-2027校招","description":"1、参与公司文化体系建设与运营，推动使命、价值观在组织中的落地与传播；\n2、策划并制作高质量文化内容，包括但不限于文章、视频、海报、PPT、活动方案等；\n3、参与公司级文化项目策划与执行，如文化活动、品牌传播、员工沟通、荣誉激励等；\n4、深入理解公司战略、业务与组织发展需求，通过内容和项目推动组织共识形成；\n5、与业务团队、管理者及员工保持密切沟通，洞察组织现象与员工需求，推动问题解决和组织改善。","requirement":"1、本科及以上学历，专业不限；\n2、具备优秀的内容能力和审美能力，热爱创作，能够独立完成文章、PPT、视频、海报等内容制作；\n3、对内容质量有较高要求，知道什么是好内容，并愿意持续打磨细节；\n4、具备较强的理解力和思考能力，能够快速理解公司战略、经营问题及组织文化体系；\n5、对人保持好奇和关注，具备良好的共情能力和洞察能力；\n6、具备优秀的执行力、组织协调能力、沟通能力和项目闭环能力；\n7、认同公司价值观，热爱组织文化工作，具备创业心态，敢于承担责任，追求极致。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784366347326,"channel_online_status":1,"job_id":"7663791003693812022","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}