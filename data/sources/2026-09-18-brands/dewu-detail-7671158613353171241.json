{"code":0,"data":{"job_post_detail":{"id":"7671158613353171241","title":"【27届校招】商家AI产品经理","description":" 1. 负责商家 AI 经营助手的需求调研、功能设计与迭代，将 AI 能力与商家经营场景深度结合；\n 2. 深入理解商家经营链路，识别可被 AI 提效的痛点与机会点，产出可落地的产品方案；\n 3. 重视商家调研与数据驱动，通过定性访谈和数据分析评估产品效果，持续优化产品策略和用户体验；\n 4. 跟踪 AI 技术趋势及电商行业 AI 产品动态，输出竞品分析报告，为产品方向提供决策依据。","requirement":"1. 2027届应届生，本科及以上学历，计算机、人工智能等相关专业优先；\n2. 有互联网产品实习经验，参与过 AI Agent / 经营策略类产品者优先；\n3. 逻辑思维强，能清晰拆解复杂问题并结构化表达；\n4. 大模型/AI Agent 深度用户，对 AI 技术有基本理解，有好奇心和自驱力，对电商 + AI 的结合有热情。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786081076184,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287149935865874725","name":"产品类","i18n_name":"产品类"},"job_id":"7671158613352909097","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_pos