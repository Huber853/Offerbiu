{"code":0,"data":{"job_post_detail":{"id":"7665929800230553897","title":"软件产品经理（固件方向）-2027校招","description":"1、负责相机和相机生态产品软件功能的用户洞察、产品规划、产品设计和跟进开发实现，为整体软件竞争力和体验负责；\n2、通过市场分析、用户洞察和竞品分析等方法挖掘产品的功能特性，能够形成高价值、差异化的创新功能；\n3、能够和上下游团队密切合作，共同基于市场和销售目标形成合理的项目规划；\n4、负责和预研、算法平台、嵌入式软件等部门沟通并能够协调资源帮助实现项目目标；\n5、在产品研发和迭代过程中持续在目标用户场景体验产品功能，发现并解决用户的痛点和需求，追求产品的极致体验。","requirement":"1、本科及以上学历，影像或音频相关专业优先；\n2、熟悉手机相机、摄影设备、会议产品等；\n3、具备优秀的自驱力、沟通协调和产品Owner精神，能够积极主动和其他部门沟通合作；\n4、具备持续成长和创新精神。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784863590380,"channel_online_status":1,"job_id":"7665929800230324521","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}