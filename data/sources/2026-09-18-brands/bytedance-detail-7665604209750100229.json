{"code":0,"data":{"job_post_detail":{"id":"7665604209750100229","title":"产品交付运维工程师（云和安全） - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责私有化产品交付和运维，产品范围包括：混合云、AI Agent、办公安全等；\n2、积累项目售中、售后阶段的关键问题，推动产品和工具优化，提升交付运维效率；\n3、参与工单和监控告警Oncall值班，提升产品稳定性和服务体验。","requirement":"1、2027届获得本科及以上学历，计算机、网络工程、软件工程等相关专业优先；\n2、扎实的计算机软件基础知识，熟练掌握Linux操作系统、网络、容器等相关原理，具备常见问题排障能力；\n3、了解大语言模型（LLM）基本原理及应用场景，对AI技术感兴趣，有AI Agent使用经验；\n4、中英文流利（书面及口头沟通），能够与全球客户、跨区域团队开展专业沟通；\n5、有良好的沟通协调能力，较强的团队合作精神和责任心，优秀的执行力；\n6、有客户服务意识，能建立和维护良好的客户关系，能接受出差。","job_category":{"id":"6704217321877014787","name":"运维","en_name":"DevOps","i18n_name":"运维","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784787640119,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A188988","job_id":"7665603820867340549","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_