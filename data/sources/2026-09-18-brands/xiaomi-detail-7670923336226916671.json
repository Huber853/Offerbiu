{"code":0,"data":{"job_post_detail":{"id":"7670923336226916671","title":"大数据开发工程师-算法平台方向","description":"1、负责理解项目需求、结合业务，参加算法数仓的设计开发；\n2、负责数仓项目的底层数据结构、数据模型设计；\n3、负责实时指标数仓的设计、开发与数据质量验证。","requirement":"1、计算机、数学相关专业硕士及以上学历；\n2、熟练掌握编程语言，如Java、Python、Scala等，对数据结构和算法有深刻的理解；\n3、熟悉Hadoop生态系统，包括HDFS、MapReduce、Hive、HBase等，掌握Spark、Flink等流处理框架；\n4、学历要求：通常要求本科及以上学历，专业背景可以是计算机科学、软件工程、信息技术、数据科学、数学等相关专业；\n5、了解关系型数据库和NoSQL数据库，如MySQL、PostgreSQL、MongoDBv等；\n6、熟悉数据清洗、转换和处理技术，能够有效地处理大规模的数据；\n7、了解数据挖掘和机器学习的基本理论，并能应用相关算法解决实际问题；\n8、熟悉数据可视化工具，如Tableau、Power BI等，能够将数据转化为有意义的图表和报告；\n9、有相关大数据开发项目经验优先，可以是校内课程项目、实习项目或个人项目；\n10、对新技术有持续的学习和探索精神，能够及时跟进行业最新发展；\n11、具备独立思考和解决问题的能力，能够快速应对各种技术挑战。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026128704,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761476330340460","name":"算法类","en_name":"Algorithm","i18n_name":"算法类"},"job_id":"7670923336226736447","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"jo