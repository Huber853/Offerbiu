{"code":0,"data":{"job_post_detail":{"id":"7667941735649724725","title":"主播运营经理 - 抖音直播","description":"团队介绍：直播团队为抖音在内的字节跳动多款产品提供直播支持。在直播间里，时空的隔阂被打破，五湖四海的人们连接在一起，共同见证、分享、传递生活中的美好。美好的定义不尽相同，越来越多的人在抖音直播里寻找自己向往的美好，拥抱理想生活。960万平方公里的美好现场，尽收直播间。直播团队，期待你的加入！​\n\n1、负责跟进站内垂类主播的挖掘与培养，设计主播成长体系，帮助主播快速成长；\n2、负责主播数据监控和归因，产出运营方案提升主播活跃；\n3、收集主播痛点和诉求，结合运营手段和服务，提升主播体验。","requirement":"1、2027届获得本科及以上学历；\n2、有直播行业主播运营经验者优先；\n3、对数据敏感，以结果为导向，并对最终结果负责；有较强责任心和协调能力以及推动能力。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785331860765,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A102663","job_id":"7667940732356315445","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery