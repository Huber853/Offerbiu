{"code":0,"data":{"job_post_detail":{"id":"7670935464878639410","title":"数据挖掘工程师","description":"1、负责相关业务的数据清洗融合流程的建设、维护、策略优化等；\n2、负责相关数据分析和预测、应用数据预估和关联挖掘、应用内使用数据统计等工作；\n3、探索和研究有效的机器学习/深度学习模型，为公司其他部门或项目提供决策支持；\n4、负责构建用户画像标签，分析用户兴趣偏好。","requirement":"1、数据挖掘、统计学、数学、计算机相关专业，硕士以上学历；\n2、扎实的编程能力，熟悉常用数据挖掘算法和数据结构，熟悉主流机器学习、数据挖掘基本算法和数学模型，并有实际的项目经验；\n3、精通一种开发语言（Python、Scala、Java等），并具有快速学习其他开发语言的能力，熟悉Linux开发环境；\n4、熟悉Hadoop(HDFS/MapReduce/Hive/HBase)、Spark、Kafka的使用，熟悉Mysql等关系型数据库和NoSql技术；\n5、对数据敏感，能熟练预估数据量以及数据项之间关系，善于从数据中发现问题，熟悉大模型优先，能利用大模型做数据挖掘。","city_info":{"code":"CT_163","name":"新加坡","en_name":"Singapore","i18n_name":"新加坡"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028897176,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670935464878508338","city_list":[{"code":"CT_163","name":"新加坡","en_name":"Singapore","location_type":3,"i18n_name":"新加坡","py_name":"xinjiapo","mdm_code":"MDCY00004467","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_163","name":"新加坡","en_name":"Singapore","l