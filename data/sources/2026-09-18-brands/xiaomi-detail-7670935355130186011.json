{"code":0,"data":{"job_post_detail":{"id":"7670935355130186011","title":"应用安全工程师","description":"岗位职责：\n1. 参与公司业务系统的安全评估，包括安全设计评审、威胁建模、第三方组件风险分析等；\n2. 对 Web/移动端应用进行渗透测试与安全测试，输出报告并推动漏洞修复闭环；\n3. 参与 SRC 漏洞审核工作，对外部提交的安全漏洞进行验证、评级与跟踪处理；\n4. 参与应用安全 AI 赋能建设，探索利用 LLM/Agent 提升DevSecOps效率和能力的工程化方案。","requirement":"任职要求：\n1. 本科及以上在读，计算机、信息安全、网络空间安全等相关专业优先；\n2. 熟悉常见 Web安全漏洞原理（OWASP Top 10、逻辑漏洞等）、利用方式、修复方法；\n3. 至少掌握一门编程语言（Python/Go/Java），具备脚本编写与工具开发能力，对AI Coding有深入实践者优先；\n4. 了解主流安全工具（Burp Suite、MITM Proxy、Nmap 等）的使用；\n5. 对 AI/LLM 安全方向有兴趣，对提示词注入、Agent安全领域等方向有研究者优先；\n6. 有 CTF 竞赛经验或公开漏洞提交记录者优先；\n7. 自驱、好奇心强，善于主动学习新领域知识。","city_info":{"code":"CT_163","name":"新加坡","en_name":"Singapore","i18n_name":"新加坡"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028837747,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670935355130054939","city_list":[{"code":"CT_163","name":"新加坡","en_name":"Singapore","location_type":3,"i18n_name":"新加坡","py_name":"xinjiapo","mdm_code":"MDCY00004467","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list