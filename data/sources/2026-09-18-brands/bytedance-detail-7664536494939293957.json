{"code":0,"data":{"job_post_detail":{"id":"7664536494939293957","title":"数据挖掘工程师 - 今日头条","description":"团队介绍：产品覆盖今日头条、头条极速版等各类产品，为上亿用户持续提供优质的资讯、视频等服务。我们通过建立良好的内容生态，鼓励原创优质的内容，为创作者提供优质的服务和创作体验，促进创作和交流，同时我们致力于通过尽可能丰富的内容体裁和尽可能多的分发方式，连接人与信息，丰富大家的精神生活，让人们看到更大的世界。\n\n1、基于对用户和产品的理解和海量数据，参与产品、运营、研发等多种场景的数据挖掘、实验设计、策略改进与数据建模等工作；\n2、研究机器学习或概率统计或内容理解领域的前沿技术，针对海量用户行为和内容信息，探索更有价值的数据观点；\n3、高质量交付团队内的挖掘需求、主动思考去影响业务决策。","requirement":"1、2027届获得本科及以上学历，数学、统计学、数据挖掘、机器学习、计算机、经济学等相关背景，有交叉学科背景者优先；\n2、精通Hive、SQL，熟练使用Python进行数据清洗、分析、建模，熟悉Hadoop、Spark、Hive等大数据相关组件；\n3、良好的逻辑思维能力，优秀的分析和解决问题的能力，对挑战性问题充满激情。","job_category":{"id":"6704216635923761412","name":"数据挖掘","en_name":"Data mining","i18n_name":"数据挖掘","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784539021758,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A14559","job_id":"7664536500830636341","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChanne