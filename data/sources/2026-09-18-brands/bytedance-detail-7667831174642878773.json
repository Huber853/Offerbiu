{"code":0,"data":{"job_post_detail":{"id":"7667831174642878773","title":"后端开发工程师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、参与到火山引擎云平台业务系统的需求分析、功能设计与核心模块研发，打造专业、安全、稳定的智能化云平台架构；\n2、参与到火山引擎统一服务框架的高性能、高并发、高可用等系统建设；\n3、参与到在线业务系统的技术问题定位并修复；\n4、学习前沿的分布式系统架构、云架构和智能化架构的相关知识，探索技术创新。","requirement":"1、2027届获得本科及以上学历，计算机科学与技术、软件工程、电子信息、数学等相关专业优先；\n2、熟练掌握至少一门服务端编程语言（如Java/Go/Python），熟悉常见数据结构与算法，理解操作系统、计算机网络、数据库（MySQL/Redis等）的核心原理；\n3、熟悉K8s、Docker等云原生技术，或有中间件开发经验优先；\n4、学习能力强，对技术有热情，具备基础的代码编写与调试能力，能阅读并理解开源框架源码；\n5、参与过开源项目贡献、技术竞赛（如ICPC、力扣周赛）或发表技术博客等优先。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785306071682,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A250509","job_id":"7667830975129159941","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list"