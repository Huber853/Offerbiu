{"code":0,"data":{"job_post_detail":{"id":"7668294219304470837","title":"成本管理专员 - Corporate Services","description":"团队介绍：企业服务团队致力于为全球ByteDancer提供最佳的管理和员工体验，我们支持员工协同并高效地完成工作，同时保护和促进公司的业务发展。企业服务团队通过专业服务来改善ByteDancer的体验，同时建立并不断探索可广泛共享的新行业最佳实践。\n\n1、全球成本数据管理：收集、整理并分析全球各办公室的成本数据，确保数据完整、准确、可追溯；\n2、项目资料整理：协助归档、整理各类项目资料，维护资料的结构化与规范化；\n3、专项数据分析与文档支持：参与专项数据分析工作，并支持相关文档撰写；\n4、价格数据沉淀：负责标准清单及历史项目数据库的价格信息沉淀与维护，逐步搭建可复用的价格基线。","requirement":"1、2027届获得本科及以上学历，工程造价、工程管理、建筑工程、机电工程等相关专业优先；\n2、具备较强的数据整理与分析能力，对数据敏感、善于发现规律与异常；\n3、学习能力强，逻辑思维清晰，能快速理解业务与分析框架；\n4、细心踏实，责任心强，能耐心处理大量明细数据；\n5、英语能力较好，可作为工作语言。","job_category":{"id":"6704215913488451847","name":"职能 / 支持","en_name":"Corporate Function / Support","i18n_name":"职能 / 支持","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785413964068,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A10765C","job_id":"7668293796563929349","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_lis