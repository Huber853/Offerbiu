{"code":0,"data":{"job_post_detail":{"id":"7669629758774872325","title":"数据科学（搜索） - TikTok","description":"团队介绍：TikTok是一个覆盖150个国家和地区的国际短视频平台，我们希望通过TikTok发现真实、有趣的瞬间，让生活更美好。TikTok在全球各地设有办公室，全球总部位于洛杉矶和新加坡，办公地点还包括纽约、伦敦、都柏林、巴黎、柏林、迪拜、雅加达、首尔和东京等多个城市。\n\n1、根据国际化短视频搜索业务目标，设计合理的分析框架、指标体系，评估业务表现；搭建数据指标报表，监控指标变化，并对异动进行归因分析；\n2、分析用户行为数据，挖掘产品体验、推荐策略的优化点，与产品经理、算法工程师合作改进用户体验；\n3、通过科学的A/B实验设计和结果分析，验证业务假设、评估优化收益；\n4、研究因果推断方法，结合业务实际问题，形成合理的落地方案。","requirement":"1、2027届获得本科及以上学历，统计学、经济学、数学、计算机科学等相关专业优先；\n2、熟悉常用的统计分析方法，熟练使用SQL、R/Python等编程语言；了解机器学习、推荐算法原理；\n3、优秀的思维逻辑，善于分析问题和解决问题，良好的沟通协作能力，对于挑战充满热情；对数字敏感，对分析工作有热情，相信数据驱动的价值；良好的沟通能力、团队合作精神和主动意识；\n4、有实习经验优先。","job_category":{"id":"6704216224387041544","name":"数据分析","en_name":"Data analysis","i18n_name":"数据分析","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785724893179,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A76043A","job_id":"7669629735937034501","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlat