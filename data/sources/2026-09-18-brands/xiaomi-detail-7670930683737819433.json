{"code":0,"data":{"job_post_detail":{"id":"7670930683737819433","title":"稳定性研发工程师-汽车","description":"1. 负责智能座舱系统稳定问题的分析与解决，包括但不限于Native Crash、Kernel Panic、WDT、系统Hang、内存踩踏、内存泄漏等\n2. 参与系统稳定性体系建设，有效识别业务、项目背后的稳定性风险，设计与实现系统稳定性方案，确保系统整体可维测性\n3. 持续优化系统稳定性工具和调试机制，提升低概率问题分析与解决效能\n4. 负责系统稳定性疑难问题攻关，协调相关团队资源，推进问题分析与解决","requirement":"1. 熟悉C/C++编程和常用api，对多线程并发、信号处理等要有深入理解，熟练掌握gcc/gdb等toolchain；\n2. 熟悉linux内核通用机制，熟练掌握常用的内核debug工具（如trace32和crash）；\n3. 熟悉QCOM平台底层稳定性机制，包括但不限于Crash，Hang，Panic， WDT；\n4. 有各种疑难加载问题分析经验，在死机、重启、黑屏、冻屏、无法开机等领域有深入研究；\n5. 有内核稳定性开发和测试相关经验者优先；\n6. 有车载智能座舱系统开发经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027991559,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670930683737655593","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京",