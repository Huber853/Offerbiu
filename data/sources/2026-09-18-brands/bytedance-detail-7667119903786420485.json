{"code":0,"data":{"job_post_detail":{"id":"7667119903786420485","title":"后端研发工程师 - 国际化广告CRM与交易平台","description":"团队介绍：国际化广告CRM与交易团队，负责构建和维护全球广告客户关系管理和资金交易管理平台，为销售和客户提供智能化营销解决方案。我们致力于打造稳定、灵活且智能的平台，提升商业化效率和客户满意度，保障客户资金交易的稳定性和安全性，为广告商业变现实现收入、风险、效率与体验之间的平衡。\n\n1、负责架构设计和开发，为亿级用户提供优质顺畅的信息服务和极致体验；参与设计系统技术方案，核心代码开发和系统调优；\n2、参与制定代码规范、测试规范，建立起开发质量控制方法；\n3、协助团队攻克各种高并发、数据隔离、系统解耦等方面的技术难关；\n4、参与各专项技术调研，新技术引入等前瞻项目；\n5、参与机器学习与异构计算系统研发。","requirement":"1、2027届获得本科及以上学历，计算机相关专业；\n2、热爱计算机科学和互联网技术，精通至少一门编程语言，包括但不仅限于：Java、C、C++、PHP、Python、Go；\n3、掌握扎实的计算机基础知识，深入理解数据结构、算法和操作系统知识；\n4、有优秀的逻辑分析能力，能够对业务逻辑进行合理的抽象和拆分；\n5、有强烈的求知欲，优秀的学习和沟通能力。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785140479152,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A130787","job_id":"7667119583024728325","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node