{"code":0,"data":{"job_post_detail":{"id":"7667125843387156789","title":"云基础资源运营 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责火山引擎计算/存储/网络/AI产品的运营工作，参与数据中心资源运营，做好需求和容量管理，保障业务需求交付；\n2、协助完成集团内部的经营结算工作，参与产品的营收和成本管理，为产品优化提供方向和数据支撑，提升产品综合竞争力；\n3、深度了解产品经营体系运作逻辑与流程，配合产品线开展资源预算、预测与预实分析等工作；\n4、参与产品的运营平台建设，建设业务规范和标准化业务流程，提升产品运营效率。","requirement":"1、2027届获得本科及以上学历，计算机类、通信工程类、经济管理类等专业背景；\n2、有数据中心运营管理或AI产品运营经验者优先；\n3、具有较强的沟通协调能力、学习能力、及多任务处理能力，具备一定的项目管理能力；逻辑思维能力强，思考框架性强，性格开朗、工作积极主动。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785142018278,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A186102","job_id":"7665928980620970245","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_ma