{"code":0,"data":{"job_post_detail":{"id":"7670892057284348210","title":"产品经理（用户研究方向）","description":"1、负责智能硬件软件系统及相关产品（如手机应用）的用户体验研究；\r\n2、结合业务发展现状，通过研究为产品交互设计与策略制定提供迭代建议。解决业务问题，帮助业务不断优化；\r\n3、通过研究，分析用户群体的行为或态度、认知与体验感受；\r\n4、 参与建立科学的用户体验指标，通过跟踪、监测和反馈，提升产品用户体验和质量；\r\n5、 参与推动用研意识及用研方法的内部普及。","requirement":"1、商业分析、大数据分析、心理学、社会学、人因工程、工业设计等相关专业本科及以上学历，专业基本功扎实；\r\n2、对定量与定性研究方法，如问卷调查、用户访谈、焦点座谈会、田野调查、可用性测试等研究方法有一定了解；具备优秀的洞察、分析能力，出色的语言表达能力；\r\n3、拥有团队合作精神、高度责任感，富有创造力、有强烈好奇心、研究热情；\r\n4、掌握一定的数据分析工具，如spss等更佳。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018875290,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670892057284217138","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"M