{"code":0,"data":{"job_post_detail":{"id":"7670931558120327443","title":"物流专员-西语-local","description":"岗位描述：\n1、跟进国内及海外物流、仓储、运输的日常工作；\n2、按照仓储、运输业务的具体模块职能要求，进行业务的学习、掌握、熟练、并可以独立完成领导安排的工作内容；\n3、物流数据进行日常汇总、整理与分析；\n6、对项目中的具体工作负责，进行文档处理、对于跨部门协作、对外沟通的工作进行妥善的沟通推动、及时反馈、资源协调。","requirement":"1、本科及以上学历，物流、企业管理、工业工程等专业优先；\n2、具备良好的西语听说读写能力，可使用西语开展日常工作沟通、文档处理与业务协作\n3、热爱物流和电子商务行业，具有强烈的事业心、进取心和责任心，并对生活充满正能量，对工作充满激情，有志成为小米物流的管理人才或者专业人才；\n4、具备优秀的沟通协调能力，出色的解决问题能力，善于团队合作，并能主动学习与创新。","city_info":{"code":"CT_96","name":"马德里","en_name":"Madrid","i18n_name":"马德里"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786028696630,"channel_online_status":1,"job_subject":{"id":"7659316637744613682","name":{"zh_cn":"2027届境外招聘计划","i18n":"2027届境外招聘计划"},"limit_count":1,"active_status":1},"job_function":{"id":"7178830559051858028","name":"外语外派类","en_name":"Global Expatriate","i18n_name":"外语外派类"},"job_id":"7670931558120196371","city_list":[{"code":"CT_96","name":"马德里","en_name":"Madrid","location_type":3,"i18n_name":"马德里","py_name":"madeli","mdm_code":"MDCY00003410","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_96","name":"马德里","en_name":"Madrid","location_type":3,"i18n_name":"马德里","py_name":"madeli","mdm_code":"MDCY00003410","node_st