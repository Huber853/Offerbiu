{"code":0,"data":{"job_post_detail":{"id":"7669715891878971653","title":"游戏UE策划（搜打撤） - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、负责设计游戏在PC和主机平台的各主要系统的交互逻辑，并跟进制作完整界面；\n2、协助梳理游戏中的交互设计规范；\n3、负责独立制作游戏中一些基础的系统功能。","requirement":"1、2027届获得本科及以上学历；\n2、逻辑思维能力强，有优秀的文字和语言沟通表达能力；\n3、对UE/UI有深入理解，有较强的审美能力，有一定平面设计能力的优先；\n4、熟悉市面上各种主PC、主机游戏的交互设计方案，能分析市场同类游戏交互方面的核心设计思路和方法论；\n5、游戏面广泛，对市面上主流ARPG类游戏和竞技类游戏都有所涉猎，深度PC主机用户优先，搜打撤类游戏（三角洲行动、暗区突围、逃离塔科夫、逃离鸭科夫等）和魂类（只狼、艾尔登法环、黑暗之魂等）经历丰富加分。","job_category":{"id":"6850051245139298567","name":"游戏系统策划","en_name":"Game System","i18n_name":"游戏系统策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785744896415,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A170551B","job_id":"7667111380248840501","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"addres