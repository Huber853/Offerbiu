{"code":0,"data":{"job_post_detail":{"id":"7669678684211169589","title":"用户运营（粉丝运营） - 红果短剧","description":"团队介绍：红果短剧是抖音集团2023年推出的免费看剧产品，致力于为用户提供海量免费优质短剧，同时也为用户提供电影、电视剧、小说、有声书等多元内容，满足不同用户的内容消费需求。\n\n1、协助运营好演员粉丝群，提升用户发文及互动意愿，提高内容质量和消费价值；\n2、策划并落地活动，提升粉丝群在红果短剧内的经营意识和活跃度；\n3、参与线下活动落地，对接供应商梳理并优化流程，推进项目落地。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、喜欢看短剧，喜欢追星，能深入用户了解诉求和体验问题，有相关实习经验的同学优先；\n3、有一定的数据分析能力；\n4、有同理心，目标感强，性格开朗，善于表达，跨团队协同面好，沟通效率高。","job_category":{"id":"6704215955154667787","name":"用户运营","en_name":"User ops","i18n_name":"用户运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785736371068,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A119536A","job_id":"7668214893256427781","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beij