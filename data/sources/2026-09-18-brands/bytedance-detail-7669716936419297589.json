{"code":0,"data":{"job_post_detail":{"id":"7669716936419297589","title":"游戏文案策划（搜打撤） - 绿洲工作室","description":"绿洲工作室2019年4月在北京成立，立足动作与休闲核心赛道，依托移动、PC、主机全平台布局，持续探索 RPG、竞技、休闲、棋牌等多品类精品游戏创作。旗下有《晶核》《雾影猎人》《SlashZero》（又名：《零境·入侵》）《Land of Empires》《芒果斗地主》等多款产品。我们的愿景是希望帮助玩家在令人惊叹的虚拟世界中一起玩耍与创造，加入这里，你将与一群简单、务实的优秀伙伴一起，Work hard，Play harder~\n\n1、负责协助设计游戏世界观；\n2、负责设计和撰写游戏中的各种主线、支线剧情，各种道具、技能文本描述等；\n3、负责设计重点怪物、职业、NPC等背景故事，并提出美术需求；\n4、负责推进本地化、配音等相关流程。","requirement":"1、2027届获得本科及以上学历，计算机相关专业优先、相关专业优先；\n2、文字功力深厚；有成熟发表作品者优先；\n3、熟悉流行文化，熟悉西方奇幻题材；对文学历史等有积累和研究；\n4、游戏面广泛，对市面上主流主机动作游戏和ARPG游戏都有所涉猎，搜打撤类游戏（三角洲行动、暗区突围、逃离塔科夫、逃离鸭科夫等）和魂类（只狼、艾尔登法环、黑暗之魂等）经历丰富加分；\n5、责任心强，综合能力优秀；能积极推进复杂任务。","job_category":{"id":"6850051245139298567","name":"游戏系统策划","en_name":"Game System","i18n_name":"游戏系统策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745130163,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A84853","job_id":"7667106588192934197","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":