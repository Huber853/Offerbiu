{"code":0,"data":{"job_post_detail":{"id":"7673822066950539525","title":"内容运营（热点策划方向） - 抖音生活服务","description":"团队介绍：抖音生活服务依托抖音POI （Point of Interest）、短视频、直播、搜索等，以“激发线下生意，丰富美好生活”为使命，致力于成为最值得信赖的生活服务平台，为用户提供更丰富、独特的生活体验，为合作伙伴提供包容且公平的健康营商生态。截至2025年底，抖音生活服务业务已覆盖400+城市，超过1500万家动销门店。抖音生活服务将继续携手生态伙伴，为用户提供值得心动的商品和服务。\n\n1、基于抖音生活服务，通过热点发现、策划、运营等环节，跨团队推动标杆性的生活服务类热点案例产出；\n2、通过项目及数据复盘持续沉淀热点运营方法，优化运营机制及协作流程，提升生活服务类热点规模及质量。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、对热点及内容策划运营有高兴趣，有良好的热点感知及内容洞察能力；\n3、具备较强的表达力和逻辑感，能够基于数据及现象分析产出归因；\n4、有热点、内容、运营、营销等实习经历者优先。","job_category":{"id":"6704215955154667787","name":"用户运营","en_name":"User ops","i18n_name":"用户运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786700933404,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A26798A","job_id":"7673821620168116533","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_