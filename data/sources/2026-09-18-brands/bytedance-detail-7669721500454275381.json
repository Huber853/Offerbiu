{"code":0,"data":{"job_post_detail":{"id":"7669721500454275381","title":"游戏UE交互设计师 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、负责射击游戏局内玩法、局外系统完整的交互设计，搭建可交互原型并验证方案；输出交互流程图、功能文档，跟进设计稿在引擎中的落地实现；\n2、参与PC、主机多平台交互适配设计，匹配不同平台交互特性与设计侧重点；\n3、与策划、UI、TA、程序等职能协作团队，对局内玩法、局外成长体系进行玩家体验迭代优化；\n4、日常分析市面优质射击、长线服务型游戏案例，输出体验优化与创新方向参考。","requirement":"1、2027届获得本科及以上学历，交互、数媒、工设、游戏设计、计算机等相关专业优先；\n2、掌握完整交互设计方法论，熟练使用Figma制作原型与设计方案；\n3、熟知游戏交互与普通产品交互区别，以玩法、操作效率、反馈为核心做设计思考；\n4、射击游戏深度玩家，了解PVP、PVE玩法差异，具备良好的逻辑思维、执行力与跨团。","job_category":{"id":"6850051246036879630","name":"游戏美术","en_name":"Game Art","i18n_name":"游戏美术","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746233779,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A09093","job_id":"7660721905518971189","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_lev