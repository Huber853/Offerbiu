{"code":0,"data":{"job_post_detail":{"id":"7670919194564675891","title":"音频系统工程师 (功放、系统)-汽车","description":"1.负责汽车音响功放的设计开发，包括功能和性能需求定义、方案设计、核心零部件选型、定点； \n2.负责功放产品的系统开发跟进、结构数据发布与审核、软硬件问题排查与整改、产品实验及评审验收； \n3.负责核心元器件如DSP、功率芯片、电源芯片的选型，制定相关性能指标要求，制定长期迭代规划； \n4.负责功放及音响产品与其他相关部门的对接。 ","requirement":"1.本科及以上学历，声学、信号处理、电子工程、通信工程、自动化等专业； 由扎实的模拟电子、数字电子和电路分析基础；\n2.了解音频功率器件，了解扬声器、功放系统的布局、结构件设计方法、电子元器件选型、材料选型； \n3.有音乐欣赏和音频鉴赏能力。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025108083,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670918533032134938","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag_list":[],"storefront_mode"