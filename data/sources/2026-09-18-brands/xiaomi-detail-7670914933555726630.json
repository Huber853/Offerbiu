{"code":0,"data":{"job_post_detail":{"id":"7670914933555726630","title":"总布置工程师-汽车","description":"1.依据项目定位，完成整车 CV‑SPEC 人机目标定义与分解；\n2.开展行业前沿技术研究，推动先进技术方案落地应用；\n3.响应产品力提升需求，开展工程可行性分析与方案论证；\n4.主导车型前期概念方案设计，确定关键区域布置可行性；\n5.制定整车零部件布置集成方案，保障全维度集成要求落地；\n6.负责 3D 数据 DPA1 检查，推动问题整改及数据会签与发布审核。","requirement":"1.本科及以上学历，车辆工程或机电相关专业（车辆专业优先）；\n2.熟悉汽车结构及工作原理者优先；\n3.具备系统思维、统筹意识与空间感知能力；\n5.善于沟通协调、多任务并行与问题解决；\n6.热爱汽车研发，愿意深耕整车集成领域；\n7.学习能力强，能快速适应全流程、跨模块工作模式。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024170892,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670914933555562790","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"tag_list