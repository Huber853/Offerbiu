{"code":0,"data":{"job_post_detail":{"id":"7671289170229512489","title":"光电器件工程师-扫地机","description":"1、负责机器人项目中光电类传感器模组的方案选型、设计确认以及性能验证以及自研方案设计；\n2、参与光电器件的技术路标制定，跟进管理研发流程，协调光学、硬件、软件算法以及供应链等相关团队；\n3、把控光电器件导入项目中的风险，解决设计、测试、项目量产以及售后过程中的各种问题；\n4、与Sourcing、SQE、供应商等部门合作，保障器件从设计到量产顺利推进，并且保障整机最终交付上市。","requirement":"1、通信，电子，计算机，光电及相关专业；\n2、熟悉各种光电传感器，如 激光雷达、ToF、结构光、立体视觉、先进感测等传感器技术原理、内部结构与生产制造流程，对其发展于是有自己的理解；\n3、具有较强的责任心和学习能力，工作态度积极，敢于挑战，具有良好的团队精神和沟通能力与跨部门合作能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112074415,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671289170229381417","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"tag_list