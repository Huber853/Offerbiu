{"code":0,"data":{"job_post_detail":{"id":"7667501193568782597","title":"人才管理 - 人力与管理部","description":"团队介绍：人力与管理部作为公司的职能部门之一，助力字节跳动从一家创业公司发展成为拥有超过十万名员工的全球化公司。人力与管理部以“释放人才成长力，激发组织生命力”为使命，在组织、人才、文化等方面持续像打造产品一样打造公司，推动业务成长。\n\n1、通过数据分析与洞察，识别招聘管理中潜在优化空间，设计合理的管理目标牵引改善；\n2、通过AI技术和工具探索新型招聘提效方式，形成新一代的招聘交付和管理方法，打造最佳实践的招聘团队。","requirement":"1、2027届获得本科及以上学历，数据科学、计算机科学、商业分析、工商管理、经济学等相关专业优先；\n2、AI产品、数据分析、商业分析、产品/项目运营实习经验，或行业研究/PEVC实践经历者佳；\n3、战略与商业洞察力，有强烈的好奇心和学习能力，能理解业务逻辑并进行战略解码；出色的项目管理和沟通能力，能主导复杂项目，协调多方资源；\n4、熟练使用数据分析工具和AI工具，能从数据中发现问题、驱动决策；\n5、中英文听说读写熟练，可作为工作语言使用。","job_category":{"id":"6704216386916321540","name":"人力","en_name":"HR","i18n_name":"人力","depth":2,"parent":{"id":"6704215913488451847","name":"职能 / 支持","en_name":"Corporate Function / Support","i18n_name":"职能 / 支持","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785229313993,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A46120C","job_id":"7667501095186680117","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_