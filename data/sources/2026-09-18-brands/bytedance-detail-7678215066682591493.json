{"code":0,"data":{"job_post_detail":{"id":"7678215066682591493","title":"企业文化（设计方向） - 人力与管理部","description":"团队介绍：人力与管理部作为公司的职能部门之一，助力字节跳动从一家创业公司发展成为拥有超过十万名员工的全球化公司。人力与管理部以“释放人才成长力，激发组织生命力”为使命，在组织、人才、文化等方面持续像打造产品一样打造公司，推动业务成长。\n\n1、协助部门完成各类设计需求，如宣传海报、奖品物料、文档配图等，以提升品牌形象和推广效果；\n2、参与各类文化活动的设计与运营，支持全流程项目管理；\n3、参与团队内传播视频物料的创意策划、脚本设计与后期制作；\n4、积极参与团队内的创意讨论和方案策划，提供设计方面的专业建议和创新思路；\n5、结合工作要求，撰写日常传播所需各类文案。","requirement":"1、2027届获得本科及以上学历，设计专业优先；\n2、具备跨文化的敏感度和包容度，英语可作为工作语言；\n3、掌握一定的图片设计、视频剪辑、基础数据处理等能力；\n4、熟练使用AI、PS等设计软件，掌握C4D或AE技能者优先。","job_category":{"id":"6704216386916321540","name":"人力","en_name":"HR","i18n_name":"人力","depth":2,"parent":{"id":"6704215913488451847","name":"职能 / 支持","en_name":"Corporate Function / Support","i18n_name":"职能 / 支持","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787723761250,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A59188","job_id":"7678214124376131893","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_tim