{"code":0,"data":{"job_post_detail":{"id":"7670890215934986559","title":"用户产品经理","description":"1、负责小米电视OTT产品设计，对产品易用性和用户体验负责，全流程主导产品设计与落地;\n2、通过用户需求洞察，持续优化用户体验，提升活跃、留存及转化等核心指标；\n3、对数据结果负责，通过数据结论，快速且持续的对产品功能进行迭代；\n4、与设计、运营及研发团队深度配合，推进电视桌面用户体验与服务使用率提升\n5、调研分析国内外OTT行业的产品设计、商业模式，及时掌握行业动态。","requirement":"1、计算机或相关理工科等相关专业本科以上学历，有C端产品实习经验优先;\n2、具备良好的原型制作与PRD撰写能力，熟练操作office、Axure等软件；\n3、数据敏感，善于利用数据驱动产品优化升级；逻辑清晰，善于分析市场和用户需求；\n4、具备高度责任心和执行力，自驱推动项目落地。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018420508,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670890215934806335","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing",