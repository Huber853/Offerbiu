{"code":0,"data":{"job_post_detail":{"id":"7670924303102052614","title":"人力资源专员-招聘","description":"1、负责部门招聘相关工作；\n2、负责与业务/用人主管深度对焦，确定岗位需求和寻访方向，并负责招聘全流程的把控；\n3、寻访、甄选，评估候选人，准备并沟通offer方案；\n4、能根据业务重点，梳理对应的寻访目标公司，构建人才地图，完善人才储备，提升招聘效率；\n5、能够梳理分析和优化招聘流程，提升候选人体验，有效管理招聘渠道，并能参与招聘体系建设及优化；\n6、负责招聘相关的项目事宜，并能做好项目推动和协同工作。","requirement":"1、本科及以上学历；\n2、熟练掌握Office等办公软件，具备一定的数据分析及统计能力，过往有校招\u0026社招招聘实习经验优先；\n3、责任心强，具备良好的沟通能力和项目管理能力（含进程推进能力）；\n4、具备多任务同时进行的能力，和业务/用人主管，在交付节奏上，能够达成共识；\n5、性格开朗、执行效率高。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026330786,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879421549","name":"职能类","en_name":"Supporting Function","i18n_name":"职能类"},"job_id":"7670924303101872390","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000