{"code":0,"data":{"job_post_detail":{"id":"7667968434123622709","title":"渲染引擎研发工程师 - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、参与字节跳动跨平台框架的图形渲染引擎开发；\n2、参与自研跨平台（Android、iOS、嵌入式全平台）UI FrameWork开发；\n3、参与跨平台UI FrameWork的2D/3D渲染引擎的开发；\n4、参与跨平台UI FrameWork多端多平台业务落地。","requirement":"1、2027届获得本科及以上学历，图像学专业优先；\n2、熟练掌握C++，熟悉C++14\u0026C++17标准相关特性；\n3、熟悉Skia，NanoVG，AGG等2D图形库中的一种；\n4、熟悉图形开发相关技术（DirectX，Metal，Vulkan，OpenGL）和GPU架构者优先；\n5、有游戏引擎的实践经验优先，如：Unity，UE，Godot，Cocos等；\n6、对技术有较大的热情，学习能力强，责任心强，工作认真细致，具备良好的服务意识，具有良好的团队沟通与协作能力。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785338424653,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A250006C","job_id":"7667969068984879365","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18