{"code":0,"data":{"job_post_detail":{"id":"7669723503123220741","title":"游戏系统策划（PVE射击游戏） - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、参与游戏的玩法、养成、社交等系统设计和研发落地全流程；\n2、负责相关系统的测试反馈收集和线上数据分析，并且在后续的版本迭代中持续优化体验。","requirement":"1、2027届获得本科及以上学历，计算机、软件专业背景或者交互设计、UI设计或相关美术专业背景；\n2、怀揣做高品质游戏理想，对游戏行业有强烈热情及成就动机，同时有良好的自驱力及责任心；具备优秀的沟通能力、跨模块协作能力、数据分析能力；\n3、游戏经验丰富，对市面主流射击游戏有深入研究，熟悉其核心机制与设计差异，至少1-2款PC射击游戏有深度体验；除了PC射击类游戏之外，对其他品类、其他平台的游戏也有广泛涉猎；至少5款PVE游戏体验；如果有以下经验加分：\n1）在至少一款PVE中获得过区服排名；\n2）在至少一款PVE游戏中做过社团/公会会长或管理者；\n4、有如下背景加分：\n1）具备一定编程能力；\n2）有动手能力制作游戏Demo原型，或参加过游戏设计开发设计比赛并且获奖。","job_category":{"id":"6850051245139298567","name":"游戏系统策划","en_name":"Game System","i18n_name":"游戏系统策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746688825,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A220764","job_id":"7660409026686748933","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":