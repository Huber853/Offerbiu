{"code":0,"data":{"job_post_detail":{"id":"7669720537132599605","title":"游戏运营 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、参与射击游戏产品运营功能的需求梳理、方案设计、文档撰写及开发跟进，协同研发、策划、美术等团队推动功能落地；\n2、参与产品版本迭代与运营功能优化，结合用户反馈、数据表现及产品目标，持续优化玩家体验、成长目标感及留存表现；\n3、参与项目研发节点工作，跟进项目问题与体验验证，支持版本稳定交付与产品体验优化；\n4、关注射击品类市场动态、产品变化及用户需求，支持运营策略分析与优化方向输出。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、热爱游戏行业，对射击类游戏有较强兴趣和持续关注，对主流产品、玩法及玩家特点有一定理解；\n3、具备良好的沟通表达能力、跨团队协作能力与执行力，能够推动项目高效落地；\n4、具备较强的逻辑思维、学习能力和数据意识，能够基于反馈和数据进行分析、总结与复盘；\n5、认真细致，责任心强，具备高效处理多线程项目协作的能力；\n6、有游戏产品相关实习经历，或有射击品类深度体验、社区运营、内容创作、项目实践经历者优先。","job_category":{"id":"6850051246221429006","name":"游戏运营","en_name":"Game Operations","i18n_name":"游戏运营","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746022045,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A133871","job_id":"7660833133558630661","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"s