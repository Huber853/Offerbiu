{"code":0,"data":{"job_post_detail":{"id":"7667887767667624197","title":"大模型产品经理 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责完成创新产品的规划和设计，挖掘新的大模型落地行业机会；\n2、深入了解大模型智能体、多Agent、RAG、意图识别、低代码和零代码等技术，推动技术在产品中的应用；\n3、与跨部门团队紧密合作，协调资源，确保产品的顺利推进和交付；\n4、分析市场动态和市场，提供有针对性的产品策略和建议。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、了解大模型相关技术和应用；\n3、对产品有浓厚兴趣；具备优秀的产品思维、合理的创新思考；具备优秀的沟通能力和自驱力，能够激励项目成员共同达成目标。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785319312634,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A09987","job_id":"7667884417599817989","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","