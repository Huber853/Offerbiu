{"code":0,"data":{"job_post_detail":{"id":"7671129165291407658","title":"芯片模拟设计工程师","description":"1.负责模拟/混合信号芯片的电路设计，包括ADC、DAC、PLL、电源管理等模块的架构设计与电路实现；\n2.进行电路仿真与验证，确保设计满足功能、性能及可靠性指标；\n3.协同版图工程师完成物理设计，参与版图审查与优化；\n4.制定芯片测试方案，支持量产测试与良率提升；\n5.跟踪先进工艺节点的技术发展，推动设计方法学创新。","requirement":"1、硕士研究生及以上学历，专业背景包括微电子、集成电路设计、电子工程等相关领域。\n2、具有模拟/混合信号电路设计经验，熟悉Cadence、Synopsys等EDA工具。\n3、具备CMOS工艺基础知识，了解器件物理与工艺流程。\n4、掌握SPICE仿真、Monte Carlo分析等电路验证方法。\n5、具有芯片设计实习或流片经验者优先。\n6、有良好的沟通能力、分析问题能力以及团队合作意识。","city_info":{"code":"CT_155","name":"西安","en_name":"Xi'an","i18n_name":"西安"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786074048598,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671129165291243818","city_list":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"cor