{"code":0,"data":{"job_post_detail":{"id":"7668228939256662277","title":"广告产品经理 - 国际化商业安全","description":"团队介绍：国际化商业安全团队致力于在国际化用户、企业和产品之间建立安全可靠的连接。我们通过一系列完善的系统和能力，审核广告内容、预测政策违规行为，并执行广告审核通过或拒绝的措施。\n作为国际商业化团队的业务合作伙伴，我们提供的业务诚信解决方案不仅确保国际化业务始终是一个安全、积极、友好的用户环境，同时也推动业务增长。\n\n1、负责国际化广告产品设计开发，跟进需求开发和上线，并协调推动相关业务团队高质量执行；\n2、负责对广告效果度量相关数据进行整理、验证和分析，提升产品开发效率和客户体验；\n3、通过数据分析、需求收集、用户反馈，发现并优化潜在需求，提出优化建议；\n4、对数据问题进行诊断和排查，解决数据披露上暴露的问题，增强客户信赖。","requirement":"1、2027届获得本科及以上学历；\n2、具备流利地道的英语听说读写能力；\n3、良好的自我驱动力，能够在工作环境中处理多项任务；\n4、较强的逻辑思维能力，善于分析处理数据。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785398794579,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A155249A","job_id":"7668214897797417221","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map"