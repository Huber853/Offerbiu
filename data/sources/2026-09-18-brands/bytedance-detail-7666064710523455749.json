{"code":0,"data":{"job_post_detail":{"id":"7666064710523455749","title":"PMO技术项目经理 - 抖音研发","description":"团队介绍：抖音研发部门负责多款大型产品的研发，包括但不限于抖音、西瓜视频、汽水音乐。加入我们，你将有机会参与亿级用户场景的开发与架构工作，使用前沿的技术助力业务一起不断成长。\n\n1、协助抖音产品研发团队，跟进项目，协助完成相关项目的流程设计、执行落地、总结改进等；\n2、针对团队协作中发现的问题，归纳总结，协助改进；\n3、帮助团队进行日常通用任务的管理，有效地跟进、推动，确保交付；\n4、在日常过程中，推动团队进行知识库的沉淀、归档等。","requirement":"1、2027届获得本科及以上学历，计算机、通信和电子信息科学、数学等相关专业优先；\n2、有较强的沟通能力，良好的与人交流协作的能力；\n3、有较高的责任心，以及目标导向的落地执行能力、问题解决能力；\n4、乐意迎接变化接受挑战，持续学习，自律。\n\n加分项：\n1、英语流利、热爱项目管理、技术背景。","job_category":{"id":"6863074795655792910","name":"项目管理","en_name":"Project Management","i18n_name":"项目管理","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784895339943,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A49192","job_id":"7666063921191487797","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"cit