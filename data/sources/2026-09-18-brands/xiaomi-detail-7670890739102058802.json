{"code":0,"data":{"job_post_detail":{"id":"7670890739102058802","title":"EMC仿真工程师-手机","description":"1. 负责手机中各类电磁兼容问题（Desense\\RSE\\抗干扰）的仿真及测试技术开发，实现仿测闭环；\n2. 负责手机整机电磁仿真精度提升，在干扰源建模、电磁材料建模、天线建模、电磁仿真算法等领域深入研究；\n3. 结合电磁兼容原理及仿真技术指导产品的电磁干扰风险评估与电磁兼容优化设计，提升产品竞争力；\n4. 负责仿真相关前沿技术的调研、分析及预研，推动先进仿真技术在智能手机设计中的应用。","requirement":"1. 电磁场、微波、天线、电磁兼容等相关专业方向，硕士以上学历；\n2. 有电磁仿真、设计，或开发、工程调试经验；\n3. 熟练掌握常用电磁仿真软件，如CST、HFSS、ADS等；\n4. 熟练掌握常用测试仪器，如矢量网络分析仪、频谱仪、信号发生器、综测仪等；\n5. 具备良好的电磁兼容、微波、天线理论基础。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018518873,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670890739101927730","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","n