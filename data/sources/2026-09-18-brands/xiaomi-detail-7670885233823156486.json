{"code":0,"data":{"job_post_detail":{"id":"7670885233823156486","title":"电商运营专员-英语","description":"1、店铺运营：负责海外电商平台店铺的日常运营，包括商品管理、listing优化、活动策划等，推动销售目标达成\n2、数据分析：跟踪店铺核心运营数据（流量、转化、ROI等），定期输出分析报告，为运营决策提供数据支持\n3、项目协同：参与电商运营项目的跨部门协作，对接销售、设计、供应链等相关团队，确保项目高效推进\n4、流程沉淀：参与运营SOP的梳理与编写，持续完善平台运营操作手册，提升团队工作效率\n5、广告投放：协助执行店铺广告投放策略，监控投放效果，参与优化方案的制定与落地","requirement":"1、本科及以上，国际贸易、电子商务、外语、市场营销等相关专业优先\n2、对Amazon/Shopee/TikTok等海外电商平台有基本了解，了解店铺管理、listing优化、广告投放、评论管理等运营核心环节；\n3、具备数据化思维，能使用Excel进行基础数据分析；了解SQL、Tableau者优先\n4、英语读写能力优秀（CET-6/雅思6.5/托福85及以上），掌握多一门语言者优先\n5、商业洞察力强、逻辑清晰、沟通表达能力强、适应多时区协作，结果导向，有电商相关实习或海外经历者加分","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017390046,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670885233822992646","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","n