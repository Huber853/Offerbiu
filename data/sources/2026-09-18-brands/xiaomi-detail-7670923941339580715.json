{"code":0,"data":{"job_post_detail":{"id":"7670923941339580715","title":"投后专员","description":"1. 跟踪已投项目进展，定期收集被投企业业务、财务数据并整理分析；\n2. 协助推动被投企业与小米集团的业务对接（如资源协调、生态合作）；\n3. 参与投后管理报告撰写及数据统计工作；\n4. 支持被投企业增值服务落地（如协助人才推荐、战略复盘等事务）；\n5. 维护投后管理档案，确保项目信息合规归档。","requirement":"1. 本科及以上学历，工科、金融、财务相关专业优先；\n2. 熟悉基本财务分析逻辑，掌握Excel数据处理及PPT报告制作技能；\n3. 有责任心，做事细致，具备良好的沟通协作能力；\n4. 对科技/互联网行业有基础认知，能快速理解企业商业模式；\n5. 有投资机构、咨询公司或互联网企业实习经历优先；\n6. 逻辑严谨，责任心强，具备良好的保密意识与职业操守；\n7. 熟练使用Excel、PPT、Wind等工具，具备基础财务尽调技能。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026299937,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879421549","name":"职能类","en_name":"Supporting Function","i18n_name":"职能类"},"job_id":"7670923941339400491","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000