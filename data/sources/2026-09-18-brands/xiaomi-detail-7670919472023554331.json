{"code":0,"data":{"job_post_detail":{"id":"7670919472023554331","title":"仪表板工程师-汽车","description":"1. 参与仪表板零件的产品定义，与产品、造型团队协同确定外观效果、造型方案与集成策略；\n2. 输出仪表板系统的技术方案，包括系统选型、材料定义、工艺开发、属性满足等；\n3. 主导设计方案的技术评审，推动方案在各阶段 Gate 节点落地；\n4. 编制 DFMEA、特殊特性清单、DVP\u0026R 验证计划，跟踪可靠性测试并完成EA工程认可；\n5. 组织开发阶段样件方案制定、效果确认与评审工作；","requirement":"1. 本科及以上，机械/车辆/工业设计等相关专业应届毕业生；\n2. 熟练使用 CATIA/UG 三维建模和 AutoCAD 制图，了解 Office 办公软件；\n3. 掌握机械制图、工程力学基础；\n4. 学习能力强，沟通协调好，有责任心，对汽车行业有热情；\n5. 有相关实习经验、了解内饰法规、熟悉 FEA 仿真, 熟悉 AI 者优先；","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025185358,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919472023390491","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"j