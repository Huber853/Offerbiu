{"code":0,"data":{"job_post_detail":{"id":"7669689830837684485","title":"大客户销售（美妆日化） - 商业化","description":"团队介绍：抖音集团商业化是抖音集团旗下的综合数字化营销服务平台，致力于让不分行业、地域的企业及个体都能通过数字化技术激发创造、驱动生意，实现商业的可持续增长。\n\n1、按照商业化战略规划，负责消费品行业、互动影视、互动应用、互动娱乐（游戏）、金融、电商平台、教育行业、MCN及达人等方向的客户的开拓与维护工作；\n2、与企业建立深度合作关系，完成既定销售指标；\n3、与公司关联部门沟通协作，确保广告的及时投放与问题反馈、广告资源的合理利用与开发；\n4、通过数据分析客户需求，为客户提供咨询服务、产品培训、优化投放、数据分析等营销策略，制定整合营销方案及策略，推动各行业营销策略的实施。","requirement":"1、2027届获得本科及以上学历；\n2、热爱销售工作，具备良好的客户开拓和服务能力，以及建立良好的客户群体关系的能力；\n3、掌握商务谈判、沟通及文字写作表达交流技巧，具有一定的市场洞察力和执行力；\n4、性格开朗，敢于面对挑战。","job_category":{"id":"6709824272505768200","name":"销售","en_name":"Sales","i18n_name":"销售","depth":1,"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785738867784,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A94333","job_id":"7666009484789106949","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[]