{"code":0,"data":{"job_post_detail":{"id":"7663051571493177605","title":"风险治理运营 - 内容质量与数据服务平台","description":"团队介绍：CQC（中国内容质量与数据服务平台）归属于抖音集团，负责今日头条、抖音、西瓜视频等产品内容和抖音集团商业内容的安全质量与体验，支持各产品的运营和增长，以及为产品线提供AI算法算力的基础支持服务。\n\n1、完成风险监测各类数据复盘及各内外部反馈信息，对内容治理相关风险进行探查并聚类链路归因定位；\n2、对各类风险特征进行挖掘分析，与风控联动开展风险专项治理；\n3、对现有风控策略与结果进行摸底、分析、优化、验证等全链路优化运营，确保风险可控性；\n4、负责运营投放内容的生态治理，为客户投放生态提供保障。","requirement":"1、2027届获得本科及以上学历；\n2、有一定的数据敏感性，具备较强的数据分析和复盘总结能力，善于系统性解决问题；\n3、具备优秀的沟通协调能力，能够高效地沟通推进项目落地；\n4、对先进生产力（如AI大模型等）有实践案例，能迁移运用到工作中优先。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_22","name":"成都","en_name":"Chengdu","i18n_name":"成都"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784193284199,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A145579C","job_id":"7663051420707359029","city_list":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","