{"code":0,"data":{"job_post_detail":{"id":"7670915516803090726","title":"高压系统开发工程师-汽车","description":"1、负责新能源汽车高压系统总体设计方案及高压系统架构设计； \n2、负责整车高压系统技术与性能的研究；产品开发中的高压器件选型及匹配校核设计； \n3、根据整车项目设计需求，完成高压系统图纸的绘制、3D数据布置、高压器件布置校核； \n4、负责高压电器件供应商的开发与审核、技术沟通； \n5、负责组织高压系统整车的安装、调试和试验，问题分析及排查工作； \n6、参与支持前瞻性高压架构方案预研和验证工作。","requirement":"1、硕士及以上学历，汽车电子/车辆工程/电机/电气工程/控制工程/自动化等相关专业，有新能源汽车电机、电池、高压电气、底层及应用层软件等三电开发实习相关经验优先； \n2、熟悉电气基本理论，熟悉短路电流.动热稳定校验.电磁干扰等基本理论，对EMC、EMI有一定的认知； \n3、熟练掌握电气原理图绘制，CAD、OFFICE、Simulink等制图、办公软件及仿真软件； \n4、责任心强，具有优秀的团队合作意识与能力，具有较强的学习能力，且具有较强的协调能力； \n5、对于汽车行业有一定认知，行业认同度高，有志于汽车行业长期发展。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024310421,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670915516802926886","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT