{"code":0,"data":{"job_post_detail":{"id":"7669719447934716213","title":"游戏编导分镜设计师 - ZERO36工作室","description":"团队介绍：ZERO36工作室旗下有《航海王热血航线》、《花亦山心之月》、《初音未来：缤纷舞台》多款游戏产品。\nZERO，是从0开始，是不念过往，不畏将来；是回到原点，对知识诚实；是一切开始的基础。\n36，如果加上°C，即为人体的温度，戒骄戒躁保持初衷，用\"温度\"拉齐大家的目标和价值观，做有温度的产品，有温度的运营，成为一个有温度的团队，欢迎加入我们！\n\n1、参与一款日漫IP的ARPG类项目，该项目使用Unity引擎研发；\n2、具备较强的分镜设计能力，对游戏动画和镜头设计有深刻理解；\n3、结合游戏美术动画风格与游戏调性，与团队高效完成静态和动态分镜的设计与制作；\n4、与团队共同探索分镜表现的前沿技术（如AI）及美术效果的提升方法。","requirement":"1、2027届获得本科及以上学历；\n2、涉猎众多动画漫画作品，手绘分镜能力强，创作能力优秀，具备优秀的原动画基础；\n3、熟练掌握镜头语言和画面构成知识，具备高审美。\n\n加分项\n1、能够使用3D软件或游戏引擎制作动画分镜；\n2、有熟练的AI工具掌握能力；\n3、有相关从业或实操经验。","job_category":{"id":"6850051246036879630","name":"游戏美术","en_name":"Game Art","i18n_name":"游戏美术","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745831560,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A36109","job_id":"7661887593114994997","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefro