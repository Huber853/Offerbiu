{"code":0,"data":{"job_post_detail":{"id":"7664518557363079478","title":"商务专员-2027校招","description":"主要协助业务经理对接客户侧做业务支持工作，包含但不仅限于： \n1、维护产品资料及报价单，客户侧报价；\n2、接受客户订单后协助进行系统录单，跟进回款与发货； \n3、进行应收账款核对工作；\n4、促销期间协助收集及审核客户侧销售凭证，进行申请促销补贴流程； \n5、协助处理客户退货RMA流程和内部其他部门的衔接工作； \n6、对业务数据进行分析，根据分析结果为业务决策提供建议和支持； \n7、新产品上市的项目管理，包括前期客户产品上架准备、渠道进店计划、分货计划和发货跟进等； \n8、负责完成公司及上级领导安排的其他业务辅助工作。","requirement":"1、本科及以上学历，商务管理类、统计学、市场营销类等专业优先考虑； \n2、英语可作为工作语言； \n3、熟练掌握office软件，精通Word、Excel、PowerPoint，具有数据收集和整理能力； \n4、具有较强的沟通表达能力，积极主动，具有亲和力，有团队协作精神。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784534917311,"channel_online_status":1,"job_id":"7664518557362932022","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}