{"code":0,"data":{"job_post_detail":{"id":"7671291316311247154","title":"战略分析师-生态链","description":"1、市场洞察：深入研究智能硬件行业，以案头研究+专家访谈的方式完成调研，包括产品矩阵、发展历程、组织架构、运营模式等，支持业务对标分析；\n2、数据分析与运营：监控经营、销售、市场、口碑、项目时间等关键指标，形成周报/月报，及时预警业务异动，以多维度数据分析推动业务专项；\n3、流程运营：支持关键决策节点和业务会议，完成动作跟踪落实，积极推动流程效率提升。","requirement":"1、本科及以上学历，有管理咨询/市场调研机构/四大等乙方经验，或商分、行研、战略等相关实习经验者优先；\n2、具备较强的结构化思考、拆解问题、逻辑思维能力，具备一定的商业敏感性、基础财务知识以及良好的沟通协调能力，对智能硬件、物联网、数码3C等行业感兴趣；\n3、具有较好的数据分析及书面表达能力，能熟练使用Excel、PPT等办公软件，能熟练使用SQL、了解数据库者优先；\n4、工作自驱能力强，对参与业务、快速成长有激情，工作认真仔细，对工作结果交付有高度责任感。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112027994,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7671291316311116082","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"