{"code":0,"data":{"job_post_detail":{"id":"7679026007857236275","title":"行政专员（海外行政）","description":"1、联动国内团队，结合海外职场文化特点，策划并执行福利文化活动（含方案设计、物料准备、区域落地跟踪、活动复盘），推动企业文化在海外的宣导与落地。\n2、负责公司内外部会议、培训的统筹保障，包括场地预定、会议材料准备、会议纪要撰写及后续事项跟进；\n3、负责管理公司重要文件、合同的归档、保管与借阅工作，确保信息安全与合规；\n4、协助处理员工国内外差旅安排，包括预订机票、酒店、接送服务等；负责公司来访客人的接待工作，展现公司专业形象。","requirement":"1、本科及以上学历，行政管理、企业管理、工商管理等相关专业优先；\n2、具备良好的英语听说读写能力，英语可作为工作语言；\n3、具备较强的沟通协调能力、时间管理能力及问题解决能力；细心严谨，责任心强，具备良好的团队合作精神；\n4、熟练使用 Office 办公软件（Word、Excel、PowerPoint 等）；具备一定的文字功底，能撰写简单的公文、报告及活动方案；\n5、有行政、活动策划或企业文化相关实习经验者优先。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787912680779,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879421549","name":"职能类","en_name":"Supporting Function","i18n_name":"职能类"},"job_id":"7679026007857105203","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_t