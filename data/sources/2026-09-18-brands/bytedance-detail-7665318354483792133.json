{"code":0,"data":{"job_post_detail":{"id":"7665318354483792133","title":"数据科学 - 抖音用户增长","description":"团队介绍：抖音用户增长（User Growth）负责抖音、今日头条、番茄小说等多个产品的用户增长业务，建立行业领先的增长和营销技术，打造极致的用户体验。加入我们，有机会参与亿级用户场景的开发与架构工作，也有机会从数据出发，利用策略和模型为业务带来更大的助力。\n\n1、负责字节跳动用户行为的理解和建模，帮助业务满足用户需求，促进业务增长；\n2、基于用户数据和业务数据，进行商业智能分析，探索业务增长机会；\n3、基于用户数据和业务数据，进行数据挖掘，探索对内容、用户、场景的认识。","requirement":"1、2027届获得本科及以上学历，计算机、统计学相关专业优先；\n2、扎实的计算机编程能力，C/C++、Java、Python、SQL/HQL均可；\n3、有较强的业务和数据理解能力；\n4、有过数据治理、数据挖掘、商业智能、算法等大数据相关项目/实习经验优先。","job_category":{"id":"6704215888985327886","name":"大数据","en_name":"Big data","i18n_name":"大数据","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784721163718,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A177827A","job_id":"7665318634348153141","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation