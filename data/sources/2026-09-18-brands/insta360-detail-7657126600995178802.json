{"code":0,"data":{"job_post_detail":{"id":"7657126600995178802","title":"传感器工程师-2027校招","description":"1、深度参与产品需求评估，针对各类传感器进行方案评估、设计选型、算法适配性评估等；\n2、负责整机传感器的原理图设计、PCB布局评估、单板功能调测、生产测试方案制定和跟进实施；\n3、负责研发过程中传感器相关问题分析解决和售后问题分析等；\n4、参与传感器新技术、新器件预研评估。","requirement":"1、本科及以上学历，电子信息、测控技术与仪器、微电子、自动化、通信工程等相关专业；\n2、扎实的数电、模电基础，熟悉运算放大器、ADC/DAC、时钟电路设计；理解 I2C、SPI、UART、MIPI 等常见数字接口协议；\n3、熟练操作常规测试仪表，具备基本的电子元器件焊接与手工调试能力；\n4、优秀责任心与团队协作能力，具备良好的上进心与学习能力，心态积极开放；\n5、具备电子竞赛、嵌入式软硬件开发、传感器性能调测等经验优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782813737298,"channel_online_status":1,"job_id":"7657126600995031346","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}