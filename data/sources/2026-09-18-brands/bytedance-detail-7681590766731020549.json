{"code":0,"data":{"job_post_detail":{"id":"7681590766731020549","title":"国际化业务销售经理 - 商业化","description":"团队介绍：抖音集团商业化是抖音集团旗下的综合数字化营销服务平台，致力于让不分行业、地域的企业及个体都能通过数字化技术激发创造、驱动生意，实现商业的可持续增长。\n\n1、负责字节跳动商业化在国际化地区广告客户的开拓与维护工作，完成既定销售指标；\n2、建立与企业的深度合作关系，解决销售过程中的各种问题和挑战；\n3、定期定量进行客户拜访与电话回访，与客户形成良好的合作关系，收集一线产品信息与意见，并拓展新客户资源；\n4、与意向客户进行沟通，与相关部门合作制定完成以客户需求为导向的客户方案。","requirement":"1、2027届获得本科及以上学历；\n2、英语可作为工作语言；\n3、有国际化学习或交换经历者优先；有国际化广告销售经验优先或者有资源渠道建联国际化客户资源的同学优先；\n4、具有敏锐的市场洞察力，执行力；有较强的沟通能力，具备良好的客户开拓、服务能力，销售谈判以及口笔表达交流的技巧；有工作激情、勤奋努力、责任心强。","job_category":{"id":"6709824272505768200","name":"销售","en_name":"Sales","i18n_name":"销售","depth":1,"children":[]},"city_info":{"code":"CT_45","name":"广州","en_name":"Guangzhou","i18n_name":"广州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788509747063,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A205910A","job_id":"7681590262463891717","city_list":[{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"jo