{"code":0,"data":{"job_post_detail":{"id":"7670391119918401838","title":"【27届校招】供给策略运营","description":"1. 供给指标运营：用 SQL / Excel 拆解业务问题，建立对GMV / CTR / CVR / 搜索无结果率等核心指标的拆解及归因方法，识别供给机会；\n2. 新品运营：协助新品全链路（出价 → 供给质量 → 流量孵化 → 营销 → 效率洞察）的运营，支持该方向上的数据分析和上下游协同；\n3. 基础协作：和搜推 / 行业 / 商家 / 产品对齐目标，追踪作业清单、输出MRD及问题归因文档；\n4. 流程总结：把单次有效动作抽象成可复用的 SOP、看板、模板，丰富供给侧作业基建。\n\n岗位优势介绍：\n*真操盘：你的策略会真的落到商家、商品、流量上——不是只做 PPT\n*完整方法论：拓供 → 选品 → 流量 → 效率，一年完整跑一遍\n*横向视野：和搜推 / 行业 / 商家 / 产品深度协作，跨部门人脉快速建立\n*战略视角：在交易战略部，直接看到平台供给侧的全景图","requirement":"1. 2027届应届生，本科及以上学历；\n2. 具备以下方向实习经验为加分项：电商 / 互联网运营 / 咨询 / 战略分析等；\n3. 数据敏感：熟练 SQL，Excel 透视表，会编程加分；\n4. 优秀的逻辑思考和表达能力，较好的情绪管理能力和团队协助能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785902262772,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287150094318389559","name":"运营类","i18n_name":"运营类"},"job_id":"7670391119918123310","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name"