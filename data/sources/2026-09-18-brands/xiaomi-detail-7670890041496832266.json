{"code":0,"data":{"job_post_detail":{"id":"7670890041496832266","title":"软件项目经理","description":"1、负责单个项目软件项目管理工作；\n2、负责项目资源的协调与组织，确保项目团队各干系人协同工作，达到项目目标；\n3、负责项目节奏及计划制定，确保项目进度以及项目质量；\n4、制定并推广项目流程规范，确保项目有序推进；\n5、进行项目风险控制、及时发现跟踪解决影响项目进度相关问题。","requirement":"1、大学本科或以上学历，物联网、软件工程、计算机、电子信息等相关专业；\n2、有极强的沟通能力、推动能力及协调能力；\n3、有过智能硬件或者App开发业务经历（实习）优先；\n4、拥有英语听说读写能力，可以正常沟通交流。\n5、了解软件开发流程和项目管理基本理论（如敏捷开发、Scrum、瀑布模型）。\n6、具备良好的沟通能力和团队协作能力。具备较强的逻辑思维和问题解决能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018405024,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7670889010936858930","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_154","name":"武汉","en