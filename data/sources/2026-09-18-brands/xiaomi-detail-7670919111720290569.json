{"code":0,"data":{"job_post_detail":{"id":"7670919111720290569","title":"车身类电子控制器系统开发工程师-汽车","description":"1. 根据整车项目时间节点要求，排布车身电控系统开发计划和管理开发进度；\n2. 管理开发目标和技术需求，并下发给供应商或相关合作伙伴，组织技术讨论和确认技术方案；\n3. 管理预算和支出，优化开发内容和开发方法，实践降本增效；\n4. 管理软件按流程、时间、质量要求，进行开发、交付和释放；\n5. 申请试验车辆和场地资源，管理标定计划和进度；\n6. 组织内外部验收和相关评审工作；\n7. 负责车身电控单元（如区域控制器、座椅模块、门模块等）的问题推进；","requirement":"1. 本科或以上，⻋辆⼯程、⾃动化、软件类、电子类等相关专业；\n2. 对电子控制器软、硬件开发有一定的了解；\n3. 具备良好的逻辑思维，问题解决和项目管理能力;\n4. 善于沟通、主动性强、临场应变能力强；\n","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025223437,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7615833493755676955","name":"整车与系统工程类","en_name":"Vehicle and Systems Engineering","i18n_name":"整车与系统工程类"},"job_id":"7670919111720126729","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"