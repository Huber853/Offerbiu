{"code":0,"data":{"job_post_detail":{"id":"7671294824947337514","title":"工艺工程师-手机","description":"【方向1】\n1.负责手机高分子结构件加工工艺方案开发、评审及量产可行性评估；\n2.负责高分子结构件加工工艺路线制定；\n3.负责高分子结构件制造制程问题的关闭、良率提升和交付。\n【方向2】\n1.负责手机结构件外观设计评审；\n2.负责手机结构件外观工艺开发及相关问题的分析解决；\n3.负责行业表面处理工艺趋势调研与分析；\n4.参与外观新工艺研发。","requirement":"【方向1】\n1.硕士及以上学历，高分子/金属无机非金属/复合材料/机械加工类专业；\n2.积极主动，自驱力强， 具备优秀的逻辑思维能力；\n3.学习能力和沟通表达能力强；\n4.执行力强，对工艺材料职能和工作环境有高度的的认同感。\n【方向2】\n1.工业设计工程、设计艺术学等相关专业；\n2.具备优秀的语言表达能力及沟通力，热爱生活，善于思考总结；\n3.关注消费性电子行业发展动态，了解每年的行业流行趋势；\n4.对手机外观件设计及工艺有一定的了解。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112658879,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671294824947190058","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_tim