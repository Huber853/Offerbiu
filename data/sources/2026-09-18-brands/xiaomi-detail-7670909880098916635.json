{"code":0,"data":{"job_post_detail":{"id":"7670909880098916635","title":"芯片设计工程师-总线方向","description":"1、负责总线相关模块的架构文档、设计文档编写；\n2、负责总线相关模块的设计开发；\n3、参与系统总线的方案制定、集成交付；\n4、支撑总线验证、交付、物理实现、样片测试等相关活动。","requirement":"1、微电子/集成电路/电子信息/通信工程/计算机等相关专业；\n2、符合如下任一条件：\na.熟悉VHDL/Verilog、SV等数字芯片设计及验证语言，参与过FPGA设计或验证，理解数字芯片综合(SYN)/时序分析(STA)；\nb.了解芯片设计基本知识，如代码规范、工作环境和工具、典型电路(异步、状态机、FIFO、时钟复位、memory、缓存管理等)；\nc.熟悉CHI.AXI/AHB/APB等AMBA或其它总线协议；\n3.积极主动，认真严谨，有良好的沟通能力和团队合作能力。","city_info":{"code":"CT_155","name":"西安","en_name":"Xi'an","i18n_name":"西安"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786023160336,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670909880098736411","city_list":[{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code"