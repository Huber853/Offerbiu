{"code":0,"data":{"job_post_detail":{"id":"7670918893741754675","title":"项目经理-汽车","description":"岗位描述：\n1、项目计划跟踪\n对新项目主计划评估，组织二级计划的制定与实施；\n2、新品计划评审\n组织新品项目订单评审、生产计划评审及执行；\n3、生产准备推进\n组织生产准备确认、工艺验证质量活动完成情况跟踪，配合项目组拉动各节点生产启动推进，按节点达成目标；\n4、新品节点交付物确认及过程问题推动\n组织新品各节点自评及交付物确认，推进项目节点遗留问题关闭；\n5、新品通知确认及下发\n承接特殊订单生产评估、订单排产、生产通知下发、交付跟踪、过程问题推进、下发转批量通知。","requirement":"任职资格：\n1、本科及以上学历，理工科专业；\n2、学习能力强，思路清晰，团队合作能力好，适应快节奏、高效率工作，良好的沟通能力和组织能力，有院校活动组织经验优先；\n3、具有整车厂实习经验者优先。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025095742,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670918893741574451","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"tag