{"code":0,"data":{"job_post_detail":{"id":"7669721871590263045","title":"游戏技术美术工程师 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、负责游戏中各种视觉效果和游戏表现的开发工作；\n2、负责配合美术制定各类美术资产的制作规格，制作流程以及规范；\n3、负责配合引擎程序，使各类效果均能够同时满足视觉表现和性能标准的要求，在全平台都有震撼的美术表现效果；\n4、跟踪行业技术动态，不断提升自身专业技能，为团队带来新的品质提升思路和方法。","requirement":"1、2027届获得本科及以上学历；\n2、有较好的美术专业能力以及较高的审美能力，熟悉游戏美术各类资源开发流程和规范；熟悉AAA游戏中常见的渲染技术，在某些领域能有很深入的了解，如角色和场景渲染技术等；\n3、熟悉Unreal引擎，具备良好的图形学基础，能够在引擎中实现复杂的Shader；\n4、熟悉常用DCC-3ds Max、Maya、Houdini、SP/SD等，有丰富的制作工具和流程工具的开发经验；\n5、具备良好的分析解决问题能力，责任心强、对工作质量有高标准要求、学习能力强、有良好的沟通能力和团队合作精神；\n6、擅长写实风格的效果开发，有3A游戏研发经验者优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746297349,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A191888","job_id":"7660717787799931189","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_lis