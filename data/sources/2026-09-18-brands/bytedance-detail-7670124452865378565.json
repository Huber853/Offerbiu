{"code":0,"data":{"job_post_detail":{"id":"7670124452865378565","title":"服务策略 - 体验与服务","description":"团队介绍：体验与服务部门是为用户的体验和服务负责。关心用户的诉求，通过智能化和人工能力，帮助用户解决问题；基于问题洞察，协同产品提升用户体验，促进业务长期发展。\n\n1、负责用户服务策略制定，对抖音用户服务场景的服务类指标负责，包括但不限于智能服务解决率、人工服务解决率、转人工率等；\n2、推动AI大模型在智能服务方向的探索和落地，使抖音的用户服务在行业内处于领先水平；\n3、重点统筹智能服务策略，优化智能侧的服务流程、产品交互设计、用户意图识别及优化解决方案，沉淀运营标准，提升智能解决能力；\n4、搭建智能服务全链路指标体系，监控数据异常及时应对和部署，同时通过数据分析识别业务问题、推动解决。","requirement":"1、2027届获得本科及以上学历；\n2、对智能服务和AI大模型有较高的热情和好奇心；有敏锐的问题洞察能力及良好的逻辑思考能力；\n3、有良好的书面和口头表达能力，具备良好的沟通与团队协同意识，能有效推进跨团队合作；\n4、具备强烈的好奇心、同理心，具有换位思考的意识和能力，有韧性、有上进心。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785840315793,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A146121","job_id":"7670124610978023733","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京",