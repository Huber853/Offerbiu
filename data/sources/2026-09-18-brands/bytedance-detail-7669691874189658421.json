{"code":0,"data":{"job_post_detail":{"id":"7669691874189658421","title":"经营分析 - 商业化","description":"团队介绍：抖音集团商业化是抖音集团旗下的综合数字化营销服务平台，致力于让不分行业、地域的企业及个体都能通过数字化技术激发创造、驱动生意，实现商业的可持续增长。\n\n1、负责行业及同类型产品研究，通过数据分析洞察业务、行业痛点，提出有效建议；\n2、搭建业务经营分析框架，并通过数据分析为业务运营提供决策依据；\n3、关注目标执行过程追踪，拉通协调资源解决业务卡点，并协助部门负责人完成日常经营工作。","requirement":"1、2027届获得本科及以上学历，统计学、数据分析等专业优先；\n2、优秀的数据敏感度，有丰富的数据挖掘、信息采集整理和逻辑分析能力；\n3、有丰富的跨团队、部门的项目资源整合能力，有较强的逻辑思维能力；\n4、精通Excel和PPT，熟练使用SQL或其它数据分析工具优先。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785739333689,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A55045A","job_id":"7666024322704525573","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node