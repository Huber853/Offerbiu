{"code":0,"data":{"job_post_detail":{"id":"7663415250988960019","title":"热设计工程师（AG）-2027校招","description":"1、参与无人机类产品热设计方案评估，涵盖自然散热和风冷散热；\n2、协同硬件、结构团队完成散热方案设计及散热物料选型；\n3、产品热设计工况拟定和测试，持续优化散热性能以满足产品规格要求；\n4、量产一致性/售后热问题改进优化，提升产品质量和体验；\n5、参与热设计技术研究、竞品分析及新材料新技术调研。","requirement":"1、硕士及以上学历，热能与动力、工程热物理等相关专业；\n2、掌握传热学、流体力学基础，熟悉自然/风冷散热原理；\n3、掌握温升测试方法和相关设备的使用；\n4、熟练使用至少一种热仿真软件及三维建模软件；\n5、优秀的抗压能力和责任心，良好的团队协作和沟通能力；\n6、有相关竞赛、科研项目或实习经验者优先。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784278125646,"channel_online_status":1,"job_id":"7663414563741157673","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}