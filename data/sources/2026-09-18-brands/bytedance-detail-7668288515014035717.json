{"code":0,"data":{"job_post_detail":{"id":"7668288515014035717","title":"抖音泛资讯运营经理 - 抖音内容运营","description":"团队介绍：致力于通过热点内容管理、平台沟通与信任建设、编辑与研判等手段，持续为打造健康繁荣的抖音内容生态护航，提升用户内容消费体验。同时我们希望以创新的智能内容挖掘与理解为手段，针对低质、争议、谣言、虚假等问题展开治理，营造一个良好的内容消费氛围。\n\n1、围绕全网公共事件、抖音原生热点，推动优质内容生产和发酵，做好热点管理和运营；\n2、理解短视频内容生态及热点潜在风险，能针对风险定位原因，对接相关部门，有效配合落地执行；\n3、推动跨部门合作，与产品、垂类、策略等模块密切配合，为产品目标负责。","requirement":"1、2027届获得本科及以上学历；\n2、从事过媒体、热点运营、内容策划、账号运营相关岗位优先；资讯敏感度高，熟悉各领域垂直媒体，知识面广泛、兴趣多元化，对热点发酵规律和潜在风险有判断；\n3、对热点事件、话题的价值有判断力，且有推动热门事件、人物、城市走红的成功案例；\n4、熟悉短视频产品的玩法，对内容趋势有高度敏感性，知道平台上什么热，为什么热；\n5、具备高度责任心，具备积极应对挑战的态度。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785412712232,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A124419","job_id":"7667890621390162229","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","na