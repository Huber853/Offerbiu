{"code":0,"data":{"job_post_detail":{"id":"7669357192973355317","title":"AI产品经理（搜索策略方向） - 抖音电商","description":"团队介绍：抖音电商以“总能发现好东西”为主张，致力于成为用户发现丰富好物的首选平台。众多抖音创作者通过短视频、直播、商城等丰富的形式，给用户提供更个性化、更生动、更高效的消费体验。同时，抖音电商积极引入优质合作伙伴，为商家变现提供多元的选择。\n\n1、负责搜索广告策略产品（流量策略、投放策略、创意策略等）的相关工作，根据业务场景，设计对应方案，明确优先级，并与协作团队完成产品落地交付；\n2、快速了解并熟悉搜索广告相关产品及策略，并可以设计相关方案解决业务问题；\n3、通过数据分析，定位样式相关的问题，并能与研发共同完成问题优化及上线；\n4、通过协同研发、设计、数据、测试、运营等多职能团队，完成项目的推进及落地。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、对竞价广告或搜索广告有一定了解，并对策略类工作感兴趣；\n3、具备良好的数据分析能力，逻辑性强；\n4、心态开放，善于沟通与协调，有灵活解决问题的方法，有团队合作精神，执行力强。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785662239344,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A108446A","job_id":"7665181659211335941","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_p