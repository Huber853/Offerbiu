{"code":0,"data":{"job_post_detail":{"id":"7677507816106084635","title":"【27届校招】商家工具产品经理-得物国际","description":"1、负责商家工具的产品规划与建设，核心方向包括但是不限于：入驻、招商、商家数据工具（经营看板、数据报表、诊断分析）与费率工、营销工具等，并持续拓展其他商家经营工具；\n2、深入商家经营场景，挖掘商家在平台运营中的真实痛点和需求，产出可落地的产品方案；\n3、数据驱动决策：独立使用 SQL 取数分析，评估功能价值、验证方案效果，用数据说话；\n4、跨团队协作，推动研发、设计、运营落地，对工具的使用效果和商家体验负责；\n5、探索用 AI 与自动化工作流（如 Agent 编排、自动化提效）优化商家工具效率和体验。","requirement":"1、2027届应届生，本科及以上学历 ，专业不限；\n2、熟练使用 SQL，能独立完成数据提取与分析；\n3、数据驱动，习惯用数据发现问题、验证假设；\n4、学习能力强、逻辑清晰，能快速进入陌生业务领域；\n5、对 AI 工具有热情，能搭建简单的 AI 工作流 / 自动化流程。\n符合以下一条或多条者，适度优先：\n1. 有电商 / SaaS / 商家工具相关实习或项目经验。\n2. 用飞书多维表格、Coze、Dify、n8n 等搭过自动化流程。\n3. 有 SQL 数据作品集或数据分析项目。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787562036394,"channel_online_status":1,"job_subject":{"id":"7667878562901690634","name":{"zh_cn":"2027届秋季校园招聘项目","i18n":"2027届秋季校园招聘项目"},"active_status":1},"job_function":{"id":"7287149935865874725","name":"产品类","i18n_name":"产品类"},"job_id":"7677507816105773339","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_nam