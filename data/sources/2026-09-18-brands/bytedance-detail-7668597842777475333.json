{"code":0,"data":{"job_post_detail":{"id":"7668597842777475333","title":"安全研发工程师（终端安全） - 安全与风控","description":"团队介绍：我们团队研发尖端云安全解决方案，为字节跳动及企业客户提供规模化安全防护。\n依托安全部门深厚的技术积累，以及对客户安全需求的深刻理解，我们借助领先技术与产品，通过全方位智能防御体系应对各类实际安全挑战。\n我们的工作确保云环境始终安全、可靠，为整个组织的创新实践提供有力支撑。\n\n1、负责终端安全产品各项功能的设计和研发；\n2、协同安全运营团队，针对复杂多变的安全攻防形势不断优化和改进检测能力；\n3、持续迭代优化系统，保障系统的高并发、低延迟及稳定性，并且具有良好的容灾能力。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程、网络安全等相关专业优先；\n2、熟悉Linux操作系统和开发环境，有良好的数据结构、算法基础和系统设计能力；\n3、至少熟悉一种主流编程语言（Go/C++/Rust等），有扎实的编程能力和良好的编码风格，有大模型使用经验优先；\n4、有良好沟通能力，工作积极主动，责任心强，具备良好的团队协作能力。","job_category":{"id":"6704216109274368264","name":"安全","en_name":"Security","i18n_name":"安全","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785484603765,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A48371","job_id":"7668597841670146357","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value