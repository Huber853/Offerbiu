{"code":0,"data":{"job_post_detail":{"id":"7657123485806577983","title":"软件产品经理-2027校招","description":"1、负责软件产品规划、产品设计、产品管理工作，包括拍摄功能、模版创意产生、算法效果预研、产品需求文档输出与跟进上线；\n2、以功能的关键数据指标提升为目标进行产品规划，能够基于数据分析、竞品调研和用户分析提出创新且有价值的方案；\n3、负责和预研、算法平台、应用软件等部门沟通并能够协调资源帮助实现新的模版，和各个团队形成紧密合作；\n4、能够基于用户场景出发设计出适合不同场景（如运动、旅行、生活）拍摄和剪辑的智能模版，帮助用户更好地记录和分享生活，提升用户的剪辑体验。","requirement":"1、热爱摄影、剪辑，能够形成有价值的拍摄创意和剪辑创意；\n2、了解图像、视频基础知识和原理；\n3、具备良好的沟通协调能力，能够积极主动和其他部门沟通合作；\n4、有持续主动学习的能力，富有责任感，主动将方案推动落地，具备独立思考和创新精神。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782813165796,"channel_online_status":1,"job_id":"7657123485806430527","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}