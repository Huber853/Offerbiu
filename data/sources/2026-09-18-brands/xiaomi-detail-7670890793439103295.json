{"code":0,"data":{"job_post_detail":{"id":"7670890793439103295","title":"射频仿真工程师-手机","description":"1.负责射频无源器件的测试及建模，深入研究测试、夹具设计、等效电路拟合等关键技术点，提升模型精度\r\n2.负责射频有源器件（PA/LNA）的测试建模，搭建loadpull及sourcepull系统并完成器件模型的输出\r\n3.结合射频电路原理与仿真技术，给出原理图、layout设计建议，并对硬件问题的攻关给予仿真协助\r\n4.负责新器件引进及器件不良分析过程中的电性能分析及测试工作","requirement":"1.电磁场、微波、天线等相关专业方向，硕士学历及以上\r\n2.具有扎实的电磁场与微波理论基础，掌握射频电路设计相关基础知识，了解无线通信协议，如GSMLTE等\r\n3.熟练掌握至少一种常用电磁仿真软件，如HFSS、ADS、CST等\r\n4.熟练掌握测试仪器操作，如矢量网络分析、频谱仪、信号发生器等","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786018523263,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670890383413840169","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_statu