{"code":0,"data":{"job_post_detail":{"id":"7667878785194199301","title":"客户端开发工程师 - APM","description":"团队介绍：字节跳动APM(Application Performance Management) 团队负责公司所有服务端、移动端、前端、跨端产品的稳定性和性能质量监控保障，构建业界领先的可观测性基础设施，结合机器学习智能化，提供一站式平台覆盖字节跳动各业务线的排障、监控和稳定性提升等需求。\n\n1、负责字节跳动客户端（Android\u0026iOS）基础SDK开发，包括性能和稳定性的监控和优化，分析调试工具等；\n2、负责参与移动端智能框架的模块设计、功能实现以及性能优化，协助业务应用端智能技术，提升业务效果；\n3、负责移动端基础设施在公司内的业务落地；\n4、关注技术前沿，探索新技术在业务场景中的实践。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、具有扎实的编程功底，良好的设计能力和编程习惯；\n3、熟练掌握Objective-C/C++/Swift/Java/Kotlin其中一门语言优先；\n4、有个人技术博客、论文、GitHub项目或独立开发作品优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785317174046,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A220723","job_id":"7667878336690292997","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_ty