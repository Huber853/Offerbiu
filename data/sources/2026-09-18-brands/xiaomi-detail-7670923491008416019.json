{"code":0,"data":{"job_post_detail":{"id":"7670923491008416019","title":"成本管理专员","description":"1.供应商账单核对：负责与供应商对接，完成每月账单数据的核对与确认，确保账单数据准确无误，及时发现并处理账单差异；\n2.账单异常分析：对账单数据进行异常识别与深入分析，定位异常原因，输出分析报告，推动问题闭环解决；\n3.付款信息审核与跟进：审核供应商付款信息的完整性与合规性，跟进成本支付流程，保障付款及时准确；\n4.成本数据运营：搭建及维护成本运营相关数据体系，保证成本数据的及时性与准确性，构建成本运营数据分析机制。","requirement":"1.财务、会计、统计、数据分析等相关专业优先；\n2.具备良好的数据分析能力，熟练使用 Excel/SQL/BI 工具，能独立完成数据核对与异常分析；\n3.较好的沟通协调能力与抗压能力，善于跨部门多团队协作；\n4.性格踏实肯干，思维严谨细致，具有较强的责任心；\n5.英语四级及以上（如涉及海外供应商）。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026190159,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879421549","name":"职能类","en_name":"Supporting Function","i18n_name":"职能类"},"job_id":"7670923491005679914","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY0000000