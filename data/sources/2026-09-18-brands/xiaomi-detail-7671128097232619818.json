{"code":0,"data":{"job_post_detail":{"id":"7671128097232619818","title":"测试开发工程师","description":"1、负责相关业务质量保障工作，包括系统测试、自动化测试、质量专项等工作，负责业务线稳定性功能测试。\n2、根据产品和技术方案设计测试方案，完成用例编写和测试脚本开发，根据业务目标制定测试计划并推动目标达成；\n3、负责测试环境的搭建、针对业务产品进行功能和非功能测试；\n4、深入理解系统内部设计原理，从测试视角提出合理的优化建议。","requirement":"1、计算机相关专业，本科及以上学历；\n2、具备一定的编程能力，熟练掌握Java/Python/JavaScript/C/C++或各类脚本语言中一种；\n3、熟悉软件测试理论与方法，对互联网相关业务或技术充满好奇及热情；\n4、快速的产品及业务学习能力，敏捷而周到的逻辑思维能力；\n5、有主动性、有担当，工作严谨认真；\n6、具良好的敬业精神、沟通能力和团队合作精神。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786073873668,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761529010634860","name":"测试类","en_name":"Testing","i18n_name":"测试类"},"job_id":"7671128097232439594","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1},{"code":"CT_155","name":"西安","en_name":"Xi'an","location_type":3,"i18n_name":"西安","py_name":"xian","mdm_code":"MDCY00000395","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability"