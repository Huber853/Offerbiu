{"code":0,"data":{"job_post_detail":{"id":"7670812949539883317","title":"机器学习平台研发工程师 - Data AML","description":"团队介绍：Data AML是字节跳动的机器学习中台，为抖音/今日头条/西瓜视频等业务提供推荐/广告/CV/语音/NLP的训练和推理系统。为公司内业务部门提供强大的机器学习算力，并在这些业务的问题上研究一些具有通用性和创新性的算法。同时，也通过火山引擎将一些机器学习/推荐系统的核心能力提供给外部企业客户。\n\n1、负责AML机器学习平台的开发与优化，打造聚焦AI开发者体验的机器学习平台；\n2、理解算法工程师的业务需求，围绕模型的开发、调试、训练、评估和推理等全生命周期设计解决方案，持续提升算法工程师的迭代效率。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、熟练掌握Linux环境下的Golang/C++/Python语言；\n3、有机器学习算法或大规模分布式系统相关实习经验优先；\n4、对PyTorch、DeepSpeed等机器学习框架，以及推荐、搜索、LLM等领域的前沿算法感兴趣，愿意深入研究和探索。","job_category":{"id":"6704219534724696331","name":"机器学习","en_name":"Machine learning","i18n_name":"机器学习","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786000334297,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A143727","job_id":"7670812211263146293","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_