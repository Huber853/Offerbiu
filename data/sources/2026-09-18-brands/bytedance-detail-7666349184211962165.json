{"code":0,"data":{"job_post_detail":{"id":"7666349184211962165","title":"行业运营（服饰与健康母婴） - 商业化","description":"团队介绍：抖音集团商业化是抖音集团旗下的综合数字化营销服务平台，致力于让不分行业、地域的企业及个体都能通过数字化技术激发创造、驱动生意，实现商业的可持续增长。\n\n1、负责广告业务的本地行业运营，对行业客户的投放效果负责，持续探寻客户ROI改善的策略路径；推进方案执行，监督执行效果，从而有效提升重点客户生意增长，产出优质案例；\n2、根据业务场景及行业痛点，提供综合的商业产品解决方案，定期输出方法论；\n3、深入了解广告主需求和字节跳动的广告平台属性，为广告主量身定制运营方案及账户优化建议，并推动落地和效果优化，并能够总结客户投放技巧，进行经验复制；\n4、与各团队紧密合作，推进重点广告主需求挖掘、产品测试、产品案例包装等，推动产品迭代，提升广告主投放效果和消耗量级，并沉淀行业运营方法论。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、对移动互联网相关行业有一定的了解，有自己的观点和看法，有产品运营或行业运营相关实习经验优先；\n3、有较强的沟通能力，逻辑清楚，踏实勤奋，且善于总结；\n4、对数据有敏感度，善于从数据结论发现并总结问题。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784962762875,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A60246","job_id":"7666036566377072949","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for