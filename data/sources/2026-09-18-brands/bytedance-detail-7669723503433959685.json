{"code":0,"data":{"job_post_detail":{"id":"7669723503433959685","title":"游戏怪物策划（PVE射击游戏） - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、负责设计怪物的玩法机制和行为模式，并制作怪物行为树与早期玩法Demo；\n2、协调美术与程序，跟进原画、模型、动作、特效等资源以实现策划目标；\n3、跟进调优怪物的玩法机制、打击感、行为细节、动画表现和数值参数。","requirement":"1、2027届获得本科及以上学历；\n2、怀揣做高品质游戏理想，对游戏行业有强烈热情及成就动机，同时有良好的自驱力及责任心，良好的沟通能力和逻辑性、协作能力，游戏经验丰富，对任一款【PVE/PVEVP】射击游戏、动作游戏有深入研究，熟悉其核心机制与设计差异，至少1-2款PC射击游戏有深度体验。\n\n有以下经验加分：\n1、了解任意引擎的动作系统、行为树逻辑、状态机等；\n2、对科幻、军事以及小众文化有兴趣及积累；\n3、有动作、模型设计能力；\n4、对AI使用有较为丰富的理解和使用经验；\n5、热爱PVE射击游戏者优先。","job_category":{"id":"6850051245315459342","name":"游戏数值策划","en_name":"Game Statistics","i18n_name":"游戏数值策划","depth":2,"parent":{"id":"6850051244971526414","name":"游戏策划","en_name":"Game Design","i18n_name":"游戏策划","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746673761,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A108543","job_id":"7660408457586034997","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_l