{"code":0,"data":{"job_post_detail":{"id":"7667970666129737989","title":"客户端开发工程师（AI应用框架方向） - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、负责移动端基础架构核心模块开发，构建高性能、可扩展的客户端应用；\n2、参与跨端应用框架的研发与优化，提升框架稳定性与运行效率；\n3、持续优化客户端性能指标（启动速度、内存管理、渲染效率等），提升用户体验；\n4、探索AI技术与移动端的创新结合，参与智能化功能开发与落地实践。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、掌握Android/iOS系统机制，熟悉MVVM/MVP等架构模式；\n3、具备跨平台开发经验者优先（Flutter/RN/小程序框架等）；\n4、对AI技术有兴趣者优先，有智能推荐/语音交互/大模型应用等实践经验更佳；\n5、具备良好的技术热情和学习能力。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785338901096,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A179140A","job_id":"7667971132745730357","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level