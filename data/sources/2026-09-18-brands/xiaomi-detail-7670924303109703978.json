{"code":0,"data":{"job_post_detail":{"id":"7670924303109703978","title":"安全研发工程师","description":"1.参与安全部门安全类项目设计、研发、架构优化工作；\n2.追踪行业安全实践，攻关关键技术，以行业领先为目标持续研发产品。","requirement":"1.具备扎实的操作系统、计网络等计算机基础理论知识；\n2.具备扎实的 Go 语言基础，过硬的编程能力，熟练掌握常见数据结构和算法；\n3.熟悉 Linux 平台的基本开发技能，掌握至少一种脚本开发语言（python，shell等）；\n4.开发过或者深入了解过 WAF、零信任、扫描器、静态代码检测、KMS、RASP、NIDS、HIDS、SOC等至少一类安全项目；\n5.能够发掘和分析小米安全需求，完成系统设计、产品研发、落地方案；\n6.至少熟悉 Web、IoT 、移动等安全方向的其中一类；\n加分项\n1.GitHub 上有持续维护的开源项目；\n2.在自己 Blog、公共平台、会议有技术分享，持续跟踪业内创新的安全技术和项目；\n3.发现开源系统漏洞，或者向大中型企业提交过安全漏洞。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026389704,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670924303109523754","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北