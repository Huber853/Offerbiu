{"code":0,"data":{"job_post_detail":{"id":"7671128945056434475","title":"硬件研发工程师-sensor方向","description":"1、CMOS图像传感器的特性分析和仿真，并进行画质的客观测量与仿真分析；\n2、CMOS图像传感器的认证和规格制定，确保高质量交付产品供项目使用；\n3、分析测试过程中遇到问题并与团队一起制定解决方案，改善品质和优化测试效率；\n4、分析相机产品中图像传感器引起的画质问题，协调相关部门或供应商制定解决方案；\n5、与相机软硬件团队共同讨论制定影像整体解决方案。","requirement":"1、大学硕士以上学历，微电子、电子工程、半导体、集成电路设计等相关专业毕业；\n2、1-3个图像传感器测试评价相关项目或者实践经验；\n3、具有一定的测试数据分析经验，包括实验室数据和生产批量数据；\n4、 具备良好的表达和沟通能力，具备良好的团队合作精神，英语可用于工作沟通交流。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786073927901,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7671128945056303403","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"tag_list":[