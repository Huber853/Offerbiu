{"code":0,"data":{"job_post_detail":{"id":"7670915000471832841","title":"动力电池热管理工程师-汽车","description":"1. 负责电池系统热仿真分析，建立电池系统1D和3D热仿真模型；\n2. 负责电池系统在不同工况下的热仿真计算，输出仿真报告；\n3. 负责电池冷却系统CFD仿真分析，为电池冷却系统零部件设计提供优化建议；\n4. 优化电池热管理控制策略，对电池热管理冷却流量、温度阈值进行仿真优化；\n5. 负责跟踪行业技术前沿发展动态，识别关键技术进行立项开发，负责热管理技术路线制定。","requirement":"1. 硕士及以上学历，汽车工程、热力学、流体力学、机械工程等相关专业； \n2. 熟练使用STAR CCM、Fluent 等主流CFD软件，熟练使用AMESIM 1D热仿真软件；\n3. 熟悉CATIA等3D结构设计软件；\n4. 熟悉电池系统基本原理、结构，熟悉电池系统开发流程及技术标准；\n5. 沟通能力良好，责任心强，学习能力强。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024285395,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670915000471669001","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY0