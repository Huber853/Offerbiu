{"code":0,"data":{"job_post_detail":{"id":"7668297472185977093","title":"抖音热点资讯编辑 - 抖音内容运营","description":"团队介绍：致力于通过热点内容管理、平台沟通与信任建设、编辑与研判等手段，持续为打造健康繁荣的抖音内容生态护航，提升用户内容消费体验。同时我们希望以创新的智能内容挖掘与理解为手段，针对低质、争议、谣言、虚假等问题展开治理，营造一个良好的内容消费氛围。\n\n1、配合热点资讯业务完成AI编辑工作，构建新的人-机协同模式；\n2、负责AI资讯内容生产、安全和质量评测的工作，通过评测发现问题，联动上下游共同解决安全和质量问题；\n3、借助数据分析、内容拆解对模型问题进行分析，提供解决思路及优化方向，输出有价值的分析报告辅助模型迭代优化；\n4、跨团队合作协调，建立完善的运营机制，协同业务、产品、算法、等团队，支撑进审策略、审核标准、交付质量的提升和优化。","requirement":"1、2027届获得本科及以上学历，大模型或AI相关专业；\n2、对资讯内容的价值、质量有判断，有主流资讯平台实习经验者优先；\n3、对新产品、新技术保持高度的好奇心和探索欲，具备较好的适应能力，具备良好的环境适应与项目协调能力，用AI化的能力去解决问题。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785414754819,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A238018A","job_id":"7668156955499874565","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","