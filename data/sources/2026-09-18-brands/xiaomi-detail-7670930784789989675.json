{"code":0,"data":{"job_post_detail":{"id":"7670930784789989675","title":"产品运营经理","description":"1.针对用户，策划运营活动并落地执行；结合数据分析，评估效果，不断优化活动方案或方向；\n2.对不同类型的用户，细化分类，与产品配合，产出有针对性的运营方案，提升各项转化率，提升用户活跃、留存；\n3.根据活动、用户反馈需要，建立社群运营体系并落地；\n4.根据用户反馈，推动产品迭代，挖掘用户深层次的需求，有效提升用户粘度和忠诚度，建立长期的用户运营体系。","requirement":"1.心理学、社会学、工业设计、人机交互等相关专业本科及以上学历，有互联网用户运营实习经验优先；\n2.拥有产品和创新意识，执行力强，对热点和行业敏感；\n3.有较强的策划和文案撰写能力，熟练使用Excel、word、powerpoint等办公软件；\n4.对数据敏感，有较强的数据分析能力，对定量与定性研究方法，如问卷调查、后台数据分析、用户访谈、焦点座谈会、田野调查、可用性测试等研究方法有一定涉猎；\n5.拥有团队合作精神、富有创造力、有强烈好奇心、研究热情。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786027867646,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670930784789825835","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name"