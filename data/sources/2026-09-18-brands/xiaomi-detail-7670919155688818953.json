{"code":0,"data":{"job_post_detail":{"id":"7670919155688818953","title":"电驱SIE工程师-汽车","description":"1、参与/支持/协助电驱系统（总成、电机、壳体、齿轴、MPU等）量产阶段质量问题原因分析，支持跨部门（研发、生产、采购）协作推动；\n2、参与/支持/协助建立电驱系统（总成、电机、壳体、齿轴、MPU等）的失效库建立；\n3、参与/支持/协助电驱系统（总成、电机、壳体、齿轴、MPU等）的LL规避，产线审核（如PPAP、过程审核），评估并确保生产一致性，参与扩能计划并验证产能提升后的质量稳定性。","requirement":"1、本科及以上学历，车辆工程、机械工程、材料科学与工程等相关专业；\n2、熟悉电机、电控、减速器、齿轴等系统结构和工作原理，掌握DFMEA基础分析方法；\n3、了解汽车制造工艺，如冲压、压铸、焊接等，具备CATIA/UG/AutoCAD等三维建模能力；\n4、熟练使用Excel数据透视表及VBA/Python优先，具备基础数据分析能力；\n5、逻辑清晰，具备快速学习与沟通协调能力；\n6、对汽车行业有强烈兴趣，接受阶段性出差至供应商/工厂现场支持；\n7、有电机、电控、减速器、齿轴相关课程设计/毕业论文项目经验（如应力仿真、电池结构优化）优先；\n8、熟悉IATF 16949质量体系或APQP流程。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025127705,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178830559051874412","name":"硬件研发类","en_name":"Hardware R\u0026D","i18n_name":"硬件研发类"},"job_id":"7670919155688638729","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_l