{"code":0,"data":{"job_post_detail":{"id":"7657128504807573810","title":"振动与力学工程师-2027校招","description":"1、负责设计和优化新产品的振动、跌落、冲击、疲劳、湿热固耦合、轻量化等特性，承担相关预研课题和解决项目实际难题，探索解决方案；\n2、进行产品力学设计的敏感性分析和冗余度设计，确保量产过程中的可靠性和一致性；\n3、分析和优化复杂系统的激励源和传递路径，测试并验证系统振动性能，并制定检测方法和管控标准；\n4、进行多体系统的刚柔耦合动力学建模与仿真，编写相关接口程序与控制模型及负载工作模型。","requirement":"1、硕士及以上学历，机械、力学、船舶、车辆工程、航空航天、机器人等相关专业；\n2、熟悉材料力学、理论力学、固体力学、振动力学、有限元理论、多体动力学等相关理论；\n3、熟练使用常用仿真软件和测试工具进行产品优化，包括跌落碰撞、模态、频率响应、疲劳、拓扑优化等；\n4、具有数学、物理、力学、机器人等国家级以上竞赛及获奖经验者优先考虑；\n5、具备强大的自驱力、学习力和动手能力，保持对未知领域的好奇心，喜欢接受挑战，有良好的沟通能力和责任心，具备良好的抗压能力。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1782814390856,"channel_online_status":1,"job_id":"7657128504807426354","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}