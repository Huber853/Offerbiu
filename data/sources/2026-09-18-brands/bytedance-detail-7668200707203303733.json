{"code":0,"data":{"job_post_detail":{"id":"7668200707203303733","title":"AI Agent研发工程师（客服方向） - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责火山引擎大模型应用的后端服务研发，基于火山引擎的大模型能力，构建面向智能客服领域的行业Agent，如智能外呼、智能客服、对话分析等；\n2、构建易运营、易集成的公有云服务，通过标准化平台的方式支持项目规模化落地；\n3、负责线上系统的维护，通过构建高并发、高可用的服务架构，持续提升线上系统的稳定性；\n4、探索Agent方向的创新方法与技术，并将这些新技术应用到产品中，持续优化Agent的效果、性能以及用户交互体验，提升Agent的行业领先性。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、精通数据结构和算法设计，熟练掌握Python/Java/Go等至少一门语言；\n3、对大模型有深入理解，熟悉LLM技术原理与应用方法，有Agent系统设计与实现经验优先；\n4、在ACM/NOI/IOI/TopCoder获奖者优先；\n5、具备良好的团队沟通协作能力，能和团队一起探索新技术，推进技术进步。","job_category":{"id":"6704215862557018372","name":"后端","en_name":"Backend","i18n_name":"后端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785392112806,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A37244A","job_id":"7667885890849196341","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"paren