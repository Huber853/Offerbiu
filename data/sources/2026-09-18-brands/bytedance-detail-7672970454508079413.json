{"code":0,"data":{"job_post_detail":{"id":"7672970454508079413","title":"创意视觉设计师 - 番茄小说","description":"团队介绍：番茄小说是抖音在 2019 年推出的免费阅读产品，致力于为读者提供优质的阅读体验。番茄小说拥有海量正版小说，涵盖言情、都市、玄幻、悬疑等主流网文类型，以及大量热剧原著和经典出版物，支持用户看书、听书。\n\n1、负责番茄小说、番茄畅听、红果短剧、创新产品等业务的视觉设计工作，包括但不限于产品体验、品牌宣发、运营活动、IP形象等相关设计工作；\n2、结合业务特性分析需求目标，完成前期创意和设计执行落地，为项目提供有创意和想象力的设计方案；\n3、关注新风格，新技术，具备设计敏感度，参与设计侧驱动的创新探索。","requirement":"1、2027届获得本科及以上学历，艺术、美术、视觉设计等相关专业优先；\n2、熟练使用基础设计软件，Photoshop、AI、Figma或AE、C4D等，有良好的平面设计能力与审美；\n3、具备品牌思维、创意能力、娴熟的绘画技巧，对设计流行趋势有敏锐的洞察力，能够突破传统进行设计创新，可以熟悉使用AIGC工具并有实际应用经验优先；\n4、善于与人沟通、思维清晰，具备良好的团队合作精神、强烈的学习热情和自驱力，乐于分享。","job_category":{"id":"6709824272627403020","name":"视觉设计","en_name":"Visual Design","i18n_name":"视觉设计","depth":2,"parent":{"id":"6709824272514156812","name":"设计","en_name":"Design","i18n_name":"设计","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786502818650,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A54609","job_id":"7672969088792480005","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_li