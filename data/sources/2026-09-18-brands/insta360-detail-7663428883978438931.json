{"code":0,"data":{"job_post_detail":{"id":"7663428883978438931","title":"视觉设计师-2027校招","description":"我们正在寻找一位具有创新思维与卓越审美的视觉设计师，专注于塑造公司新品发布的视觉表现。你将通过打造符合品牌调性并具有市场竞争力的视觉设计方案，助力公司新品在市场上脱颖而出。\n\n岗位职责\n1、通过独立的视觉创意设计，完成产品视觉方案的交付\n2、与跨部门团队紧密合作，推动视觉设计方案的落地与执行\n3、持续跟进全球设计趋势，结合 AIGC 技术推动设计创新\n4、梳理并优化视觉设计规范，提升设计效率与一致性，确保高品质交付","requirement":"1、本科及以上学历，视觉设计相关专业，2027 届应届毕业生\n2、扎实的视觉设计理论基础，具备良好的审美能力和创意表达能力\n3、能够熟练使用主流设计工具和软件，对新兴设计趋势和 AIGC 工具保持关注与学习热情\n4、有完整项目经历或实习经验（实习经历不限行业），能展示独立完成的设计作品\n5、具备长期与公司共同发展的意愿，持续进步。喜欢迎接创新，有好玩的生活概念。","recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1784281199382,"channel_online_status":1,"job_id":"7663428233745352966","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"tag_list":[],"storefront_mode":1,"storefront_list":[],"process_type":2},"recommend_job_post_List":[]},"message":"ok","error":null}