{"code":0,"data":{"job_post_detail":{"id":"7670884708876601650","title":"培训运营主管","description":"1、运营规划：负责常规培训、以及新产品上市培训等各类培训项目的运营策划、及标准化运营方案的输出；\n2、运营准备：协调内部及外部供应商资源、进行培训落地前各项运营准备工作；\n3、执行\u0026复盘：能高效推动现场运营执行、及后期复盘迭代工作；且针对突发状况、能灵活应对、并前置准备预案；\n4、负责培训平台的规划、与产品经理对接并落地、能进行课程创建、资料上传、考核等相关培训后台的工作；\n5、负责培训数据分析整合、费用测算等相关的数据工作；\n6、其他培训运营相关的工作。","requirement":"1、细致耐心、项目管理能力强；\n2、有责任心、执行力和推动力强；\n3、能灵活应对突发情况、提前做好预案；\n4、开放心态、能接受他人建议；能积极主动与他人达成共识；\n5、本科及以上学历；有C1驾照。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017148853,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670884708876437810","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"tag_list":[],