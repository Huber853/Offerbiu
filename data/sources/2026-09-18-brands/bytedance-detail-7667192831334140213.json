{"code":0,"data":{"job_post_detail":{"id":"7667192831334140213","title":"客户端开发工程师 - 抖音研发","description":"团队介绍：抖音研发部门负责多款大型产品的研发，包括但不限于抖音、西瓜视频、汽水音乐。\n加入我们，你将有机会参与亿级用户场景的开发与架构工作，使用前沿的技术助力业务一起不断成长。\n\n1、参与/负责跨平台端侧核心中间件设计和开发，如Bridge/资源加载/监控SDK等；\n2、参与/负责跨平台用户体验优化，从高性能可维护等方面进行容器优化（如Prefetch/Preload）的设计和落地；\n3、推动公司跨平台开发统一端能力生态，提供良好的大前端开发体验；\n4、推动跨平台动态化技术在抖音研发及字节跳动各产品内落地。","requirement":"1、2027届获得本科及以上学历，计算机、通信和电子信息科学等相关专业优先；\n2、具备扎实的计算机基础，熟悉计算机网络相关，掌握常用的数据结构与算法；\n3、客户端技术方向，或熟练使用Java/Kotlin，Swift/OC，ArkTS中至少一门编程语言，了解Android/iOS/Harmony系统框架机制（事件分发机制、渲染机制、权限机制等）优先；\n4、积极乐观，责任心强，具备良好的服务意识、沟通能力、团队协作能力。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785157735111,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A155347","job_id":"7667193477289625909","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list