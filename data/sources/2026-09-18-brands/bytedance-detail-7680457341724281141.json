{"code":0,"data":{"job_post_detail":{"id":"7680457341724281141","title":"AI产品经理（电商广告与营销方向） - 抖音电商","description":"团队介绍：抖音电商以“总能发现好东西”为主张，致力于成为用户发现丰富好物的首选平台。众多抖音创作者通过短视频、直播、商城等丰富的形式，给用户提供更个性化、更生动、更高效的消费体验。同时，抖音电商积极引入优质合作伙伴，为商家变现提供多元的选择。\n\n1、深度参与电商营销和商业化场景AI能力效果优化，建设模型评估策略，挖掘各场景模型能力优化点；\n2、通过数据分析、客户调研、行业研究等方式，挖掘商业广告需求生成场景；\n3、积极推进同业务团队合作，保障需求高质量执行落地。","requirement":"1、2027届获得本科及以上学历，专业不限；\n2、有较强的数据分析能力，对数字敏感，较好的逻辑思维能力和理解能力；\n3、具有良好的表达能力、执行能力、团队协作能力；思维活跃，有好奇心，有创新精神，喜欢解决问题；自我驱动，同时关注宏观目标和微观细节，具有主人翁精神，结果导向；乐观向上，遇到问题积极解决，有韧性，不轻易骄躁或气馁。","job_category":{"id":"6704215864591255820","name":"产品经理","en_name":"Product manager","i18n_name":"产品经理","depth":2,"parent":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1788245865233,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A249782A","job_id":"7680456637803710773","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map"