{"code":0,"data":{"job_post_detail":{"id":"7671128410562922788","title":"软件产品经理","description":"1、负责小米软件产品升级维护，输出软件功能需求列表，参与制订软件升级维护方案并端到端的跟踪落地实现；\n2、负责软件需求的收集与分析，根据外部及内部输入的概要性需求，通过需求分析进行细化，输出规划详细的技术路线及技术方案，定义软件需求并组织需求评审； \n3、对市场产品、热点功能等进行调研和竞品功能分析，输出可行性产品提升方案； \n4、跟踪产品设计、开发、测试到正式交付上线的全过程，协助把控研发整体进度及交付结果，对需求实现情况进行跟踪和闭环；\n5、进行业务调研和客户反馈收集，提炼通用需求并判断优先级，推进客户的痛点问题持续解决。","requirement":"1、计算机、软件、人工智能、大数据相关专业；\n2、热爱互联网、热爱技术、热爱思考，具有卓越的逻辑思维和创新能力；\n3、熟练掌握产品设计工具（如Axure、Sketch、Figma等）;\n4、具备良好的技术理解能力，能与开发团队高效沟通，能够有效推动跨部门合作；\n5、强烈的用户导向意识，注重用户体验。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786073802067,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473448557","name":"产品类","en_name":"Product","i18n_name":"产品类"},"job_id":"7671128410562758948","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1},{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map"