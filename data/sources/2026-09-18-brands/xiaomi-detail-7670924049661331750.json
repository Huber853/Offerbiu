{"code":0,"data":{"job_post_detail":{"id":"7670924049661331750","title":"资金专员","description":"1、负责银行账户开立、变更、注销及账户相关文件归档；\r\n2、负责第三方账户开立、变更、注销及资金提现、充值、退款等事项；\r\n3、负责信用证通知、交单等国际单证事宜及国内票据管理事项；\r\n4、管理并及时完成集团收付款结算，识别支付全链条风险事项，保障集团资金安全；\r\n5、依资金内部指令准确并高效处理理财/外汇/融资等业务的交割，做到日清月结；\r\n6、维护账户交易流水数据，协助集团现金流分析工作；\r\n7、负责集团月结相关事项及季/年度审计工作；\r\n8、调研账户属地的外管规定及结算法律法规，保证资金业务合规遵从；\r\n9、配合推进直连建设落地，提升账户、结算系统化能力。","requirement":"1、本科及以上学历，财务相关专业；\r\n2、英文能力良好，可作为工作语言；\r\n3、学习能力强，对数字敏感，逻辑清晰；\r\n4、善于沟通，良好的团队协作能力；\r\n5、为人诚实可靠、细心、耐心。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026286449,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879421549","name":"职能类","en_name":"Supporting Function","i18n_name":"职能类"},"job_id":"7670924049661151526","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"