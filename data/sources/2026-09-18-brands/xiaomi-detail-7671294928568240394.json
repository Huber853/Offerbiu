{"code":0,"data":{"job_post_detail":{"id":"7671294928568240394","title":"视觉算法工程师-画质","description":"1、负责相机画质算法的研发和优化，包括但不限于图像处理、色彩还原、降噪、锐化、超清等方面；\n2、参与相机软硬件系统的设计和开发，提升相机画质表现；\n3、负责相机画质算法的性能测试和模型/方案优化，提高算法效率和稳定性；\n4、跟踪业界最新的相机画质算法技术，包括DeepISP、diffusion大模型等，不断优化和改进公司的相机画质表现。","requirement":"1、硕士及以上学历优先，计算机、图像处理、机器学习、模式识别、深度学习、大模型、数学等相关专业；\n2、一定的图像处理基础，扎实的数学功底，对图像相关的深度学习或传统算法有深入的理解，或有突出的学术成绩；\n3、良好的编码能力，熟练掌握至少一门编程语言(c/c++/python)，能够熟练使用c/c++开发工具进行代码调试、优化；\n4、熟悉并能灵活运用Tensorflow、pytorch等机器（深度）学习工具解决实际图像问题；\n5、有安卓平台app开发, 或了解jni及安卓native代码开发、调试、优化经验者优先；\n6、发表高质量计算机视觉相关期刊、会议论文者优先，高质量学术竞赛者优先；\n7、具有较强的内外部沟通能力和协调能力，视野开阔，思维敏捷 ，创新能力强。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786112724943,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7467761476330340460","name":"算法类","en_name":"Algorithm","i18n_name":"算法类"},"job_id":"7671294928568109322","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_