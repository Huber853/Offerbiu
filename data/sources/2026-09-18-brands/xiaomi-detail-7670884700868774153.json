{"code":0,"data":{"job_post_detail":{"id":"7670884700868774153","title":"运营主管-意大利语","description":"1、准确把握客户需求，挖掘用户兴奋点，将产品方案落地，包括但不限于方案策划、文案撰写、页面跟进、图片设计、效果跟踪等；\n⁣2、协助制定小米产品的运营方案、推广策略、销售规划，完成流量及销售目标；\n⁣3、综合内容、市场、销售部门的反馈，高效的输出运营策划方案、产品文案；\n⁣4、对竞品进行监控总结，并进行有效分析，不断提出改善策略和创意，并做出竞品分析报告；\n5、协助策划活动方案，关注平台及市场动向，快速调整运营策略，利用活动提高用户活跃度、拉新量；\n6、挖掘运营数据、用户数据，进行多维度分析，提供消费需求导向，提高用户留存与复购。","requirement":"1、本科及以上学历；\n2、良好的沟通协调能力，有良好的自驱力和韧性；\n3、熟练使用office办公软件，良好的数据敏感性；\n4、思维灵活敏捷，学习能力强，分析能力强，执行能力强；\n5、良好的英语听说读写能力，且意大利语可作为工作语言。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786017108601,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670884700868610313","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm