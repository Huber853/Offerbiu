{"code":0,"data":{"job_post_detail":{"id":"7678245416031095045","title":"云与AI解决方案架构师 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、面向公有云场景，与销售、BD、产品研发等部门紧密协同，跟进行业重点客户，推动标准产品或解决方案在客户侧落地；\n2、为字节跳动内外部客户提供业务和技术层面的架构咨询服务，理解合作伙伴及客户的业务和功能性需求、非功能性需求、性能和可靠性需求，提供基于火山引擎产品体系的架构设计方案，支持客户或合作伙伴成功地在火山引擎产品上构建上层应用系统和服务；\n3、通过对客户业务的深入理解和分析，提炼客户的终极诉求，结合公司产品和技术能力，沉淀行业细分方向的GTM方法论，树立行业标杆案例和典型场景价值案例。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程、AI大模型等相关专业优先；\n2、具备良好的沟通表达能力与逻辑思维；\n3、主动投身云服务、大数据、人工智能等领域的技术革新，具备快速学习能力与市场洞察力。\n\n【加分项】\n1、在校期间担任学生干部、组织过校级项目并担任负责人；\n2、有企业解决方案或架构设计实习经验，对云原生应用架构/大数据和人工智能架构/视频云有一定了解。","job_category":{"id":"6704215864629004552","name":"产品","en_name":"Product","i18n_name":"产品","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1787730843175,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A29309","job_id":"7678245233466263861","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_22","name":"成都","en_name":"Chengdu","location_type":3,"i18n_name":"成都","py_name":"chengdu","mdm_code":"MDCY00000342","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_