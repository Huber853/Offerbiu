{"code":0,"data":{"job_post_detail":{"id":"7670920221837855027","title":"数字设计师-汽车","description":"造型方案数字化三维表达与项目参与：\n1. 理解设计师的草图意图，快速转化内外饰零部件的二维概念到三维数模；\n2. 在设计师和数字组长的指导下将设计意图空间合理化以及发展三维方案；\n3. 在数字组长的要求与指导下，能够提交满足专业质量的三维数据交付；\n4. 按交付节点准时提交相应阶段的三维交付物；\n5. 能够快速学习数字化设计的专业标准并实践；\n6. 定期汇报工作进度。","requirement":"1. 本科工业设计专业及以上；\n2. 掌握Alias，具备快速建模的能力；\n3. 有完整的整车数字模型设计作品以及其他任何工业产品外观作品，造型感觉好；\n4. 大致了解汽车设计内外饰一般造型关注点常识；\n5. 对三维数据质量有的自我要求和自主提升的意识；\n6. 数据管理习惯良好，保存归档文件有序；\n7. 积极主动，和团队沟通顺畅；\n8. 保持数字化设计以及汽车知识的学习力。","city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786025320295,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473464941","name":"设计类","en_name":"Design","i18n_name":"设计类"},"job_id":"7670919537844799795","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},