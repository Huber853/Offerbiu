{"code":0,"data":{"job_post_detail":{"id":"7670923508009093430","title":"整车质量工程师-汽车","description":"负责整体推进新项目阶段质量问题状态，识别重点问题及相关风险，组织相关部门进行改进和拦截，保证问题状态受控，支持新车型上市，包括以下内容：\n1、在数据开发阶段，组织数据检查问题推进、历史车型问题和友商上市问题的导入和规避；\n2、在实物造车阶段，统筹硬件及软件问题的整体状态管理，组织整车问题推进会，识别并推进重点风险问题；\n3、小批量造车后，拉动相关方编制问题管理日报，对新增问题及存量重点问题进行日清；\n4、持续优化问题管理流程，对质量问题管理缺位或不足及时补充。","requirement":"1、本科及以上学历，机械，材料，化工，汽车等专业；\n2、了解汽车冲压、车身、涂装生产过程，拥有质量管理等相关专业知识者优先； \n3、熟悉使用Catia或者Autocad软件，熟练使用办公软件； \n4、具有良好的沟通能力学习能力，团队合作能力。","city_info":{"code":"CT_154","name":"武汉","en_name":"Wuhan","i18n_name":"武汉"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786026228274,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178035552473481325","name":"运营类","en_name":"Operation","i18n_name":"运营类"},"job_id":"7670923508008913206","city_list":[{"code":"CT_154","name":"武汉","en_name":"Wuhan","location_type":3,"i18n_name":"武汉","py_name":"wuhan","mdm_code":"MDCY00000216","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_deliv