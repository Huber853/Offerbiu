{"code":0,"data":{"job_post_detail":{"id":"7667479014405720325","title":"C++客户端开发工程师 - 抖音研发","description":"团队介绍：抖音研发部门负责多款大型产品的研发，包括但不限于抖音、西瓜视频、汽水音乐。\n加入我们，你将有机会参与亿级用户场景的开发与架构工作，使用前沿的技术助力业务一起不断成长。\n\n1、负责公司移动产品抖音、抖音火山版的客户端技术研发，编写高质量的代码；\n2、主动发现业务问题和技术痛点，深度参与客户端基建需求讨论、技术调研、方案评审、功能开发等；\n3、设计良好的代码结构，不断迭代优化。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、智能手机爱好者和使用者，追求良好的用户体验；\n3、具有良好的编程习惯，代码结构清晰，命名规范；\n4、熟练掌握数据结构与算法、计算机网络、操作系统、编译原理等课程；\n5、熟练掌握C/C++/OC/Swift一种或多种语言，理解基本的设计模式；\n6、有深度参与开源项目或者自己独立开发过App上架App Store优先。","job_category":{"id":"6704215957146962184","name":"客户端","en_name":"Client","i18n_name":"客户端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785224202556,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A208455","job_id":"7667479132833581365","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1},{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1},{"code":"CT_45","name":"广州","en_name":"Guangzhou","location_type":3,"i18n_name":"广州","py_name":"guangzhou","mdm_code":"MDCY00000247","node_status":1},{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i1