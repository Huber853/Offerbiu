{"code":0,"data":{"job_post_detail":{"id":"7670915069627631881","title":"动力性经济性属性开发工程师-汽车","description":"1、参与动力性经济性仿真分析，包括整车能耗模型搭建、续航里程仿真及动力性指标计算；\n2、协助动力性经济性目标分解至子系统，跟踪性能目标达成情况；\n3、参与续航能耗转毂测试及动力性试验，协助试验策划、数据采集与分析；\n4、协助竞品车型动力性经济性对标测试与分析研究；\n5、参与整车实际道路能耗测试方案制定和测试数据处理；\n6、跟踪学习先进节能技术（能量回收策略、热管理优化、低碳节能控制等），协助技术方案验证。","requirement":"1、车辆工程、动力工程及工程热物理、机械工程、自动化等相关专业；\n2、了解电动汽车动力性经济性开发流程，熟悉整车动力学及能量管理基本原理；\n3、具备MATLAB/Simulink建模与仿真基础，有CRUISE、Amesim、GT-Suite等使用经验者优先；\n4、了解汽车CAN总线通信原理，具备基本数据分析能力；\n5、对新能源汽车技术有热情，学习能力强，团队协作好；\n6、有相关课题研究、项目实践或实习经验者优先。","city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024279077,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670915069627468041","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},"city_info_list_for_delivery":[{"code":"CT_125","name":"上海","en_name":"Shanghai","loc