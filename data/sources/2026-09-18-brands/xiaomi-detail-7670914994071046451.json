{"code":0,"data":{"job_post_detail":{"id":"7670914994071046451","title":"AI Agent开发工程师-汽车","description":"1、参与面向真实业务场景的AI Agent应用研发，涵盖需求分析、原型验证、功能实现与上线维护；\n2、参与Agent应用的核心功能开发：工具/插件（Tooling）能力、问答、函数调用与工作流编排；\n3、参与Agent评测与可观测（如自动化Case/Eval、日志追踪、调用成本与质量监控）；\n4、大模型核心能力提升，包括理解能力、知识能力、推理能力、生成能力和语言能力等；\n5、训练和推理加速、模型量化、端测落地；\n6、完成阶段性可交付：模块/文档/演示用例，并参与用户反馈闭环。","requirement":"1、计算机/软件/自动化/电子信息等相关专业，本科以上学历；\n2、扎实的编程功底与工程素养：数据结构/网络/并发基础，良好的代码风格与调试能力；\n3、熟练掌握主流深度学习框架pytorch/tensorflow，大模型训练框架Megatron-LM/Deepspeed等多机多卡方案，有大模型训练和项目经验优先；\n4、熟悉至少一种主语言：Python 或 TypeScript/Node.js；能使用 FastAPI/Express 等快速落地服务；\n5、具备Web基础能力其中之一：前端（React/Next.js/Vue）或后端（API设计、鉴权、日志、监控）；\n6、了解LLM基础与常见能力：Prompt设计、函数调用/工具使用、上下文管理、流式响应。","city_info":{"code":"CT_107","name":"南京","en_name":"Nanjing","i18n_name":"南京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1786024196874,"channel_online_status":1,"job_subject":{"id":"7659311908839262514","name":{"zh_cn":"2027届校园招聘计划","i18n":"2027届校园招聘计划"},"limit_count":2,"active_status":1},"job_function":{"id":"7178759516879405165","name":"软件研发类","en_name":"Software R\u0026D","i18n_name":"软件研发类"},"job_id":"7670914994070882611","city_list":[{"code":"CT_107","name":"南京","en_name":"Nanjing","location_type":3,"i18n_name":"南京","py_name":"nanjing","mdm_code":"MDCY00000121","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_m