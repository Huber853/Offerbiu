{"code":0,"data":{"job_post_detail":{"id":"7669716980568049973","title":"游戏算法工程师（3D方向） - AIGC","description":"团队介绍：游戏-AIGC部门，致力于将生成式AI落地到游戏中，包括但不限于模型、贴图、动画、场景、剧情、对话、玩法等游戏核心元素的AI生成和AI提效。部门近几年一直在游戏AI和数字人方向持续深耕，欢迎加入我们。\n\n1、参与到AI3D、动作、视频等研究方向之一，探索AI技术在游戏制作效率提升、玩法创新上的可能性；\n2、包括但不限于3D生成模型、贴图生成模型、3D数据分析、几何结构优化等；\n3、包括但不限于动作生成模型、视频动作捕捉、动作数据分析、自动重定向、自动绑定等；\n4、包括但不限于围绕视频模型的上下游算法设计与调优；\n5、包括但不限于上述流程的Agent化、自动流程设计与开发。","requirement":"1、2027届获得本科及以上学历，计算机、自动化、电子信息、数学等相关专业；\n2、熟悉2D、3D视觉的基本知识，熟悉DiT、AR等模型；在3D生成、几何处理、动作生成、数字人等方向之一有研究经验；\n3、在以上方向有主导过有影响力的项目或论文者优先；\n4、具备出色的编程能力、数据结构和算法技能，熟练掌握C/C++或Python编程语言，在ACM/ICPC、NOI/IOI、Top Coder、Kaggle等比赛中获奖者优先；\n5、对数据敏感、有良好的逻辑思维及沟通协作能力；\n6、对AIGC与游戏有强烈兴趣和热情者优先。","job_category":{"id":"6704215956018694411","name":"算法","en_name":"Algorithm","i18n_name":"算法","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_52","name":"杭州","en_name":"Hangzhou","i18n_name":"杭州"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785745189911,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A217356B","job_id":"7662209827265186101","city_list":[{"code":"CT_52","name":"杭州","en_name":"Hangzhou","location_type":3,"i18n_name":"杭州","py_name":"hangzhou","mdm_code":"MDCY00000134","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_m