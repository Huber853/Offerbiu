{"code":0,"data":{"job_post_detail":{"id":"7669720483260647733","title":"游戏研发特性产品经理 - 深圳射击项目","description":"团队介绍：一款科幻写实的全平台(手游/PC/主机)射击项目，使用UE5引擎研发，欢迎加入我们。\n\n1、参与射击游戏玩法与系统特性的研发管理，协助推进特性从需求拆解、研发跟进的全流程落地；\n2、协助制定特性研发计划，拆解关键里程碑、排期与交付节点，保障研发任务按计划推进；\n3、协调策划、程序、美术、测试等多职能团队，推动信息同步、问题暴露与协作闭环；\n4、跟进特性研发过程中的进度、质量与风险，协助识别体验偏差。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程、游戏设计、项目管理等相关专业优先；\n2、热爱游戏，尤其对FPS、TPS、PVE射击等品类有持续体验和深入兴趣；\n3、具备良好的逻辑拆解、结构化表达和文档撰写能力，能够清晰梳理目标、任务与风险；\n4、具备较强的沟通协作意识、责任心和执行力，能够推动多角色协作并跟进问题闭环；\n5、具备基础的数据意识和复盘意识，能够通过进度、质量、问题反馈等信息辅助项目判断。\n\n加分项\n1、有游戏项目、课程项目、Game Jam、MOD、独立游戏或相关实习经历；\n2、熟悉UE5、Unity或任一游戏引擎基础工作流，了解游戏研发协作方式；\n3、有技术背景、敏捷项目管理经验，或对AI工具、自动化流程、研发效能提升有兴趣。","job_category":{"id":"6863074795655792910","name":"项目管理","en_name":"Project Management","i18n_name":"项目管理","depth":2,"parent":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_128","name":"深圳","en_name":"Shenzhen","i18n_name":"深圳"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785746061114,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A91589","job_id":"7660831271887128885","city_list":[{"code":"CT_128","name":"深圳","en_name":"Shenzhen","location_type":3,"i18n_name":"深圳","py_name":"shenzhen","mdm_code":"MDCY00000249","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":