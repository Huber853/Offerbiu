{"code":0,"data":{"job_post_detail":{"id":"7667972755450693941","title":"前端开发工程师（Lynx方向） - Cross Platform","description":"团队介绍：字节跳动Cross Platform致力于开发Lynx等业界前沿的应用框架，构建LLM驱动的前沿系统和基础设施，提升开发者和用户体验。\n\n1、参与Lynx前端框架相关项目研发；\n2、参与Lynx前端框架相关的前沿技术研究，承担重点、难点技术攻坚；\n3、参与优化工程架构、研发工具和工作流、追求极致效率、性能和稳定性；\n4、探索前端UI框架领域未来的研发范式和技术边界。","requirement":"1、2027届获得本科及以上学历，计算机、软件工程等相关专业优先；\n2、熟悉社区中主流UI框架和相关技术栈的用法，包括React/Vue/Svelte等，有深入开发经验优先；\n3、了解主流前端UI框架的源码实现，理解框架背后的设计思路；\n4、持续关注全球技术社区中的主流技术、前沿领域和最佳实践；\n5、有自己的开源项目、技术产品或开源社区贡献经验优先。","job_category":{"id":"6704215886108035339","name":"前端","en_name":"Frontend","i18n_name":"前端","depth":2,"parent":{"id":"6704215862603155720","name":"研发","en_name":"R\u0026D","i18n_name":"研发","depth":1,"children":[]},"children":[]},"city_info":{"code":"CT_125","name":"上海","en_name":"Shanghai","i18n_name":"上海"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785339080620,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A24197","job_id":"7667972930696923445","city_list":[{"code":"CT_125","name":"上海","en_name":"Shanghai","location_type":3,"i18n_name":"上海","py_name":"shanghai","mdm_code":"MDCY00000002","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list":[],"job_post_process_time_list":[],"job_level_id_list":[]},