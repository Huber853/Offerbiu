{"code":0,"data":{"job_post_detail":{"id":"7667126327812049157","title":"业务洞察与市场分析 - 火山引擎","description":"团队介绍：火山引擎是字节跳动旗下云和AI服务平台，将字节跳动快速发展过程中积累的增长方法、技术能力和应用工具开放给外部企业，通过云和AI技术，推进企业智能化转型，激发增长潜能。\n\n1、负责细分行业/场景的市场洞察工作，对市场环境、行业趋势、技术发展、销售与生态构建以及市场情况定期进行持续跟踪监测、收集信息、分析新机会点；\n2、负责细分行业的市场规划工作，能根据市场洞察、行业数据和公司内部情况整合分析，配合行业线负责人进行市场规划和客户目标制定；\n3、负责细分行业的客户洞察工作，包括客户分层、客户AI转型痛点、客户突破的策略分析等；\n4、深入业务发展和运营，对行业重点问题进行专题研究，定期对业务进展进行分析与总结，与业务团队形成良好的协同机制；\n5、协助行业线完成其他跨团队的资源协调与项目管理等工作。","requirement":"1、2027届获得本科及以上学历，计算机、人工智能、商业分析、数据分析、统计学等相关专业优先；\n2、有敏锐的市场感知能力，对业务如何成功有强烈好奇心，愿意深入了解AI和云计算行业，熟练应用3种以上AI工具；\n3、具备基础技术知识背景，有较强的写作能力、数据处理能力，有相关实习经验优先；\n4、工作积极主动，有责任心，具备良好的沟通表达能力和团队协作意识，乐于接受新挑战，具备优异的学习能力和自我驱动力。","job_category":{"id":"6704215882479962371","name":"运营","en_name":"Operations","i18n_name":"运营","depth":1,"children":[]},"city_info":{"code":"CT_11","name":"北京","en_name":"Beijing","i18n_name":"北京"},"recruit_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"publish_time":1785142006620,"channel_online_status":1,"job_subject":{"id":"7649336829398468869","name":{"zh_cn":"2027届校园招聘","i18n":"2027届校园招聘"},"active_status":1},"code":"A164623","job_id":"7665929969910466869","city_list":[{"code":"CT_11","name":"北京","en_name":"Beijing","location_type":3,"i18n_name":"北京","py_name":"beijing","mdm_code":"MDCY00000001","node_status":1}],"job_post_info":{"recruitment_type":{"id":"201","name":"正式","en_name":"Regular","i18n_name":"正式","depth":2,"parent":{"id":"2","name":"校招","en_name":"Campus","i18n_name":"校招","depth":1,"children":[],"active_status":1,"selectability":1},"children":[],"active_status":1,"selectability":1},"HighlightList":[],"JobChannelPublishList":[],"job_post_object_value_map":{},"address_list":[],"city_list":[],"correlation_job_list":[],"tag_list":[],"storefront_list":[],"target_major_list"